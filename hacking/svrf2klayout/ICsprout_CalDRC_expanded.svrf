M4_S_1_R {
    @ Recommended Space between two Mns,
    (EXT M4 < 0.13 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}

#ENDIF

M4_S_2 {
    @ Space between two Mns when one or both Mn width >=0.42um, and the parallel run length of two Mns is >= 0.42um.>=0.15um
    span_edge_0 = DFM COPY (DFM SPACE M4ALL < 0.42 BY INT) EDGE
    span_edge_1 = M4ALL NOT COIN EDGE span_edge_0
    span_edge = EXT [span_edge_1] M4ALL < 0.15 ABUT < 90 OPPOSITE
    (LENGTH span_edge >= 0.42) NOT INSIDE EDGE NODRC
}
M4_S_3 {
    @ Space between two Mns when one or both Mn width >=1.5um, and the parallel run length of two Mns is >= 1.5um.>=0.5um
    span_edge_0 = DFM COPY (DFM SPACE M4ALL < 1.5 BY INT) EDGE
    span_edge_1 = M4ALL NOT COIN EDGE span_edge_0
    span_edge = EXT [span_edge_1] M4ALL < 0.5 ABUT < 90 OPPOSITE
    (LENGTH span_edge >= 1.5) NOT INSIDE EDGE NODRC
}
M4_S_4 {
    @ Space between metal lines with one or both is 45 degree (the area with 0.1um distance from bending point need not follow this rule) >= 0.19um
    X = ANGLE M4 == 45
    (EXT X < 0.19 REGION) NOT INSIDE NODRC
    (EXT M4 X < 0.19 REGION corner to edge) NOT INSIDE NODRC
}
M4_S_5 {
    @ Minimum Space at metalX line-end(W<0.12um) in a dense-line-end configuration:if metalx has parallel run length with opposite metalx along 2 adjacent edge metalx (any one edge < 0.12um distance from the conner of the two edge), the one of the space(sp1 or sp2) need to be at least 0.12 (except for small jog with edge length < 0.10um)
    LINE_END = CONVEX EDGE M4 ANGLE1 == 90 ANGLE2 == 90 WITH LENGTH < 0.12
    LINE_END_SP = EXT [LINE_END] M4 < 0.12 ABUT<90 OPPOSITE
    LINE_SIDE = LINE_END TOUCH INSIDE EDGE LINE_END_SP
    LINE_END_Mn = INT LINE_SIDE [M4] < 0.12 ABUT == 90 INTERSECTING ONLY
    LINE_END_Mn_010 = LENGTH LINE_END_Mn >= 0.10
    ((EXT LINE_END_Mn_010 M4 < 0.12 ABUT<90 OPPOSITE REGION)NOT MOMTER) NOT INSIDE NODRC
}
M4_A_1 {
    @ Mn area >= 0.052um2
    (AREA M4 < 0.052) NOT INSIDE NODRC
}
M4_A_2 {
    @ Enclosed dielectric area by Mn >= 0.18um2
    X = (HOLES M4 INNER) NOT M4
    (AREA X < 0.18) NOT INSIDE NODRC
}

#IFDEF Density_rules YES

M4_D_1_min {
    @ Mn density (including dummy) in 100umX100um window with step size 50um. INDALL/GRID/SRINGBLK covered areas are excluded for this rule checking >= 10%
    check_region_1 = (((DRC:1 NOT GRID) NOT SRINGBLK) NOT INDALL) NOT INSIDE NODRC
    DENSITY M4ALLi < 0.10 WINDOW 100 STEP 50 BACKUP INSIDE OF LAYER check_region_1 PRINT M4_D_1_min.log
}
M4_D_1_max {
    @ Mn density (including dummy) in 100umX100um window with step size 50um. INDALL/FUTR/GRID/SRINGBLK covered areas are excluded for this rule checking <= 80%
    check_region_1 = (((DRC:1 NOT GRID) NOT SRINGBLK) NOT INDALL) NOT INSIDE NODRC
    DENSITY M4ALLi > 0.80 WINDOW 100 STEP 50 BACKUP INSIDE OF LAYER check_region_1 PRINT M4_D_1_max.log
}
M4_D_2 {
    @ Average density for Mn inside the dummy block area size 2.5um in 100umX100um window with step size 50um >= 10%
    X = DENSITY M4ALLi < 0.1 WINDOW 100 STEP 50 backup PRINT density_report_M4_D_2.log
    Y = SIZE M4DUMB BY 2.5
    Z = SIZE Y BY 12.5 UNDEROVER
    (X AND Z) NOT INSIDE NODRC
}
M4_D_3 {
    @ The difference between Mn density in 100umX100um those of the adjacent checking windows (including dummy)
    @ INDALL/GRID/SRINGBLK covered areas are excluded for this rule checking <= 20%
    X = DENSITY M4ALLi >= 0 WINDOW 100 GRADIENT > 0.20 ABSOLUTE BACKUP INSIDE OF LAYER density_checkarea PRINT density_report_M4_D_3.log
    (((X NOT GRID) NOT SRINGBLK) NOT INDALL) NOT INSIDE NODRC
}

#ENDIF

GROUP GM5 M5_?
M5_W_1a {
    @ Mn width >= 0.10um
    (INT M5 < 0.10 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
M5_W_1b {
    @ Mn width
    @ (Exclude DEUPAD region when Mn as TM-1 in 1 top metal option) <= 12.00um
    X = M5 NOT DEUPAD
    (X WITH WIDTH > 12) NOT INSIDE NODRC
}
M5_W_2 {
    @ Width of Mn with 45 degree, >= 0.19um
    X = ANGLE M5 == 45
    (INT X < 0.19 REGION) NOT INSIDE NODRC
}
M5_W_3 {
    @ Minimum Mn width adjoining a huge non-metal region {[} area > 2000000 um2\], non-metal region is defined as (NOT (Mx OR MxDUM)) >= 0.35um
    NON_MAL_REG = AREA (DRC:1 NOT (OR M5 M5DUM)) > 2000000
    CHECK_REGION = ENCLOSE RECTANGLE NON_MAL_REG 10 0.35
    CHECK_MAL = M5 INTERACT CHECK_REGION
    (INT CHECK_MAL < 0.35 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
M5_S_1 {
    @ Space between two Mns,
    (EXT M5 < 0.10 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}

#IFDEF OPEN_RECOMMENDED_ON YES

M5_S_1_R {
    @ Recommended Space between two Mns,
    (EXT M5 < 0.13 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}

#ENDIF

M5_S_2 {
    @ Space between two Mns when one or both Mn width >=0.42um, and the parallel run length of two Mns is >= 0.42um.>=0.15um
    span_edge_0 = DFM COPY (DFM SPACE M5ALL < 0.42 BY INT) EDGE
    span_edge_1 = M5ALL NOT COIN EDGE span_edge_0
    span_edge = EXT [span_edge_1] M5ALL < 0.15 ABUT < 90 OPPOSITE
    (LENGTH span_edge >= 0.42) NOT INSIDE EDGE NODRC
}
M5_S_3 {
    @ Space between two Mns when one or both Mn width >=1.5um, and the parallel run length of two Mns is >= 1.5um.>=0.5um
    span_edge_0 = DFM COPY (DFM SPACE M5ALL < 1.5 BY INT) EDGE
    span_edge_1 = M5ALL NOT COIN EDGE span_edge_0
    span_edge = EXT [span_edge_1] M5ALL < 0.5 ABUT < 90 OPPOSITE
    (LENGTH span_edge >= 1.5) NOT INSIDE EDGE NODRC
}
M5_S_4 {
    @ Space between metal lines with one or both is 45 degree (the area with 0.1um distance from bending point need not follow this rule) >= 0.19um
    X = ANGLE M5 == 45
    (EXT X < 0.19 REGION) NOT INSIDE NODRC
    (EXT M5 X < 0.19 REGION corner to edge) NOT INSIDE NODRC
}
M5_S_5 {
    @ Minimum Space at metalX line-end(W<0.12um) in a dense-line-end configuration:if metalx has parallel run length with opposite metalx along 2 adjacent edge metalx (any one edge < 0.12um distance from the conner of the two edge), the one of the space(sp1 or sp2) need to be at least 0.12 (except for small jog with edge length < 0.10um)
    LINE_END = CONVEX EDGE M5 ANGLE1 == 90 ANGLE2 == 90 WITH LENGTH < 0.12
    LINE_END_SP = EXT [LINE_END] M5 < 0.12 ABUT<90 OPPOSITE
    LINE_SIDE = LINE_END TOUCH INSIDE EDGE LINE_END_SP
    LINE_END_Mn = INT LINE_SIDE [M5] < 0.12 ABUT == 90 INTERSECTING ONLY
    LINE_END_Mn_010 = LENGTH LINE_END_Mn >= 0.10
    ((EXT LINE_END_Mn_010 M5 < 0.12 ABUT<90 OPPOSITE REGION)NOT MOMTER) NOT INSIDE NODRC
}
M5_A_1 {
    @ Mn area >= 0.052um2
    (AREA M5 < 0.052) NOT INSIDE NODRC
}
M5_A_2 {
    @ Enclosed dielectric area by Mn >= 0.18um2
    X = (HOLES M5 INNER) NOT M5
    (AREA X < 0.18) NOT INSIDE NODRC
}

#IFDEF Density_rules YES

M5_D_1_min {
    @ Mn density (including dummy) in 100umX100um window with step size 50um. INDALL/GRID/SRINGBLK covered areas are excluded for this rule checking >= 10%
    check_region_1 = (((DRC:1 NOT GRID) NOT SRINGBLK) NOT INDALL) NOT INSIDE NODRC
    DENSITY M5ALLi < 0.10 WINDOW 100 STEP 50 BACKUP INSIDE OF LAYER check_region_1 PRINT M5_D_1_min.log
}
M5_D_1_max {
    @ Mn density (including dummy) in 100umX100um window with step size 50um. INDALL/FUTR/GRID/SRINGBLK covered areas are excluded for this rule checking <= 80%
    check_region_1 = (((DRC:1 NOT GRID) NOT SRINGBLK) NOT INDALL) NOT INSIDE NODRC
    DENSITY M5ALLi > 0.80 WINDOW 100 STEP 50 BACKUP INSIDE OF LAYER check_region_1 PRINT M5_D_1_max.log
}
M5_D_2 {
    @ Average density for Mn inside the dummy block area size 2.5um in 100umX100um window with step size 50um >= 10%
    X = DENSITY M5ALLi < 0.1 WINDOW 100 STEP 50 backup PRINT density_report_M5_D_2.log
    Y = SIZE M5DUMB BY 2.5
    Z = SIZE Y BY 12.5 UNDEROVER
    (X AND Z) NOT INSIDE NODRC
}
M5_D_3 {
    @ The difference between Mn density in 100umX100um those of the adjacent checking windows (including dummy)
    @ INDALL/GRID/SRINGBLK covered areas are excluded for this rule checking <= 20%
    X = DENSITY M5ALLi >= 0 WINDOW 100 GRADIENT > 0.20 ABSOLUTE BACKUP INSIDE OF LAYER density_checkarea PRINT density_report_M5_D_3.log
    (((X NOT GRID) NOT SRINGBLK) NOT INDALL) NOT INSIDE NODRC
}

#ENDIF

GROUP GV1 V1_?
V1_W_1 {
    @ Fixed V1 size (square shape) is 0.09,exclude GRING OR SRINGBLK area
    (NOT RECTANGLE V1 == 0.09 BY == 0.09) NOT INSIDE (OR GRID SRINGBLK NODRC)
}
V1_W_2 {
    @ Fixed V1 width(datatype 13) is 0.09,exclude EFUSEALL OR SRAMALL OR FUSEALL area
    (WITH WIDTH V1bar < 0.09 ) INSIDE (OR SRAMALL EFUSEALL FUSEALL)
    (WITH WIDTH V1bar > 0.09 ) INSIDE (OR SRAMALL EFUSEALL FUSEALL)
}
V1_S_1 {
    @ Space between two V1 is 0.11
    (EXT V1 < 0.11 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
V1_S_2 {
    @ Space between V1s between V and 3-neighboring Vs whose space is < 0.14um. >= 0.13.
    X = SIZE V1 BY 0.07 OVERUNDER
    Y = SIZE X BY 0.240 UNDEROVER
    Z = V1 INSIDE Y
    (EXT Z < 0.13 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
V1_S_3 {
    @ Minimum Space between two neighbor V1s (different net and run length>0) >= 0.13um.
    (EXT V1 < 0.13 ABUT<90 OPPOSITE REGION NOT CONNECTED) NOT INSIDE NODRC
}
V1_EN_2a_2b_2c {
    @ Vn must be fully enclosed by Mn >= 0
    @ Min M1 enclosure of V1 for two opposite sides >=0.04
    @ Vn must be fully enclosed by Mn/Mn+1 all sides >=0.03
    X = RECTANGLE ENC V1 M1 ABUT<90 OUTSIDE ALSO GOOD 0 0.04 OPPOSITE 0 0.04 OPPOSITE GOOD 0.03 0.03 0.03 0.03 OPPOSITE
    X NOT INSIDE (OR NODRC SRAMALL SRINGBLK)
    (V1 NOT M1) NOT INSIDE NODRC
}

#IFDEF OPEN_RECOMMENDED_ON YES

V1_2a_R_2b_R {
    @ Vn must be fully enclosed by Mn >= 0.04
    @ Min M1 enclosure of V1 for two opposite sides >=0.07
    X = RECTANGLE ENC V1 M1 ABUT<90 OUTSIDE ALSO GOOD 0.04 0.07 OPPOSITE 0.04 0.07 OPPOSITE GOOD 0.04 0.04 0.04 0.04 OPPOSITE
    X NOT INSIDE (OR NODRC SRINGBLK SRAMALL)
    (V1 NOT M1) NOT INSIDE NODRC
}

#ENDIF

V1_EN_5a_5b {
    @ Vn must be fully enclosed by Mn+1
    @ Min M2 enclsoure of V1 is 0.005
    @ Min M2 enclosure of V1 is 0.02 when M2 enclosure on one or both perpendicular directions<0.02um
    X = RECTANGLE ENC V1 M2 ABUT<90 OUTSIDE ALSO GOOD 0.005 OPPOSITE 0.02 OPPOSITE 0.005 OPPOSITE 0.02 OPPOSITE
    (ENC X M2 < 0.005 ABUT<90 SINGULAR REGION OVERLAP OUTSIDE ALSO) NOT INSIDE NODRC
    Y = ENC [X] M2 < 0.02 OPPOSITE
    (INT Y < 0.01 ABUT==90 INTERSECTING ONLY REGION) NOT INSIDE NODRC
    (V1 NOT M2) NOT INSIDE NODRC
}

#IFDEF OPEN_RECOMMENDED_ON YES

V1_R_2a_2b {
    @ There should be at least 2(Via with space <= 0.2um) or 4(Via with space <= 0.25um) at the intersection of Mn and Mn+1, when either Mn or Mn+1 width > 0.3um
    @ There should be at least 4(Via with space <= 0.2um) or 9(Via with space <= 0.55um) at the intersection of Mn and Mn+1, when either Mn or Mn+1 width > 0.7um
    w03b = M1 WITH WIDTH > 0.3
    w03u = M2 WITH WIDTH > 0.3
    w03 = M1 AND M2
    wide03 = ((w03 ENCLOSE (V1 NOT OUTSIDE w03b)) OR (w03 ENCLOSE (V1 NOT OUTSIDE w03u))) NOT wide07
    wide03v2s = SIZE (V1 INTERACT wide03) BY 0.1 INSIDE OF wide03 STEP 0.05
    wide03v4s = SIZE (V1 INTERACT wide03) BY 0.125 INSIDE OF wide03 STEP 0.05
    wide03v2 = wide03v2s INTERACT V1 >= 2
    wide03v4 = wide03v4s INTERACT V1 >= 4
    (wide03 NOT INTERACT (wide03v2 OR wide03v4)) NOT INSIDE NODRC
    w07b = M1 WITH WIDTH > 0.7
    w07u = M2 WITH WIDTH > 0.7
    w07 = M1 AND M2
    wide07 = (w07 ENCLOSE (V1 NOT OUTSIDE w07b)) OR (w07 ENCLOSE (V1 NOT OUTSIDE w07u))
    wide07v4s = SIZE (V1 INTERACT wide07) BY 0.1 INSIDE OF wide07 STEP 0.05
    wide07v9s = SIZE (V1 INTERACT wide07) BY 0.275 INSIDE OF wide07 STEP 0.05
    wide07v4 = wide07v4s INTERACT V1 >= 4
    wide07v9 = wide07v9s INTERACT V1 >= 9
    (wide07 NOT INTERACT (wide07v4 OR wide07v9)) NOT INSIDE NODRC
}

#ENDIF

V1_R_5 {
    @ 45-dgree rotated via is not allowed
    ((V1 WITH EDGE (ANGLE V1 == 45)) NOT INSIDE SRINGBLK) NOT INSIDE NODRC
}
GROUP GV2 V2_?
V2_W_1 {
    @ Fixed V2 size (square shape) is 0.09,exclude GRING OR SRINGBLK area
    (NOT RECTANGLE V2 == 0.09 BY == 0.09) NOT INSIDE (OR GRID SRINGBLK NODRC)
}
V2_W_2 {
    @ Fixed V2 width(datatype 13) is 0.09,exclude EFUSEALL OR SRAMALL OR FUSEALL area
    (WITH WIDTH V2bar < 0.09 ) INSIDE (OR SRAMALL EFUSEALL FUSEALL)
    (WITH WIDTH V2bar > 0.09 ) INSIDE (OR SRAMALL EFUSEALL FUSEALL)
}
V2_S_1 {
    @ Space between two V2 is 0.11
    (EXT V2 < 0.11 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
V2_S_2 {
    @ Space between V2s between V and 3-neighboring Vs whose space is < 0.14um. >= 0.13.
    X = SIZE V2 BY 0.07 OVERUNDER
    Y = SIZE X BY 0.240 UNDEROVER
    Z = V2 INSIDE Y
    (EXT Z < 0.13 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
V2_S_3 {
    @ Minimum Space between two neighbor V2s (different net and run length>0) >= 0.13um.
    (EXT V2 < 0.13 ABUT<90 OPPOSITE REGION NOT CONNECTED) NOT INSIDE NODRC
}
V2_EN_2a_2b_2c {
    @ Vn must be fully enclosed by Mn >= 0
    @ Min M2 enclosure of V2 for two opposite sides >=0.04
    @ Vn must be fully enclosed by Mn/Mn+1 all sides >=0.03
    X = RECTANGLE ENC V2 M2 ABUT<90 OUTSIDE ALSO GOOD 0 0.04 OPPOSITE 0 0.04 OPPOSITE GOOD 0.03 0.03 0.03 0.03 OPPOSITE
    X NOT INSIDE (OR NODRC SRAMALL SRINGBLK)
    (V2 NOT M2) NOT INSIDE NODRC
}

#IFDEF OPEN_RECOMMENDED_ON YES

V2_2a_R_2b_R {
    @ Vn must be fully enclosed by Mn >= 0.04
    @ Min M2 enclosure of V2 for two opposite sides >=0.07
    X = RECTANGLE ENC V2 M2 ABUT<90 OUTSIDE ALSO GOOD 0.04 0.07 OPPOSITE 0.04 0.07 OPPOSITE GOOD 0.04 0.04 0.04 0.04 OPPOSITE
    X NOT INSIDE (OR NODRC SRINGBLK SRAMALL)
    (V2 NOT M2) NOT INSIDE NODRC
}

#ENDIF

V2_EN_5a_5b {
    @ Vn must be fully enclosed by Mn+1
    @ Min M3 enclsoure of V2 is 0.005
    @ Min M3 enclosure of V2 is 0.02 when M3 enclosure on one or both perpendicular directions<0.02um
    X = RECTANGLE ENC V2 M3 ABUT<90 OUTSIDE ALSO GOOD 0.005 OPPOSITE 0.02 OPPOSITE 0.005 OPPOSITE 0.02 OPPOSITE
    (ENC X M3 < 0.005 ABUT<90 SINGULAR REGION OVERLAP OUTSIDE ALSO) NOT INSIDE NODRC
    Y = ENC [X] M3 < 0.02 OPPOSITE
    (INT Y < 0.01 ABUT==90 INTERSECTING ONLY REGION) NOT INSIDE NODRC
    (V2 NOT M3) NOT INSIDE NODRC
}

#IFDEF OPEN_RECOMMENDED_ON YES

V2_R_2a_2b {
    @ There should be at least 2(Via with space <= 0.2um) or 4(Via with space <= 0.25um) at the intersection of Mn and Mn+1, when either Mn or Mn+1 width > 0.3um
    @ There should be at least 4(Via with space <= 0.2um) or 9(Via with space <= 0.55um) at the intersection of Mn and Mn+1, when either Mn or Mn+1 width > 0.7um
    w03b = M2 WITH WIDTH > 0.3
    w03u = M3 WITH WIDTH > 0.3
    w03 = M2 AND M3
    wide03 = ((w03 ENCLOSE (V2 NOT OUTSIDE w03b)) OR (w03 ENCLOSE (V2 NOT OUTSIDE w03u))) NOT wide07
    wide03v2s = SIZE (V2 INTERACT wide03) BY 0.1 INSIDE OF wide03 STEP 0.05
    wide03v4s = SIZE (V2 INTERACT wide03) BY 0.125 INSIDE OF wide03 STEP 0.05
    wide03v2 = wide03v2s INTERACT V2 >= 2
    wide03v4 = wide03v4s INTERACT V2 >= 4
    (wide03 NOT INTERACT (wide03v2 OR wide03v4)) NOT INSIDE NODRC
    w07b = M2 WITH WIDTH > 0.7
    w07u = M3 WITH WIDTH > 0.7
    w07 = M2 AND M3
    wide07 = (w07 ENCLOSE (V2 NOT OUTSIDE w07b)) OR (w07 ENCLOSE (V2 NOT OUTSIDE w07u))
    wide07v4s = SIZE (V2 INTERACT wide07) BY 0.1 INSIDE OF wide07 STEP 0.05
    wide07v9s = SIZE (V2 INTERACT wide07) BY 0.275 INSIDE OF wide07 STEP 0.05
    wide07v4 = wide07v4s INTERACT V2 >= 4
    wide07v9 = wide07v9s INTERACT V2 >= 9
    (wide07 NOT INTERACT (wide07v4 OR wide07v9)) NOT INSIDE NODRC
}

#ENDIF

V2_R_5 {
    @ 45-dgree rotated via is not allowed
    ((V2 WITH EDGE (ANGLE V2 == 45)) NOT INSIDE SRINGBLK) NOT INSIDE NODRC
}
