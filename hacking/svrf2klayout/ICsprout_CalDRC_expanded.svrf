    @ Mndm space if Mndm size is 2um*2um >= 0.8um
    EXT M6DUM_2_2 < 0.8 ABUT <90 SINGULAR REGION
}
M6DUM_S_2 {
    @ Space between Mndm and M if Mndm size is 2um*2um >= 10um
    EXT M6 M6DUM_2_2 < 10 ABUT <90 SINGULAR REGION
}
M6DUM_S_3 {
    @ Mndm space if Mndm size is 1um*1um >= 0.3um
    EXT M6DUM_1_1 < 0.3 ABUT <90 SINGULAR REGION
}
M6DUM_S_4 {
    @ Space between Mndm and M if Mndm size is 1um*1um >= 3um
    EXT M6 M6DUM_1_1 < 3 ABUT <90 SINGULAR REGION
}
M6DUM_S_5 {
    @ Mndm space if Mndm size is 0.22um*0.89um >= 0.25um
    EXT M6DUM_0p22_0p89 < 0.25 ABUT <90 SINGULAR REGION
}
M6DUM_S_6 {
    @ Space between Mndm and M if Mndm size is 0.22um*0.89um >= 0.3um
    EXT M6 M6DUM_0p22_0p89 < 0.3 ABUT <90 SINGULAR REGION
}
M6DUM_S_7 {
    @ Space between two (MnDUM or Mn) having run length >=1.5um with one or both M1DUM width >=1.5um is 0.60um
    X0_a = M6ALL WITH WIDTH >= 1.5
    X0 = ENCLOSE RECTANGLE X0_a 1.5 1.5
    X1 = EXT M6ALL < 0.6 OPPOSITE REGION PARA ONLY
    X2 = LENGTH X1 >= 1.5
    X3 = X2 TOUCH EDGE X0
    X4_near = EXPAND EDGE X3 OUTSIDE BY 1.5
    X4_far = (EXPAND EDGE X3 OUTSIDE BY (1.5 + 0.01)) NOT X4_near
    X5 = X4_near NOT M6ALL
    X6_near = EXT X1 X5 < 1.5 OPPOSITE REGION
    X6_far = EXT X4_far X5 < 1.5 OPPOSITE REGION
    X7 = (X4_near NOT X5) NOT (X6_near OR X6_far)
    X7_edge = LENGTH (X7 COIN EDGE X1) >= 1.5
    X7_expand = EXPAND EDGE X7_edge OUTSIDE BY 0.6
    X8 = (X7_expand AND X1) NOT X5
    (X8 INTERACT M6DUM) NOT INSIDE NODRC
}
M6DUM_S_8 {
    @ Space between MnDUM and 45 degree Mn >= 0.4um
    X = ANGLE M6 == 45
    (EXT X M6DUM < 0.4 REGION) NOT INSIDE NODRC
}
M6DUM_S_9 {
    @ Space between MnDUM and FUSEALL(fuse) >= 3um
    EXT M6DUM FUSEALL < 3 ABUT < 90 SINGULAR REGION
    ENC M6DUM FUSEALL < 3 ABUT < 90 SINGULAR REGION
