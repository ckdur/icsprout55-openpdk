    M2MOM_12 = M2MOM INTERACT (MOMLVS1 WITH TEXT "momcap12" MOMLVS1)
    M3MOM_12 = M3MOM INTERACT (MOMLVS1 WITH TEXT "momcap12" MOMLVS1)
