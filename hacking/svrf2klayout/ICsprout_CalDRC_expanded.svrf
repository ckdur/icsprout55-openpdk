T4M2DUM_2_2 = RECTANGLE T4M2DUM == 2 BY == 2
T4M2DUM_1_1 = RECTANGLE T4M2DUM == 1 BY == 1
T4M2DUM_0p6_1p2 = RECTANGLE T4M2DUM == 0.6 BY == 1.2
T4M2DUM_W_1 {
    @ T4MnDUM SIZE = 2x2, 1x1, 0.6x1.2
    ((T4M2DUM NOT T4M2DUM_2_2) NOT T4M2DUM_1_1) NOT T4M2DUM_0p6_1p2
}
T4M2DUM_S_1 {
    @ Space between two T4MnDUMs if T4MnDUM size is 2um*2um >= 0.80um
    ((EXT T4M2DUM_2_2 < 0.80 ABUT<90 SINGULAR REGION) NOT INDALL) NOT INSIDE NODRC
}
T4M2DUM_S_2 {
    @ Space between T4MnDUMs and T4Mn if T4MnDUM size is 2um*2um >= 10um
    ((EXT T4M2DUM_2_2 T4M2 < 10 ABUT<90 SINGULAR REGION) NOT INDALL) NOT INSIDE NODRC
}
T4M2DUM_S_3 {
    @ Space between two T4MnDUMs if T4MnDUM size is 1um*1um >= 0.40um
    ((EXT T4M2DUM_1_1 < 0.40 ABUT<90 SINGULAR REGION) NOT INDALL) NOT INSIDE NODRC
}
T4M2DUM_S_4 {
    @ Space between T4MnDUMs and T4Mn if T4MnDUM size is 1um*1um >= 0.6um
    ((EXT T4M2DUM_1_1 T4M2 < 0.6 ABUT<90 SINGULAR REGION) NOT INDALL) NOT INSIDE NODRC
}
T4M2DUM_S_5 {
    @ Space between two T4MnDUMs if T4MnDUM size is 0.6um*1.2um >= 0.40um
    ((EXT T4M2DUM_0p6_1p2 < 0.40 ABUT<90 SINGULAR REGION) NOT INDALL) NOT INSIDE NODRC
}
T4M2DUM_S_6 {
    @ Space between T4MnDUMs and T4Mn if T4MnDUM size is 0.6um*1.2um >= 0.6um
    ((EXT T4M2DUM_0p6_1p2 T4M2 < 0.6 ABUT<90 SINGULAR REGION) NOT INDALL) NOT INSIDE NODRC
}
T4M2DUM_S_7 {
    @ Space between two (T4MnDUM or T4Mn) having run length >=1.5um with one or both T4MnDUM width >=1.5um is 0.60um
    X0_a = T4M2ALL WITH WIDTH >= 1.5
    X0 = ENCLOSE RECTANGLE X0_a 1.5 1.5
    X1 = EXT T4M2ALL < 0.6 OPPOSITE REGION PARA ONLY
    X2 = LENGTH X1 >= 1.5
    X3 = X2 TOUCH EDGE X0
    X4_near = EXPAND EDGE X3 OUTSIDE BY 1.5
    X4_far = (EXPAND EDGE X3 OUTSIDE BY (1.5 + 0.01)) NOT X4_near
    X5 = X4_near NOT T4M2ALL
    X6_near = EXT X1 X5 < 1.5 OPPOSITE REGION
    X6_far = EXT X4_far X5 < 1.5 OPPOSITE REGION
    X7 = (X4_near NOT X5) NOT (X6_near OR X6_far)
    X7_edge = LENGTH (X7 COIN EDGE X1) >= 1.5
    X7_expand = EXPAND EDGE X7_edge OUTSIDE BY 0.6
    X8 = (X7_expand AND X1) NOT X5
    (X8 INTERACT T4M2DUM) NOT INSIDE NODRC
}
T4M2DUM_S_8 {
    @ Space between T4MnDUM and 45 degree T4Mn >= 0.4um
    X = ANGLE T4M2 == 45
    (EXT X T4M2DUM < 0.4 REGION) NOT INSIDE NODRC
}
T4M2DUM_S_9 {
    @ Space between T4MnDUM and FUSEALL(fuse) >= 3um
    EXT T4M2DUM FUSEALL < 3 ABUT < 90 SINGULAR REGION
    ENC T4M2DUM FUSEALL < 3 ABUT < 90 SINGULAR REGION
}
T4M2DUM_S_10 {
    @ Space between T4MnDUM and BMIM(MIM) >= 2um
    EXT T4M2DUM BMIM < 2 ABUT < 90 SINGULAR REGION
    ENC T4M2DUM BMIM < 2 ABUT < 90 SINGULAR REGION
}
T4M2DUM_S_11 {
    @ Space between T4MnDUM and LOGO >= 0.1um
    EXT T4M2DUM LOGO < 0.1 ABUT < 90 SINGULAR REGION
    ENC T4M2DUM LOGO < 0.1 ABUT < 90 SINGULAR REGION
}
T4M2DUM_S_12 {
    @ Space between T4MnDUM and INDALL >= 3um
    EXT T4M2DUM INDALL < 3 ABUT < 90 SINGULAR REGION
    ENC T4M2DUM INDALL < 3 ABUT < 90 SINGULAR REGION
}
T4M2DUM_S_13 {
    @ Space between T4MnDUM and CHIPBLK(chip edge) >= 2.5um
    EXT T4M2DUM CHIPBLK < 2.5 ABUT < 90 SINGULAR REGION
    ENC T4M2DUM CHIPBLK < 2.5 ABUT < 90 SINGULAR REGION
}
T4M2DUM_S_14 {
    @ Space between T4MnDUM and T4MnDUMB >= 2um
    EXT T4M2DUM T4M2DUMB < 2 ABUT < 90 SINGULAR REGION
}
T4M2DUM_S_15 {
    @ Space between T4MnDUM and DMYBLK >= 2um
    EXT T4M2DUM DMYBLK < 2 ABUT < 90 SINGULAR REGION
}
ESD = ESD1 AND ESDIOE
ENACT = NACT AND ESDIOE
EPACT = PACT AND ESDIOE
ENTAP = ENACT AND NW
EPTAP = EPACT NOT NW
EGATE = (AA AND PO) AND ESDIOE
ENGATE = EGATE AND ENACT
EPGATE = EGATE AND EPACT
EGATEHV = (EGATE NOT DG) AND TG //2.5V or 3.3V
EGATEMV = (EGATE AND DG) NOT TG //1.8V
EGATELV = EGATE NOT DG //1.2V
EGATE_CASCODED = (EGATE AND ESDIOE) AND ESDIOT //high voltage tolerant I/O using Cascoded 2.5V/3.3V NMOS
EGATE_CASCODED_OVLAP = EGATE_CASCODED CUT ESAB
EGATE_CASCODED_INSID = EGATE_CASCODED INSIDE ESAB
EGATE_W = EGATE COIN EDGE PO
EGATE_L = EGATE COIN EDGE AA
EGATE_POLY = PO ENCLOSE EGATE
ENGATE_POLY = PO ENCLOSE ENGATE
EPGATE_POLY = PO ENCLOSE EPGATE
ECT = CT AND ESDIOE
ESAB = SAB AND ESDIOE
ESAB_HO_RAW = HOLES ESAB INNER EMPTY
ESAB_HO = ESAB_HO_RAW OR EMOS_D
ECT_S = ECT OUTSIDE ESAB_HO
ECT_D = ECT INSIDE ESAB_HO
ENMOS = ENACT ENCLOSE EGATE
EPMOS = EPACT ENCLOSE EGATE
ENMOS_SD = ENMOS NOT EGATE
EPMOS_SD = EPMOS NOT EGATE
ENMOS_S = (ENMOS_SD NOT ESAB) TOUCH EGATE
ENMOS_D = (ENMOS_SD NOT ESAB) NOT TOUCH EGATE
ENMOS_DRAIN = (ENMOS_SD INTERACT ENMOS_D) INTERACT ECT
EPMOS_S = (EPMOS_SD NOT ESAB) TOUCH EGATE
EPMOS_D = (EPMOS_SD NOT ESAB) NOT TOUCH EGATE
EPMOS_DRAIN = (EPMOS_SD INTERACT EPMOS_D) INTERACT ECT
EMOS_D = ENMOS_D OR EPMOS_D
EMOS_S = ENMOS_S OR EPMOS_S
ENGUARDRING = HOLES ENTAP INNER EMPTY
EPGUARDRING = HOLES EPTAP INNER EMPTY
ENGUARDHOLE_2 = (HOLES ENTAP INNER) ENCLOSE EPGUARDRING
EPGUARDHOLE_2 = (HOLES EPTAP INNER) ENCLOSE ENGUARDRING
NESDCLP_NOSAB = (NACT AND ESDIOE) NOT INTERACT SAB
NESDCLP_SAB = (NACT AND ESDIOE) INTERACT SAB
PESDCLP_NOSAB = (PACT AND ESDIOE) NOT INTERACT SAB
PESDCLP_SAB = (PACT AND ESDIOE) INTERACT SAB
ENGATE_NOSAB = GATE AND NESDCLP_NOSAB
ENGATE_SAB = GATE AND NESDCLP_SAB
EPGATE_NOSAB = GATE AND PESDCLP_NOSAB
EPGATE_SAB = GATE AND PESDCLP_SAB
EGATE_NOSAB = ENGATE_NOSAB OR EPGATE_NOSAB
EGATE_SAB = ENGATE_SAB OR EPGATE_SAB
ESD3C_1 = EXPAND EDGE ((EGATE NOT EGATE_CASCODED) INSIDE EDGE AA) INSIDE BY 0.001
ESD3C_2 = EXPAND EDGE ((EGATE_CASCODED NOT INSIDE SAB) INSIDE EDGE AA) INSIDE BY 0.001
ESD3C = ESD3C_1 OR ESD3C_2
ENACT_D = ((ENACT NOT PO) INTERACT PO) INTERACT SAB >= 1
EPACT_D = ((EPACT NOT PO) INTERACT PO) INTERACT SAB >= 1
EACT_D = ENACT_D OR EPACT_D
ENGATE_D_EMPTY = EMPTY1 OR (ESDIOE AND ENMOS_DRAIN)
EPGATE_D_EMPTY = EMPTY1 OR (ESDIOE AND EPMOS_DRAIN)
ESD3C_EMPTY = EMPTY1 OR ESD3C
ECT_EMPTY = EMPTY1 OR ECT
CONNECT ENGATE_D_EMPTY ESD3C_EMPTY
CONNECT EPGATE_D_EMPTY ESD3C_EMPTY
CONNECT ENGATE_D_EMPTY EM1i_EMPTY BY ECT_EMPTY
CONNECT EPGATE_D_EMPTY EM1i_EMPTY BY ECT_EMPTY
EM1i_EMPTY = EMPTY1 OR M1i
EV1_EMPTY = EMPTY1 OR V1
EM2i_EMPTY = EMPTY1 OR M2i
EV2_EMPTY = EMPTY1 OR V2
EM3i_EMPTY = EMPTY1 OR M3i
EV3_EMPTY = EMPTY1 OR V3
EM4i_EMPTY = EMPTY1 OR M4i
EV4_EMPTY = EMPTY1 OR V4
EM5i_EMPTY = EMPTY1 OR M5i
ET4V2i_EMPTY = EMPTY1 OR T4V2i
ET4M2i_EMPTY = EMPTY1 OR T4M2i
CONNECT EM1i_EMPTY EM2i_EMPTY BY EV1_EMPTY
CONNECT EM2i_EMPTY EM3i_EMPTY BY EV2_EMPTY
CONNECT EM3i_EMPTY EM4i_EMPTY BY EV3_EMPTY
CONNECT EM4i_EMPTY EM5i_EMPTY BY EV4_EMPTY
CONNECT EM5i_EMPTY ET4M2i_EMPTY BY ET4V2i_EMPTY
EPA_EMPTY = EMPTY1 OR CBi
ERDL_EMPTY = EMPTY1 OR RDLi
ERDLVIA_EMPTY = EMPTY1 OR RV
EALPA_EMPTY = EMPTY1 OR ALPAi
EMD_EMPTY = EMPTY1 OR MDi
ERDLPA2_EMPTY = EMPTY1 OR COVER
CONNECT ET4M2i_EMPTY EPA_EMPTY
CONNECT ET4M2i_EMPTY ERDL_EMPTY BY ERDLVIA_EMPTY
CONNECT ERDL_EMPTY ERDLPA2_EMPTY
CONNECT EPA_EMPTY EALPA_EMPTY
CONNECT ERDL_EMPTY EALPA_EMPTY
CONNECT EALPA_EMPTY EMD_EMPTY

#IFDEF ESD_CHECK YES

ESDN_1_SEDP_1 {
    @ Minimum ACT extnsion of CT on SOURCE >= 0.15
    (ENC ECT_S EMOS_S < 0.15 ABUT < 90 SINGULAR REGION) NOT INSIDE EDGE NODRC
}
ESDN_2_ESDP_2 {
    @ Minimum CT to Poly space on SOURCE >= 0.15
    (EXT ECT_S EGATE < 0.15 ABUT < 90 SINGULAR REGION) NOT INSIDE EDGE NODRC
}
ESDN_4_ESDP_4 {
    @ Minimum SAB overlap Poly on Drain >= 0.05
    (INTERNAL ESAB EGATE < 0.05 ABUT < 90 SINGULAR REGION) NOT INSIDE NODRC
}
ESDN_5_ESDP_5 {
    @ Minimum SAB to Poly on Drain space >= 1.29
    (EXT ESAB_HO_RAW EGATE < 1.29 OPPOSITE REGION) NOT INSIDE EDGE NODRC
}
ESDN_6_ESDP_6 {
    @ Minimum SAB to CT on Drain space >= 0.21
    (ENC ECT_D ESAB_HO_RAW < 0.21 ABUT <90 SINGULAR REGION) NOT INSIDE EDGE NODRC
}
ESDN_7_ESDP_7 {
    @ Minimum SAB to ACT space >= 0.21
    (ENC (ENMOS_DRAIN NOT COIN EDGE EGATE) (ESAB OR ESAB_HO_RAW) < 0.21 ABUT <90 REGION) NOT INSIDE EDGE NODRC
    (ENC (EPMOS_DRAIN NOT COIN EDGE EGATE) (ESAB OR ESAB_HO_RAW) < 0.21 ABUT <90 REGION) NOT INSIDE EDGE NODRC
}
ESDN_8_ESDP_8 {
    @ Minimum SAB overlap ACT >= 1
    (ENC ESAB_HO_RAW ENMOS_DRAIN < 1 ABUT <90 SINGULAR REGION) NOT INSIDE EDGE NODRC
    (ENC ESAB_HO_RAW EPMOS_DRAIN < 1 ABUT <90 SINGULAR REGION) NOT INSIDE EDGE NODRC
}
ESDN_9 {
    @ Minimum ESD implant to Poly space >= 0.4
    (EXT ESD1 EGATE < 0.4 OPPOSITE REGION) NOT INSIDE EDGE NODRC
}
ESDN_10 {
    @ Minimum ESD implant to ACT space >= 0.4
    (ENC ESD1 ENMOS_DRAIN < 0.4 ABUT <90 SINGULAR REGION) NOT INSIDE EDGE NODRC
}
ESDN_11 {
    @ ESD implant can't overlap Poly
    (ESD1 AND EGATE_POLY) NOT INSIDE EDGE NODRC
}
ESDN_12 {
    @ Unit finger width (F) of NMOS for ESD protection device >= 30um
    @ <= 40um
    (LENGTH (EGATE_W INSIDE EDGE ENMOS) < 30) NOT INSIDE EDGE NODRC
    (LENGTH (EGATE_W INSIDE EDGE ENMOS) > 40) NOT INSIDE EDGE NODRC
}
ESDP_9 {
    @ Unit finger width (F) of PMOS for ESD protection device >= 30um
    @ <= 40um
    (LENGTH (EGATE_W INSIDE EDGE EPMOS) < 30) NOT INSIDE EDGE NODRC
    (LENGTH (EGATE_W INSIDE EDGE EPMOS) > 40) NOT INSIDE EDGE NODRC
}

#IFDEF OPEN_RECOMMENDED_ON YES

ESDN_13_R {
    @ Total channel width of ESD NMOS. The total channel width is calculated by the ESD MOS in the same Drain connection. The connectivity can be formed by all metal, via, ALPA, PA and MD but not broken by resistors. SAB is used for drain recognition in DRC runset
    @ Channel width (W) of NMOS for ESD protection device (Channel width = Finger width x Finger No.) >= 150um
    X = NET AREA RATIO ENGATE_D_EMPTY ESD3C_EMPTY [AREA(ESD3C_EMPTY)/0.001] < 150
    ((X INTERACT ENGATE) NOT INTERACT EGATE_NOSAB) NOT INSIDE NODRC
}
ESDP_10_R {
    @ Total channel width of ESD PMOS. The total channel width is calculated by the ESD MOS in the same Drain connection. The connectivity can be formed by all metal, via, ALPA, PA and MD but not broken by resistors. SAB is used for drain recognition in DRC runset
    @ Channel width (W) of PMOS for ESD protection device (Channel width = Finger width x Finger No.) >= 300um
    X = NET AREA RATIO EPGATE_D_EMPTY ESD3C_EMPTY [AREA(ESD3C_EMPTY)/0.001] < 300
    ((X INTERACT EPGATE) NOT INTERACT EGATE_NOSAB) NOT INSIDE NODRC
}

#ENDIF


#IFDEF IO 1833

ESDN_3 {
    @ Channel length of 3.3V I/O NMOS for protection device. >= 0.5um
    X = (EGATEHV AND ENGATE) COIN EDGE EGATE_L
    (LENGTH X < 0.5) NOT INSIDE EDGE NODRC
}
ESDP_3 {
    @ Channel length of 3.3V I/O PMOS for protection device. >= 0.4um, <=0.5
    X = (EGATEHV AND EPGATE) COIN EDGE EGATE_L
    GOOD = (LENGTH X >= 0.4 <= 0.5) NOT INSIDE EDGE NODRC
    ((EGATEHV AND EPGATE) NOT WITH EDGE GOOD) NOT INSIDE EDGE NODRC
}

#ENDIF


#IFDEF IO 1825 

ESDN_3 {
    @ Channel length of 3.3V I/O NMOS for protection device. >= 0.5um
    X = (EGATEHV AND ENGATE) COIN EDGE EGATE_L
    (LENGTH X < 0.5) NOT INSIDE EDGE NODRC
}
ESDP_3 {
    @ Channel length of 3.3V I/O PMOS for protection device. >= 0.4um, <=0.5
    X = (EGATEHV AND EPGATE) COIN EDGE EGATE_L
    GOOD = (LENGTH X >= 0.4 <= 0.5) NOT INSIDE EDGE NODRC
    ((EGATEHV AND EPGATE) NOT WITH EDGE GOOD) NOT INSIDE EDGE NODRC
}

#ENDIF


#ENDIF

ESD_W_1 {
    @ ESD1 width >= 0.47um
    (INT ESD1 < 0.47 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
ESD_S_1 {
    @ Space between two ESD1s. Merge if space is less than this value. >= 0.47um
    (EXT ESD1 < 0.47 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
ESD_A_1 {
    @ ESD1 area >= 0.6um2
    (AREA ESD1 < 0.6) NOT INSIDE NODRC
}
ESD_A_2 {
    @ ESD1 enclosed area >= 0.6um2
    (AREA ((HOLES ESD1 INNER) NOT ESD1) < 0.6) NOT INSIDE NODRC
}
POWER_PAD = PVSS OR PVDD
ALL_RES = (AA ENCLOSE (AA_resistor OR NW_resistor)) OR (PO ENCLOSE PO_resistor)
