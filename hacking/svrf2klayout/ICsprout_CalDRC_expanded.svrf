}
M1DUM_S_7 {
    @ Space between two (MnDUM or Mn) having run length >=1.5um with one or both M1DUM width >=1.5um is 0.60um
    X0_a = M1ALL WITH WIDTH >= 1.5
    X0 = ENCLOSE RECTANGLE X0_a 1.5 1.5
    X1 = EXT M1ALL < 0.6 OPPOSITE REGION PARA ONLY
    X2 = LENGTH X1 >= 1.5
    X3 = X2 TOUCH EDGE X0
    X4_near = EXPAND EDGE X3 OUTSIDE BY 1.5
    X4_far = (EXPAND EDGE X3 OUTSIDE BY (1.5 + 0.01)) NOT X4_near
    X5 = X4_near NOT M1ALL
    X6_near = EXT X1 X5 < 1.5 OPPOSITE REGION
    X6_far = EXT X4_far X5 < 1.5 OPPOSITE REGION
    X7 = (X4_near NOT X5) NOT (X6_near OR X6_far)
    X7_edge = LENGTH (X7 COIN EDGE X1) >= 1.5
    X7_expand = EXPAND EDGE X7_edge OUTSIDE BY 0.6
    X8 = (X7_expand AND X1) NOT X5
    (X8 INTERACT M1DUM) NOT INSIDE NODRC
}
M1DUM_S_8 {
    @ Space between MnDUM and 45 degree Mn >= 0.4um
    X = ANGLE M1 == 45
    (EXT X M1DUM < 0.4 REGION) NOT INSIDE NODRC
}
