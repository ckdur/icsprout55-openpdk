T8M1ALL = (T8M1 NOT T8M1slot) OR T8M1DUM
T8M2ALL = (T8M2 NOT T8M2slot) OR T8M2DUM

//FOR DENSITY CHECK
M1ALLi = (MET1o NOT MET1sloti) OR MET1dmi
M2ALLi = (MET2o NOT MET2sloti) OR MET2dmi
M3ALLi = (MET3o NOT MET3sloti) OR MET3dmi
M4ALLi = (MET4o NOT MET4sloti) OR MET4dmi
M5ALLi = (MET5o NOT MET5sloti) OR MET5dmi
M6ALLi = (MET6o NOT MET6sloti) OR MET6dmi
M7ALLi = (MET7o NOT MET7sloti) OR MET7dmi
M8ALLi = (MET8o NOT MET8sloti) OR MET8dmi
T4M1ALLi = (T4M1o NOT T4M1sloti) OR T4M1dmi
T4M2ALLi = (T4M2o NOT T4M2sloti) OR T4M2dmi
T2M1ALLi = (T2M1o NOT T2M1sloti) OR T2M1dmi
T2M2ALLi = (T2M2o NOT T2M2sloti) OR T2M2dmi
T8M1ALLi = (T8M1o NOT T8M1sloti) OR T8M1dmi
T8M2ALLi = (T8M2o NOT T8M2sloti) OR T8M2dmi
//FOR CONNECTIVITY
MDi = CBi OR COVER
ALPA_PAi = SIZE CBi BY PA_su
ALPAi	= OR ALPA_PAi RDLi ALPAD
M1i   = MET1o NOT MET1sloti
M2i   = MET2o NOT MET2sloti
M3i   = MET3o NOT MET3sloti
M4i   = MET4o NOT MET4sloti
M5i   = MET5o NOT MET5sloti
M6i   = MET6o NOT MET6sloti
M7i   = MET7o NOT MET7sloti
M8i   = MET8o NOT MET8sloti
T4M1i  = T4M1o NOT T4M1sloti
T4M2i  = T4M2o NOT T4M2sloti
T2M1i = T2M1o NOT T2M1sloti
T2M2i = T2M2o NOT T2M2sloti
T8M1i  = T8M1o NOT T8M1sloti
T8M2i  = T8M2o NOT T8M2sloti

M1M2 = M1 AND M2
SV1_metal = M1M2 INTERACT V1 == 1
U4V1_metal = M1M2 INTERACT V1 < 4
M2M3 = M2 AND M3
SV2_metal = M2M3 INTERACT V2 == 1
U4V2_metal = M2M3 INTERACT V2 < 4
M3M4 = M3 AND M4
SV3_metal = M3M4 INTERACT V3 == 1
U4V3_metal = M3M4 INTERACT V3 < 4
M4M5 = M4 AND M5
SV4_metal = M4M5 INTERACT V4 == 1
U4V4_metal = M4M5 INTERACT V4 < 4
M5M6 = M5 AND M6
SV5_metal = M5M6 INTERACT V5 == 1
U4V5_metal = M5M6 INTERACT V5 < 4
M6M7 = M6 AND M7
SV6_metal = M6M7 INTERACT V6 == 1
U4V6_metal = M6M7 INTERACT V6 < 4
M7M8 = M7 AND M8
SV7_metal = M7M8 INTERACT V7 == 1
U4V7_metal = M7M8 INTERACT V7 < 4

//WIDE MAL FOR REDUNDANT V CHECK
WIDE_M1_0P30 = M1 WITH WIDTH >= 0.30
WIDE_M1_0P70 = WIDE_M1_0P30 WITH WIDTH >= 0.7

WIDE_M2_0P30 = M2 WITH WIDTH >= 0.30
WIDE_M2_0P70 = WIDE_M2_0P30 WITH WIDTH >= 0.7

WIDE_M3_0P30 = M3 WITH WIDTH >= 0.30
WIDE_M3_0P70 = WIDE_M3_0P30 WITH WIDTH >= 0.7

WIDE_M4_0P30 = M4 WITH WIDTH >= 0.30
WIDE_M4_0P70 = WIDE_M4_0P30 WITH WIDTH >= 0.7

WIDE_M5_0P30 = M5 WITH WIDTH >= 0.30
WIDE_M5_0P70 = WIDE_M5_0P30 WITH WIDTH >= 0.7

WIDE_M6_0P30 = M6 WITH WIDTH >= 0.30
WIDE_M6_0P70 = WIDE_M6_0P30 WITH WIDTH >= 0.7

WIDE_M7_0P30 = M7 WITH WIDTH >= 0.30
WIDE_M7_0P70 = WIDE_M7_0P30 WITH WIDTH >= 0.7

WIDE_M8_0P30 = M8 WITH WIDTH >= 0.30
WIDE_M8_0P70 = WIDE_M8_0P30 WITH WIDTH >= 0.7
//------------------------------------------------------------------------------------------

V1_org = OR VIA1i VIA1bar
V2_org = OR VIA2i VIA2bar
V3_org = OR VIA3i VIA3bar
V4_org = OR VIA4i VIA4bar
V5_org = OR VIA5i VIA5bar
V6_org = OR VIA6i VIA6bar
V7_org = OR VIA7i VIA7bar

V1bar = COPY VIA1bar
V2bar = COPY VIA2bar
V3bar = COPY VIA3bar
V4bar = COPY VIA4bar
V5bar = COPY VIA5bar
V6bar = COPY VIA6bar
V7bar = COPY VIA7bar

V1_slot = ((ENCLOSE RECTANGLE V1_org 0.1 0.30) AND GRID) INTERACT (WITH WIDTH V1_org == 0.09)
V2_slot = ((ENCLOSE RECTANGLE V2_org 0.1 0.30) AND GRID) INTERACT (WITH WIDTH V2_org == 0.09)
V3_slot = ((ENCLOSE RECTANGLE V3_org 0.1 0.30) AND GRID) INTERACT (WITH WIDTH V3_org == 0.09)
V4_slot = ((ENCLOSE RECTANGLE V4_org 0.1 0.30) AND GRID) INTERACT (WITH WIDTH V4_org == 0.09)
V5_slot = ((ENCLOSE RECTANGLE V5_org 0.1 0.30) AND GRID) INTERACT (WITH WIDTH V5_org == 0.09)
V6_slot = ((ENCLOSE RECTANGLE V6_org 0.1 0.30) AND GRID) INTERACT (WITH WIDTH V6_org == 0.09)
V7_slot = ((ENCLOSE RECTANGLE V7_org 0.1 0.30) AND GRID) INTERACT (WITH WIDTH V7_org == 0.09)

V1_slot_SG = (((ENCLOSE RECTANGLE V1_org 0.09 0.27) AND GRID) INTERACT (WITH WIDTH V1_org == 0.09)) OR V1_slot
V2_slot_SG = (((ENCLOSE RECTANGLE V2_org 0.09 0.27) AND GRID) INTERACT (WITH WIDTH V2_org == 0.09)) OR V2_slot
V3_slot_SG = (((ENCLOSE RECTANGLE V3_org 0.09 0.27) AND GRID) INTERACT (WITH WIDTH V3_org == 0.09)) OR V3_slot
V4_slot_SG = (((ENCLOSE RECTANGLE V4_org 0.09 0.27) AND GRID) INTERACT (WITH WIDTH V4_org == 0.09)) OR V4_slot
V5_slot_SG = (((ENCLOSE RECTANGLE V5_org 0.09 0.27) AND GRID) INTERACT (WITH WIDTH V5_org == 0.09)) OR V5_slot
V6_slot_SG = (((ENCLOSE RECTANGLE V6_org 0.09 0.27) AND GRID) INTERACT (WITH WIDTH V6_org == 0.09)) OR V6_slot
V7_slot_SG = (((ENCLOSE RECTANGLE V7_org 0.09 0.27) AND GRID) INTERACT (WITH WIDTH V7_org == 0.09)) OR V7_slot



#IFDEF ALLOW_V01 YES

V1ia = (RECTANGLE V1_org == 0.09 BY == 0.09) OR V1_slot
V2ia = (RECTANGLE V2_org == 0.09 BY == 0.09) OR V2_slot
V3ia = (RECTANGLE V3_org == 0.09 BY == 0.09) OR V3_slot
V4ia = (RECTANGLE V4_org == 0.09 BY == 0.09) OR V4_slot
V5ia = (RECTANGLE V5_org == 0.09 BY == 0.09) OR V5_slot
V6ia = (RECTANGLE V6_org == 0.09 BY == 0.09) OR V6_slot
V7ia = (RECTANGLE V7_org == 0.09 BY == 0.09) OR V7_slot
V1_sd = SIZE V1ia BY -0.005
V2_sd = SIZE V2ia BY -0.005
V3_sd = SIZE V3ia BY -0.005
V4_sd = SIZE V4ia BY -0.005
V5_sd = SIZE V5ia BY -0.005
V6_sd = SIZE V6ia BY -0.005
V7_sd = SIZE V7ia BY -0.005
V1r = V1_org NOT V1ia
V2r = V2_org NOT V2ia
V3r = V3_org NOT V3ia
V4r = V4_org NOT V4ia
V5r = V5_org NOT V5ia
V6r = V6_org NOT V6ia
V7r = V7_org NOT V7ia
V1O = COPY V1ia
V2O = COPY V2ia
V1 = COPY V1O
V2 = COPY V2O
V3 = COPY V3ia
V4 = COPY V4ia
V5 = COPY V5ia
V6 = COPY V6ia
V7 = COPY V7ia

#ENDIF


#IFDEF ALLOW_V01 NO

V1 = COPY V1_org
V2 = COPY V2_org
V3 = COPY V3_org
V4 = COPY V4_org
V5 = COPY V5_org
V6 = COPY V6_org
V7 = COPY V7_org

#ENDIF

CONNECT M1i M2i BY V1
CONNECT M2i M3i BY V2
CONNECT M3i M4i BY V3
CONNECT M4i M5i BY V4
CONNECT M5i T4M2i BY T4V2i
CONNECT T4M2i CBi
CONNECT T4M2i RDLi BY RV
CONNECT RDLi COVER
CONNECT CBi ALPAi
CONNECT RDLi ALPAi
CONNECT ALPAi MDi
CONNECT M1i PO0 NTAP0 PTAP0 PSDi NSDi BY CTi
CONNECT NTAP0 NW0
CONNECT NW1i DNWi //NW interact with DNW
CONNECT NTAP0 NW1i //N+pickup interact with NW
CONNECT PTAP0 PWi //P+pickup interact with (NOT NW)
CONNECT NTAP0 PSDi //N+pickup butted P+ silicided S/D
CONNECT PTAP0 NSDi //P+pickup butted N+ silicided S/D
CONNECT PSDi PSD
CONNECT NSDi NSD
CONNECT NW1i NW
CONNECT DNWi DNW
CONNECT PWi PW
CONNECT CTi CT
TEXT DEPTH PRIMARY
LVS POWER NAME ?VDD? ?VCC?
LABEL ORDER T4M2i M5i M4i M3i M2i M1i NTAP0 PTAP0 NSDi PSDi PO0 NW1i
VIRTUAL CONNECT NAME ?VDD? ?VCC? ?VSS? ?GND?
VIRTUAL CONNECT COLON YES

//******************************************
//    LAYER DERIVATIONS AND OPERATIONS
//******************************************


//==================
// For Connectivity
//==================

PACTi   = PPi AND ACTi
NACTi   = NPi AND ACTi

PTAPi   = PACTi NOT NW1i
NTAPi   = NACTi AND NW1i
ALL_TAPi    = PTAPi OR NTAPi
PGATEi  = PACTi AND POLYi
NGATEi  = NACTi AND POLYi

PSDi    = (PACTi NOT PGATEi) AND NW1i
NSDi    = (NACTi NOT NGATEi) NOT NW1i
ALL_SDi = PSDi OR NSDi
PMOSi   = (PGATEi OR PSDi) INTERACT GATE
NMOSi   = (NGATEi OR NSDi) INTERACT GATE

AARES = COPY ACTres
PORES = COPY POLYres

AA_resistor = ((AA AND AARES) AND SAB) OR ((AA AND AARES) NOT INTERACT SAB)
PO_resistor = (((PO AND PORES) AND SAB) OR ((PO AND PORES) NOT INTERACT SAB)) OR HPR
NW_resistor_AA = ((NW1res AND AA) AND NW) AND SAB
NW_resistor_STI = (NW1res AND NW) NOT INTERACT SAB
NW_resistor = NW_resistor_AA OR NW_resistor_STI

PO_all = POLYi OR POLYdmi
AA_all = ACTi OR ACTdmi

//AA0 = (ACTi NOT (AA_resistor OR NW1res)) NOT POLYi
PO0 = POLYi NOT (SAB AND (PORES OR HPR))
NW0 = NW1i NOT NW1res
NW00 = NW NOT NW1res

PTAP0   = PACTi NOT NW1i
NTAP0   = NACTi AND NW1i

HVNW0    = NW00 AND HVNW
MVNW0    = NW00 AND MVNW
LVNW0    = NW00 AND LVNW

//PO_raw = PO NOT SAB
PO_raw   = COPY PO

//==================
//  Resistor Def
//==================

NWR     = NW INTERACT NW1res
AAR     = AA INTERACT AARES
POR     = PO INTERACT PORES


NR      = NWR INSIDE AA
AANR    = AA INTERACT NWR
SDNNR    = SDN INTERACT NWR
SDPNR    = SDP INTERACT NWR

NWDEV   = NW NOT (NWR OR NR)
AADEV   = AA NOT (AAR OR AANR)
PODEV   = PO NOT POR
SDNDEV   = SDN NOT SDNNR
SDPDEV   = SDP NOT SDPNR

//=============
//   HRP Def
//=============

PO_HRP   =  ((HPR AND PO) AND HRP) AND SAB
//PO_HRP   = PO INTERACT HRP
//HR_PO    = PO_HRP AND HPR

//==================
//   Well Def
//==================

DRC:1   = EXTENT drawn original
BULK    = SIZE DRC:1 BY 1.0
CHIP = COPY DRC:1

//EMPTY = COPY CHIP
EMPTY1 = COPY EMPTY
//EMPTY4 = COPY EMPTY
EMPTY5 = COPY EMPTY

PW_INNW = DNW NOT NW
DNW_EDGE = EXPAND EDGE (DNW INSIDE EDGE NW) OUTSIDE BY 0.001
NW_DNW = NW INTERACT DNW_EDGE

DGTG    = TG OR DG

HVNW    = NW NOT OUTSIDE TG
MVNW    = NW NOT OUTSIDE DG
LVNW    = (NW NOT HVNW) NOT MVNW

HVNWi	= NW1i NOT OUTSIDE TG 
MVNWi	= NW1i NOT OUTSIDE DG 
LVNWi	= (NW1i NOT HVNWi) NOT MVNWi


//==================
// Transistor Def
//==================

PACT    = SDP AND AA
NACT    = SDN AND AA
//AA     = PACT OR NACT


PPO     = SDP AND PO
NPO     = SDN AND PO

PTAP    = PACT NOT NW
NTAP    = NACT AND NW
TAP     = PTAP OR NTAP

PICKAA = TAP NOT ((TAP INTERACT GATE) AND VARAM)
NON_PICKAA = AA NOT PICKAA


PGATE   = PACT AND PO
NGATE   = NACT AND PO

GATE0 = PO AND AA 
AA1 = (AA INTERACT GATE0) NOT GATE0
AA2 = AA1 TOUCH GATE0 == 2
AA3 = AA1 INTERACT CT 
AA4 = AA2 OR AA3
GATE1 = GATE0 TOUCH AA4 == 2
GATE2 = GATE0 AND LDMOS
GATE  = GATE1 OR GATE2

GATE_W_015 = INT (AA INSIDE EDGE PO) < 0.15 REGION OPPOSITE
AAcorner = EXT AA < 0.01 ABUT == 90 INTERSECTING ONLY REGION
POcorner = EXT PO < 0.01 ABUT == 90 INTERSECTING ONLY REGION
GATE_WIDTH_D15 = SIZE GATE_W_015 BY 0.005
GATE_WIDTH_U15 = SIZE (GATE0 NOT INTERACT GATE_WIDTH_D15) BY 0.005
PO015 = PO INTERACT GATE_W_015
AAintPO015 = AA INTERACT GATE_W_015
AA_CP = COPY ACTi
PO_CP = COPY POLYi
CONNECT AA_CP PO_CP
CONNECT PO015 AAintPO015

FPOLY = PO NOT AA
GATE_L = (GATE COIN EDGE AA) NOT COIN EDGE PO
GATE_W = GATE COIN EDGE PO
GATE_60nm = (EXPAND EDGE GATE_W INSIDE BY 0.06) INSIDE EDGE GATE       //for SAB_5

GATE_core = GATE NOT (DG OR TG)                        //1.0/1.2V MOS GATE
GATE_core_L  = (GATE_core COIN EDGE AA) NOT COIN EDGE PO  //1.0/1.2V MOS GATE LENGTH
GATE_core_W  = GATE_core COIN EDGE PO			    //1.0/1.2V MOS GATE WIDTH

GATE_io1 = (GATE AND DG) NOT TG     //1.8V MOS GATE
GATE_io1_L = (GATE_io1 COIN EDGE AA) NOT COIN EDGE PO
GATE_io1_W = GATE_io1 COIN EDGE PO

GATE_io2 = (GATE AND TG) NOT DG
GATE_io2_L = (GATE_io2 COIN EDGE AA) NOT COIN EDGE PO
GATE_io2_W = GATE_io2 COIN EDGE PO

GATE_var = GATE AND VARAM                        //VARMOS GATE
GATE_var_L  = (GATE_var COIN EDGE AA) NOT COIN EDGE PO  //VARMOS GATE LENGTH
GATE_var_W  = GATE_var COIN EDGE PO			    //VARMOS GATE WIDTH

PSD     = (PACT NOT PGATE) TOUCH PGATE
NSD     = (NACT NOT NGATE) TOUCH NGATE

PMOS    = PGATE OR PSD
NMOS    = NGATE OR NSD
MOS     = PMOS OR NMOS

NMOS_CAP = NMOS AND NW

PBAA   	= AA AND PSUB
PBMOS   = NMOS AND PSUB
PBPO   	= PO INTERACT PSUB
NOMI_AA = AA NOT PBAA


AAEIPO  = AA INSIDE EDGE PO
POEIAA  = PO INSIDE EDGE AA

INTERPO = PO NOT GATE


//=====================
//   Poly E-Fuse Def
//=====================

EFU    = PO INTERACT EFUSEALL
EFU_BO = EFU AND POEFUSEBLK
RCT    = CT INTERACT EFU
RCT_RT = RECTANGLE RCT == 0.09 BY == 0.30


//=====================
//     CT Def
//=====================

AA_CT   = CT AND AA
INTERCT  = CT AND INTERPO


ALFUSE = (RDL AND FUSE) AND FUTR
Al_fuse_1 = LENGTH ALFUSE >= 4.44
Al_fuse = ALFUSE WITH EDGE Al_fuse_1 >= 2
Alfuse_edge = LENGTH Al_fuse >= 4.44
Alfuse_edge_1 = CONVEX EDGE ALFUSE ANGLE1 == 270 ANGLE2 == 270
HM1 = (HOLES M1 INNER) INTERACT FUSE
GM1 = (M1 TOUCH HM1) AND GRID
GV1 = V1 INTERACT GM1
V1FUSE = V1 INSIDE HM1
 
HM2 = (HOLES M2 INNER) INTERACT FUSE
GM2 = (M2 TOUCH HM2) AND GRID
GV2 = V2 INTERACT GM2
V2FUSE = V2 INSIDE HM2
 
HM3 = (HOLES M3 INNER) INTERACT FUSE
GM3 = (M3 TOUCH HM3) AND GRID
GV3 = V3 INTERACT GM3
V3FUSE = V3 INSIDE HM3
 
HM4 = (HOLES M4 INNER) INTERACT FUSE
GM4 = (M4 TOUCH HM4) AND GRID
GV4 = V4 INTERACT GM4
V4FUSE = V4 INSIDE HM4
 
HM5 = (HOLES M5 INNER) INTERACT FUSE
GM5 = (M5 TOUCH HM5) AND GRID
GT4V2 = T4V2 INTERACT GM5
T4V2FUSE = T4V2 INSIDE HM5
 
HT4M2 = (HOLES T4M2 INNER) INTERACT FUSE
GT4M2 = (T4M2 TOUCH HT4M2) AND GRID
 
GCT = CT INTERACT GM1
CTFUSE = CT INSIDE HM1
HRDL = (HOLES RDL inner ) INTERACT FUSE
GRDL = (RDL TOUCH HRDL) AND GRID
GRDLV = RDLV INTERACT GRDL
RDLVF = RDLV INSIDE HRDL
Stack_Vn = V1FUSE INTERACT (V2FUSE INTERACT (V3FUSE INTERACT (V4FUSE INTERACT (T4V2FUSE INTERACT RDLVF))))
Stack_MR = GM1 OR (GM2 OR (GM3 OR (GM4 OR (GM5 OR (GT4M2 OR GRDL)))))
LMARK = (RDL AND FUSE) AND LOGO
PO_VEX_0 = CONVEX EDGE PO == 0
PO_VEX_1 = CONVEX EDGE PO == 1
PO_VEX_2 = CONVEX EDGE PO == 2
PO_LS = ((PO NOT WITH EDGE PO_VEX_0) WITH EDGE PO_VEX_1 == 2) WITH EDGE PO_VEX_2 == 4
PO_TS1 = ((PO NOT WITH EDGE PO_VEX_0) WITH EDGE PO_VEX_1 == 4) WITH EDGE PO_VEX_2 == 4
PO_TS2 = EXPAND EDGE (PO_VEX_2 COIN EDGE PO_TS1) OUTSIDE BY 0.005 CORNER FILL
PO_TS3 = PO_TS2 WITH EDGE PO_VEX_2 == 3
PO_TS = PO_TS1 INTERACT PO_TS3 == 1
PO_US = ((PO WITH EDGE PO_VEX_0 == 1) WITH EDGE PO_VEX_1 == 2) WITH EDGE PO_VEX_2 == 5
PO_OS = ((PO WITH EDGE PO_VEX_0 == 4) NOT WITH EDGE PO_VEX_1) WITH EDGE PO_VEX_2 == 4
PO_HS = ((PO WITH EDGE PO_VEX_0 ==2) WITH EDGE PO_VEX_1 == 4) WITH EDGE PO_VEX_2 == 6
AA_VEX_0 = CONVEX EDGE AA == 0
AA_VEX_1 = CONVEX EDGE AA == 1
AA_VEX_2 = CONVEX EDGE AA == 2
AA_LS = ((AA NOT WITH EDGE AA_VEX_0) WITH EDGE AA_VEX_1 == 2) WITH EDGE AA_VEX_2 == 4
AA_TS1 = ((AA NOT WITH EDGE AA_VEX_0) WITH EDGE AA_VEX_1 == 4) WITH EDGE AA_VEX_2 == 4
AA_TS2 = EXPAND EDGE (AA_VEX_2 COIN EDGE AA_TS1) OUTSIDE BY 0.005 CORNER FILL
AA_TS3 = AA_TS2 WITH EDGE AA_VEX_2 == 3
AA_TS = AA_TS1 INTERACT AA_TS3 == 1
AA_US = ((AA WITH EDGE AA_VEX_0 == 1) WITH EDGE AA_VEX_1 == 2) WITH EDGE AA_VEX_2 == 5
AA_OS = ((AA WITH EDGE AA_VEX_0 == 4) NOT WITH EDGE AA_VEX_1) WITH EDGE AA_VEX_2 == 4
AA_HS = ((AA WITH EDGE AA_VEX_0 ==2) WITH EDGE AA_VEX_1 == 4) WITH EDGE AA_VEX_2 == 6
GROUP GDNW DNW_?
DNW_W_1 {
    @ DNW width >= 3.00um
    (INT DNW < 3.0 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
DNW_S_1 {
    @ Space between two DNWs >= 3.50um
    (EXT DNW < 3.5 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
DNW_S_2a {
    @ Space between DNW and NW at different net >= 2.35um
    (EXT DNW NW < 2.35 SINGULAR REGION MEASURE ALL NOT CONNECTED) NOT INSIDE NODRC
}
DNW_S_3 {
    @ Space between TPW and (TPW OR PW1) >= 0.80um
    X = PW INSIDE DNW
    Y = PW OR X
    ((EXT X Y < 0.80 ABUT<90 SINGULAR REGION) NOT INSIDE LDMOS) NOT INSIDE NODRC
}
DNW_S_4 {
    @ Space between TPW and (TPW OR PW) when at least one TPW OR PW interact DG >= 1.20um
    TPWDTG = (PW INSIDE DNW) AND (DG OR TG)
    PWDTG = PW AND (DG OR TG)
    TPW = PW INSIDE DNW
    ((EXT TPWDTG TPW < 1.20 ABUT<90 SINGULAR REGION ) NOT INSIDE LDMOS) NOT INSIDE NODRC
    ((EXT PWDTG TPW < 1.20 ABUT<90 SINGULAR REGION ) NOT INSIDE LDMOS) NOT INSIDE NODRC
}
DNW_S_5 {
    @ Space between DNW and N+AA >= 1.60um
    (EXT DNW NSDi < 1.60 SINGULAR REGION ) NOT INSIDE NODRC
}
DNW_EN_1 {
    @ NW Enclosure of DNW >= 1.00um
    (ENC DNW NW < 1.0 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
    (DNW COINCIDENT EDGE NW) NOT INSIDE EDGE NODRC
    (DNW OUTSIDE EDGE NW) NOT INSIDE EDGE NODRC
}
DNW_EN_2 {
    @ Enclosure of N+ AA >= 0.55um
    (ENC (NACT NOT (NTAP OR PTAP)) DNW < 0.55 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
DNW_O_1 {
    @ Overlap of NW and DNW. >= 0.40um
    (INT NW DNW < 0.4 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
DNW_R_1 {
    @ It is recommanded DNW be enclosed by NW
    ((DNW NOT INSIDE EDGE NW_DNW) NOT COIN EDGE NW_DNW) NOT INSIDE EDGE NODRC
}
DNW_R_3 {
    @ Floating TPW is not allowed. DRC flags TPW not TOUCH CT in P+ pickup AA
    X = PW INSIDE DNW
    X NOT INTERACT (CT INTERACT PTAP)
}
GROUP GACT ACT_?
ACT_W_1 {
    @ AA width >= 0.08um
    (INT AA < 0.08 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
ACT_W_2 {
    @ Width of 45 degree bent AA >= 0.18um
    X = ANGLE AA == 45
    (INT X < 0.18 ABUT<90 REGION) NOT INSIDE NODRC
}
ACT_W_3a {
    @ Channel width for 0.9/1.2V NMOS/PMOS transistors >= 0.12um
    Y = LENGTH GATE_core_W < 0.12
    ((EXPAND EDGE Y INSIDE BY 0.001) NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
ACT_W_3b {
    @ Channel width for 1.8/2.5V/3.3V NMOS/PMOS transistors >= 0.21um
    Y = LENGTH GATE_io1_W < 0.21
    ((EXPAND EDGE Y INSIDE BY 0.001) NOT INSIDE SRAMALL) NOT INSIDE NODRC
    Z = LENGTH GATE_io2_W < 0.21
    ((EXPAND EDGE Z INSIDE BY 0.001) NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

#IFDEF OPEN_RECOMMENDED_ON YES

ACT_W_3a_R {
    @ Recommended Channel width for 0.9/1.2V NMOS/PMOS transistors >= 0.15um
    Y = LENGTH GATE_core_W < 0.15
    ((EXPAND EDGE Y INSIDE BY 0.001) NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

#ENDIF

ACT_L_1 {
    @ Maximum AA length between two contacts, or between one contact and AA line end when AA width < 0.15um <= 25.00um
    AA_1 = AA INTERACT CT
    AA_CHECK = AA_1 WITH WIDTH < 0.15
    Z0 = SIZE CT BY 12.5 INSIDE OF AA_CHECK STEP 0.02
    Z1 = Z0 INTERACT CT < 2
    Z2 = (AA_CHECK INTERACT Z1) NOT (AA_CHECK INTERACT CT == 1)
    Z2 NOT INSIDE NODRC
    AA_CHECK_2 = INT AA_1 < 0.15 OPPOSITE REGION
    Z4 = AA_CHECK_2 NOT INTERACT CT
    Z6 = LENGTH Z4 >25
    Z6 NOT INSIDE EDGE NODRC
    X = CONVEX EDGE AA ANGLE1>=89.9<=90.1 ANGLE2>=89.9<=90.1 WITH LENGTH<0.15
    Y = (AA WITH WIDTH <0.15) INTERACT CT
    Z = Y TOUCH EDGE X
    Z3 = SIZE CT BY 25 INSIDE OF Y STEP 0.02
    ((Z NOT INSIDE EDGE Z3) NOT TOUCH EDGE Z3) NOT INSIDE EDGE NODRC
}
ACT_L_2 {
    @ Maximum AA length of Source Active (without CT, width <= 0.15um) which butted with tap <= 0.5um
    AA_1 = ALL_SDi NOT INTERACT CT
    AA_2 = AA_1 WITH WIDTH < 0.15
    AA_3 = AA_2 INTERACT ALL_TAPi
    AA_4 = LENGTH AA_3 > 0.5
    ((ALL_SDi WITH EDGE AA_4) NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
ACT_S_1 {
    @ Space between two AAs > = 0.11um
    (EXT AA < 0.11 ABUT<90 SINGULAR REGION) NOT INSIDE (NODRC OR SRAMALL)
}

#IFDEF OPEN_RECOMMENDED_ON YES

ACT_S_1_R {
    @ Recommended Space between two AAs > = 0.16um
    (EXT AA < 0.16 ABUT<90 SINGULAR REGION) NOT INSIDE (NODRC OR SRAMALL)
}
ACT_S_2a_R {
    @ Recommended Space between AA and huge AA(area> 2000000um2) is 0.35um
    AA_huge = AREA AA > 2000000
    (EXT AA AA_huge < 0.35 ABUT<90 SINGULAR REGION) NOT INSIDE (NODRC OR SRAMALL)
}
ACT_R_3 {
    @ N+ AA is not allowed to be straddle on the boundary of NW1, except NW resistor/LDMOS region
    X = COPY NACT
    (X CUT (NW NOT INTERACT (LDMOS OR NW1res))) NOT INSIDE NODRC
}

#ENDIF

ACT_S_1a {
    @ Space between two AAs at least one AA inside by TG
    AA_TG = AA INSIDE TG
    (EXT AA AA_TG < 0.16 ABUT<90 SINGULAR REGION) NOT INSIDE (NODRC OR SRAMALL)
}
ACT_S_2 {
    @ Space between AAs when one or both AA width greater than 0.2um parallel length >= 0.3, >= 0.125
    X = AA WITH WIDTH > 0.2
    Y = EXT X AA < 0.125 OPPOSITE REGION
    (ENCLOSE RECTANGLE Y 0.3 0.08 ORTHOGONAL ONLY) NOT INSIDE (NODRC OR SRAMALL)
}
ACT_S_3 {
    @ Space to 45 degree bent AA >= 0.18um
    X = ANGLE AA == 45
    (EXT X AA < 0.18 ABUT<90 REGION) NOT INSIDE NODRC
}
ACT_S_4 {
    @ Space between U-shape (or O-shape) AA inner edges >= 0.18um
    (CONVEX EDGE AA_OS == 0 WITH LENGTH < 0.18) NOT INSIDE EDGE NODRC
    (CONVEX EDGE AA_US == 0 WITH LENGTH < 0.18) NOT INSIDE EDGE NODRC
}
ACT_S_5 {
    @ Space between NW and N+AA inside PW except NW resistor region >= 0.15um
    X = EXT (NW NOT INTERACT NW1res) (NACT INSIDE PW) < 0.15 ABUT<90 SINGULAR REGION
    (X NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
ACT_S_6 {
    @ Space between NW and N+AA inside TG >= 0.31um
    X = EXT (NW NOT INTERACT NW1res) (NACT INSIDE TG) < 0.31 ABUT<90 SINGULAR REGION
    (X NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
ACT_S_7 {
    @ Space between N+AA, which is not enclosed by DNW, and NW which encloses a DNW >= 0.32um
    X = EXT NACT NW_DNW < 0.32 ABUT<90 SINGULAR REGION
    (X NOT DNW) NOT INSIDE NODRC
}
ACT_S_8 {
    @ Space between NW and P+ pickup AA except LDMOS region >= 0.15um
    X = EXT NW (((PACT NOT NW) NOT PSUB) NOT INSIDE LDMOS) < 0.15 ABUT<90 SINGULAR REGION
    (X NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
ACT_EN_1 {
    @ Enclosure of N+AA by NW (excluding NW interacting with NW1res) >= 0.15um
    X = ENC NACT (NW NOT INTERACT NW1res) < 0.15 ABUT<90 SINGULAR REGION
    (X NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
ACT_EN_2 {
    @ Enclosure P+AA by NW >= 0.15um
    X = ENC PACT NW < 0.15 ABUT<90 SINGULAR REGION
    (X NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
ACT_EN_2a {
    @ Enclosure P+AA by (NW INTERACT TG) >= 0.31um
    X = ENC PACT (NW INTERACT TG) < 0.31 ABUT<90 SINGULAR REGION
    (X NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
ACT_A_1 {
    @ AA area >= 0.0384um2
    X = AREA AA < 0.0384
    (X NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
ACT_A_2 {
    @ Enclosed area >= 0.08um2
    (AREA ((HOLES AA INNER) NOT AA) < 0.08) NOT INSIDE NODRC
}

#IFDEF Density_rules YES

ACT_D_1_min {
    @ AA density (including dummy AA) in 100umX100um window with step size 50um >= 20%
    @ <= 80%
    (DENSITY AA_all < 0.20 WINDOW 100 STEP 50 BACKUP PRINT density_report_AA_D_1_min.log) NOT INSIDE NODRC
}
ACT_D_1_max {
    @ AA density (including dummy AA) in 100umX100um window with step size 50um >= 20%
    @ <= 80%
    (DENSITY AA_all > 0.80 WINDOW 100 STEP 50 BACKUP PRINT density_report_AA_D_1_max.log) NOT INSIDE NODRC
}
ACT_D_2 {
    @ AA density inside of dummy block area size up 2.5um, >= 10%
    X1 = AADUMB SIZE BY 2.5
    (DENSITY AA_all < 0.10 WINDOW 20 STEP 10 BACKUP INSIDE OF LAYER X1 PRINT density_report_AA_D_2.log) NOT INSIDE NODRC
}
ACT_D_3 {
    @ AA density gradienct <= 20%
    (DENSITY AA_all >= 0 WINDOW 100 GRADIENT > 0.2 ABSOLUTE BACKUP INSIDE OF LAYER BULK PRINT density_report_AA_D_3.log) NOT INSIDE NODRC
}
ACT_D_4_min {
    @ Global AA density for fully chip (including dummy AA) >= 25%
    @ <= 75%
    (DENSITY AA_all < 0.25 PRINT density_report_AA_D_4_min.log) NOT INSIDE NODRC
}
ACT_D_4_max {
    @ Global AA density for fully chip (including dummy AA) >= 25%
    @ <= 75%
    (DENSITY AA_all > 0.75 PRINT density_report_AA_D_4_max.log) NOT INSIDE NODRC
}

#ENDIF

ACT_R_1 {
    @ AA must be fully covered by (NP OR PP), except NW resistor region
    (AA NOT (SDN OR SDP)) NOT INTERACT NW1res
}
GROUP GNW1 NW1_?
NW_RE = NW NOT OUTSIDE EDGE NW1res
LVNW_RE = NW_RE COIN EDGE LVNW
MVNW_RE = NW_RE COIN EDGE MVNW
HVNW_RE = NW_RE COIN EDGE HVNW
NWRES = NW AND NW1res
NW1_W_1 {
    @ NW1 width >= 0. 47um
    ((INT NW < 0.47 ABUT<90 SINGULAR REGION) NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
NW1_S_1 {
    @ Space between NW1s >= 0. 47um
    ((EXT LVNW0 < 0.47 ABUT<90 SINGULAR REGION) NOT NWRES) NOT INSIDE NODRC
}
NW1_S_2 {
    @ Space between 0.9/1.2V NW1s at different nets >= 1.0um
    ((EXT LVNW0 < 1.0 ABUT<90 SINGULAR REGION NOT CONNECTED) NOT NWRES) NOT INSIDE NODRC
}
NW1_S_3 {
    @ Space between 0.9/1.2V NW1 and 1.8/2.5/3.3V NW1 at different nets. >= 1.20um
    (EXT LVNW0 HVNW0 < 1.2 ABUT<90 SINGULAR REGION NOT CONNECTED) NOT INSIDE NODRC
    (EXT LVNW0 MVNW0 < 1.2 ABUT<90 SINGULAR REGION NOT CONNECTED) NOT INSIDE NODRC
    (EXT LVNW_RE MVNW < 1.2 ABUT<90 REGION) NOT INSIDE NODRC
    (EXT LVNW_RE HVNW < 1.2 ABUT<90 REGION) NOT INSIDE NODRC
    (EXT MVNW_RE LVNW < 1.2 ABUT<90 REGION) NOT INSIDE NODRC
    (EXT HVNW_RE LVNW < 1.2 ABUT<90 REGION) NOT INSIDE NODRC
}
NW1_S_4 {
    @ Space between 1.8/2.5/3.3V NW1s at same nets. >= 0.47um
    ((EXT MVNW0 < 0.47 ABUT<90 SINGULAR REGION CONNECTED) NOT INSIDE NWRES) NOT INSIDE NODRC
    ((EXT HVNW0 < 0.47 ABUT<90 SINGULAR REGION CONNECTED) NOT INSIDE NWRES) NOT INSIDE NODRC
    (EXT MVNW0 HVNW0 < 0.47 ABUT<90 SINGULAR REGION CONNECTED) NOT INSIDE NODRC
}
NW1_S_5 {
    @ Space between 1.8/2.5/3.3V NW1s at different nets. >= 1.2 um
    ((EXT MVNW0 < 1.2 ABUT<90 SINGULAR REGION NOT CONNECTED) NOT NWRES) NOT INSIDE NODRC
    ((EXT HVNW0 < 1.2 ABUT<90 SINGULAR REGION NOT CONNECTED) NOT NWRES) NOT INSIDE NODRC
    (EXT MVNW0 HVNW0 < 1.2 ABUT<90 SINGULAR REGION NOT CONNECTED) NOT INSIDE NODRC
    (EXT MVNW_RE MVNW < 1.2 ABUT<90 REGION) NOT INSIDE NODRC
    (EXT HVNW_RE HVNW < 1.2 ABUT<90 REGION) NOT INSIDE NODRC
    (EXT MVNW_RE HVNW < 1.2 ABUT<90 REGION) NOT INSIDE NODRC
    (EXT HVNW_RE MVNW < 1.2 ABUT<90 REGION) NOT INSIDE NODRC
}
NW1_A_1 {
    @ NW1 area >= 0.30um2
    (AREA NW < 0.3) NOT INSIDE NODRC
}
NW1_A_2 {
    @ Enclosed area >= 0.3um2
    (AREA ((HOLES NW INNER) NOT NW) < 0.3) NOT INSIDE NODRC
}
NW1_R_1 {
    @ Floating NW1 is not allowed.
    ( NW NOT INTERACT (NTAP ENCLOSE CT)) NOT INSIDE NODRC
}
GROUP GPSUB PSUB_?
PSUB_W_1 {
    @ PSUB width >= 0.47um
    (INT PSUB < 0.47 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
PSUB_W_2 {
    @ 0.9/1.2/1.8/2.5/3.3V native NMOS channel width >= 0.50um
    @ 0.9/1.2/1.8/2.5/3.3V native NMOS channel width <= 100um
    X = LENGTH GATE_W < 0.5
    Y = LENGTH GATE_W > 100
    ((EXPAND EDGE X INSIDE BY 0.005) AND PSUB) NOT INSIDE NODRC
    ((EXPAND EDGE Y INSIDE BY 0.005) AND PSUB) NOT INSIDE NODRC
}
PSUB_W_3a {
    @ 1.2V native NMOS channel length >= 0.20um
    @ 1.2V native NMOS channel length <= 100um
    X = (PBPO INSIDE EDGE PBAA) NOT INSIDE EDGE (OR DG TG)
    Y = LENGTH GATE_core_L > 100
    (INT X < 0.20 ABUT<90 OPPOSITE REGION) NOT INSIDE NODRC
    ((EXPAND EDGE Y INSIDE BY 0.005) AND PSUB) NOT INSIDE NODRC
}
PSUB_W_3b {
    @ 1.8V native NMOS channel length >= 0.8um
    @ 1.8V native NMOS channel length <= 20um
    X = PBPO INSIDE EDGE (PBAA AND DG)
    Y = LENGTH GATE_io1_L > 20
    (INT X < 0.80 ABUT<90 OPPOSITE REGION) NOT INSIDE NODRC
    ((EXPAND EDGE Y INSIDE BY 0.005) AND PSUB) NOT INSIDE NODRC
}

#IFDEF IO 1825

PSUB_W_3c {
    @ 2.5V (or overdrive to 3.3V and underdrive to 1.8V) native NMOS channel length >= 1.0um
    @ 2.5V (or overdrive to 3.3V and underdrive to 1.8V) native NMOS channel length <= 20.0um
    X = PBPO INSIDE EDGE (PBAA AND TG)
    Y = LENGTH GATE_io2_L > 20
    (INT X < 1.0 ABUT<90 OPPOSITE REGION) NOT INSIDE NODRC
}

#ENDIF


#IFDEF IO 1833

PSUB_W_3d {
    @ 3.3V native NMOS channel length >= 1.0um
    X = PBPO INSIDE EDGE (PBAA AND TG)
    (INT X < 1.0 ABUT<90 OPPOSITE REGION) NOT INSIDE NODRC
}

#ENDIF

PSUB_S_1 {
    @ Space between two PSUBs >= 0.47um
    (EXT PSUB < 0.47 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
PSUB_S_2 {
    @ Space between PSUB and native MOS AA >= 0.36um
    (EXT PSUB MOS < 0.36 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
    (EXT PSUB AA_LDMOS < 0.36 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
PSUB_S_3 {
    @ Space between PSUB and NW >= 1.15um
    (EXT PSUB NW < 1.15 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
PSUB_EN_1 {
    @ Native NMOS AA enclosure by PSUB = 0.285um
    X = SIZE PBMOS BY 0.285
    Y = PSUB INTERACT PBMOS
    (XOR X Y) NOT INSIDE NODRC
}
PSUB_EX_1 {
    @ Extension of native NMOS poly GATE outside of AA
    @ DRC doesn't flag INDALL covered regions. >= 0.32um
    ((ENC PBAA PBPO < 0.32 ABUT<90 REGION OPPOSITE) NOT INSIDE INDALL) NOT INSIDE NODRC
}
PSUB_R_1 {
    @ PSUB inside, overlapping with, or crossing over a DNW area is not allowed
    (PSUB AND DNW) NOT INSIDE NODRC
    (PSUB COINCIDENT OUTSIDE EDGE DNW) NOT INSIDE EDGE NODRC
}
PSUB_R_2 {
    @ It is not allowed PSUB overlap PP ,DRC waive check INDALL covered region, and P+ pickup can be waived.
    X = (SDP AND PSUB) NOT INSIDE INDALL
    Y = ((AA OR PO) INTERACT GATE) AND PSUB
    (X INTERACT Y) NOT INSIDE NODRC
}
PSUB_R_3 {
    @ Only one AA pattern is allowed in o PSUB region, except for NMOS capacitors
    (PSUB INTERACT (AA NOT INTERACT INDALL) > 1) NOT INSIDE NODRC
}
PSUB_A_1 {
    @ PSUB area >= 0.60um2
    (AREA PSUB < 0.6) NOT INSIDE NODRC
}
PSUB_A_2 {
    @ Enclosed area >= 0.60um2
    (AREA ((HOLES PSUB INNER) NOT PSUB) < 0.60) NOT INSIDE NODRC
}


//===============================
//   NVT3: High Vt NMOS Implant
//===============================

GROUP GNVT3 NVT3_?

NVT3_W_1 {
@ NVT3 width. Single-point-interaction is allowed. >= 0.18um
  (INT HVTN < 0.18 ABUT<90 REGION) NOT INSIDE NODRC
}

NVT3_S_1 {
@ Space between two NVT3s >= 0.18um
  (EXT HVTN < 0.18 ABUT<90 OPPOSITE REGION) NOT INSIDE NODRC
}

NVT3_S_2 {
@ Space between NVT3 and GATE along source/drain direction >= 0.180um
  X = (PO INSIDE EDGE (AA NOT HVTN)) COIN EDGE GATE
  (EXT X HVTN < 0.180 ABUT<90 REGION OPPOSITE) NOT INSIDE NODRC
}

NVT3_S_3 {
@ Space between NVT3 and AA along GATE poly direction, excluding SRAM region >= 0.15um
  X1 = NACT TOUCH EDGE (AA INSIDE EDGE PO)
  X2 = PACT TOUCH EDGE (AA INSIDE EDGE PO)
  X = X1 OR EDGE X2
  ((EXT X HVTN < 0.15 ABUT<90 REGION OPPOSITE) NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

NVT3_S_4 {
@ NVT3 space to non-silicide AA >=0.21
 X = (AA AND SAB) NOT INSIDE HVTN
 (EXT X HVTN < 0.21 ABUT<90 REGION OPPOSITE) NOT INSIDE NODRC
}

NVT3_EX_1 {
@ NVT3 extension outside of GATE along source/drain direction >= 0.18um
  X = (PO INSIDE EDGE (NACT AND HVTN)) COIN EDGE GATE
  Y = EXPAND EDGE X OUTSIDE BY 0.18
  (Y NOT HVTN) NOT INSIDE NODRC
}

NVT3_EX_2 {
@ NVT3 extension outside of MOS AA along GATE poly length direction. >= 0.15um
  X = (NACT AND HVTN) TOUCH EDGE GATE 
  Y = ENC X HVTN < 0.15 ABUT<90 REGION OPPOSITE
  (Y NOT INSIDE SRAMALL) NOT INSIDE NODRC
 }

NVT3_A_1 {
@ NVT3 area >= 0.18um2
  ((AREA HVTN < 0.18) NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

NVT3_A_2 {
@ NVT3 Enclosed area >= 0.18um2
  (AREA ((HOLES HVTN INNER) NOT HVTN) < 0.18) NOT INSIDE NODRC
}

NVT3_R_1 {
@ It is not allowed NVT3 overlap with PSUB, P+ active AA(exclude pick-up AA), NVT1, DG or TG
  (AND HVTN PSUB) NOT INSIDE NODRC
  (AND HVTN (PACT NOT (NTAP OR PTAP))) NOT INSIDE NODRC
  (AND HVTN LVTN) NOT INSIDE NODRC
  (AND HVTN DG) NOT INSIDE NODRC
  (AND HVTN TG) NOT INSIDE NODRC
}


//===============================
//   PVT3: High Vt PMOS Implant
//===============================

GROUP GPVT3 PVT3_?

PVT3_W_1 {
@ PVT3 width. Single-point-interaction is allowed. >= 0.18um
  (INT HVTP < 0.18 ABUT<90 REGION) NOT INSIDE NODRC
}

PVT3_S_1 {
@ Space between two PVT3s >= 0.18um
  (EXT HVTP < 0.18 ABUT<90 OPPOSITE REGION) NOT INSIDE NODRC
}

PVT3_S_2 {
@ Space between PVT3 and GATE along source/drain direction >= 0.180um
  X = (PO INSIDE EDGE AA) COIN EDGE GATE
  (EXT X HVTP < 0.180 ABUT<90 REGION OPPOSITE) NOT INSIDE NODRC
}

PVT3_S_3 {
@ Space between PVT3 and AA along poly length direction, excluding SRAM region >= 0.15um
  X1 = PACT TOUCH EDGE (AA INSIDE EDGE PO)
  X2 = NACT TOUCH EDGE (AA INSIDE EDGE PO)
  X = X1 OR EDGE X2
  ((EXT X HVTP < 0.15 ABUT<90 REGION OPPOSITE) NOT INSIDE SRAMALL)NOT INSIDE NODRC
  }

PVT3_S_4 {
@ PVT3 space to non-silicide AA >=0.21
 X = (AA AND SAB) NOT INSIDE HVTP
 (EXT X HVTP < 0.21 ABUT<90 REGION OPPOSITE) NOT INSIDE NODRC
}

PVT3_EX_1 {
@ PVT3 extension outside of GATE along source/drain direction >= 0.180um
  X = (PO INSIDE EDGE (PACT AND HVTP)) COIN EDGE GATE
  Y = EXPAND EDGE X OUTSIDE BY 0.180
  (Y NOT HVTP) NOT INSIDE NODRC
}

PVT3_EX_2 {
@ PVT3 extension outside of AA along GATE poly length direction. >= 0.15um
  X = (PACT AND HVTP) TOUCH EDGE GATE
  Y = ENC X HVTP < 0.15 ABUT<90 REGION OPPOSITE
  (Y NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

PVT3_A_1 {
@ PVT3 area >= 0.18um2
  ((AREA HVTP < 0.18) NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

PVT3_A_2 {
@ PVT3 Enclosed area >= 0.18um2
  (AREA ((HOLES HVTP INNER) NOT HVTP)< 0.18) NOT INSIDE NODRC
}

PVT3_R_1 {
@ It is not allowed PVT3 overlap with PSUB, N+ active AA(exclude pick-up AA), PVT1, DG or TG 
  (AND HVTP PSUB) NOT INSIDE NODRC
  (AND HVTP (NACT NOT (NTAP OR PTAP))) NOT INSIDE NODRC
  (AND HVTP LVTP) NOT INSIDE NODRC
  (AND HVTP DG) NOT INSIDE NODRC
  (AND HVTP TG) NOT INSIDE NODRC
}

//===========================================
//  NVT1: low Vt NMOS design minima 
//===========================================

GROUP GNVT1 NVT1_?

NVT1_W_1 {
@ NVT1 width. Single-point-interaction is allowed. >= 0.18um
  (INT LVTN < 0.18 ABUT<90 REGION) NOT INSIDE NODRC
}

NVT1_S_1 {
@ Space between two NVT1s >= 0.18um
  (EXT LVTN < 0.18 ABUT<90 OPPOSITE REGION) NOT INSIDE NODRC
}

NVT1_S_2 {
@ Space between NVT1 and GATE along source/drain direction >= 0.180um
  X1 = PO INSIDE EDGE (NACT NOT LVTN)
  X2 = PO INSIDE EDGE (PACT NOT LVTN)
  X = X1 OR EDGE X2
  (EXT LVTN X < 0.180 ABUT<90 REGION OPPOSITE) NOT INSIDE NODRC
}

NVT1_S_3 {
@ Space between NVT1 and AA along poly length direction. >= 0.15um
  X1 = NACT TOUCH EDGE (AA INSIDE EDGE PO)
  X2 = PACT TOUCH EDGE (AA INSIDE EDGE PO)
  X = X1 OR EDGE X2
  (EXT X LVTN < 0.15 ABUT<90 REGION OPPOSITE) NOT INSIDE NODRC
}

NVT1_S_4 {
@ NVT1 space to non-silicide AA >=0.21
  A = LVTN INSIDE EDGE GATE
  B = LVTN OUTSIDE EDGE GATE
 X = (AA AND SAB) NOT INSIDE LVTN
 (EXT X LVTN < 0.21 ABUT<90 REGION OPPOSITE) NOT INSIDE NODRC
}

NVT1_EX_1 {
@ NVT1 extension outside of GATE along source/drain direction >= 0.180um
  X = PO INSIDE EDGE (NACT AND LVTN)
  Y = EXPAND EDGE X OUTSIDE BY 0.180
  (Y NOT LVTN) NOT INSIDE NODRC
}

NVT1_EX_2 {
@ NVT1 extension outside of AA along GATE poly length direction. >= 0.15um
  X = (NACT AND LVTN) TOUCH EDGE GATE
  (ENC X LVTN < 0.15 ABUT<90 REGION OPPOSITE) NOT INSIDE NODRC
}

NVT1_A_1 {
@ NVT1 area >= 0.18um2
  (AREA LVTN < 0.18) NOT INSIDE NODRC
}
NVT1_A_2 {
@ NVT1 enclosed area >= 0.18um2
  (AREA ((HOLES LVTN INNER) NOT LVTN)< 0.18) NOT INSIDE NODRC
}

NVT1_R_1 {
@ It is not allowed NVT1 overlap with PSUB, P+ active AA(exclude pick-up AA),DG or TG 
  (AND LVTN PSUB) NOT INSIDE NODRC
  (AND LVTN (PACT NOT (NTAP OR PTAP))) NOT INSIDE NODRC
  (AND LVTN DG) NOT INSIDE NODRC
  (AND LVTN TG) NOT INSIDE NODRC
}


//============================================
//  PVT1:  low Vt PMOS design minima 
//============================================

GROUP GPVT1 PVT1_?

PVT1_W_1 {
@ PVT1 width >= 0.18um
  (INT LVTP < 0.18 ABUT<90 REGION) NOT INSIDE NODRC
}
PVT1_S_1 {
@ Space between two PVT1s >= 0.18um
  (EXT LVTP < 0.18 ABUT<90 OPPOSITE REGION) NOT INSIDE NODRC
}

PVT1_S_2 {
@ Space between PVT1 and GATE of along source/drain direction >= 0.18um
  X1 = PO INSIDE EDGE (PACT NOT LVTP)
  X2 = PO INSIDE EDGE (NACT NOT LVTP)
  X = X1 OR EDGE X2
  (EXT LVTP X < 0.18 ABUT<90 REGION OPPOSITE) NOT INSIDE NODRC
}

PVT1_S_3 {
@ Space between PVT1 and AA along poly length direction. >= 0.15um
  X1 = PACT TOUCH EDGE (AA INSIDE EDGE PO)
  X2 = NACT TOUCH EDGE (AA INSIDE EDGE PO)
  X = X1 OR EDGE X2
  (EXT X LVTP < 0.15 ABUT<90  REGION OPPOSITE) NOT INSIDE NODRC
}


PVT1_EX_1 {
@ PVT1 extension outside of GATE along source/drain direction >= 0.18um
  X = PO INSIDE EDGE (PACT AND LVTP)
  Y = EXPAND EDGE X OUTSIDE BY 0.18
  (Y NOT LVTP) NOT INSIDE NODRC
}

PVT1_EX_2 {
@ PVT1 extension outside of AA along GATE poly length direction. >= 0.15um
  X = (PACT AND LVTP) TOUCH EDGE GATE
  (ENC X LVTP < 0.15 ABUT<90 REGION OPPOSITE) NOT INSIDE NODRC
}


PVT1_A_1 {
@ PVT1 area >= 0.18um2
  (AREA LVTP < 0.18) NOT INSIDE NODRC
}
PVT1_A_2 {
@ PVT1 enclosed area >= 0.18um2
  (AREA ((HOLES LVTP INNER) NOT LVTP)< 0.18) NOT INSIDE NODRC
}

PVT1_R_1 {
@ PVT1 overlap with PSUB is not allowed
  (AND LVTP PSUB) NOT INSIDE NODRC
}


//===============================
// ULLD-- Ultra Low Leakage(ULLD)  
//===============================

GROUP GULLD ULLD_?

ULLD_W_1 {
@ ULLD width single-point-interaction is allowed. >= 0.18
  (INT ULLD <0.18 ABUT<90 REGION) NOT INSIDE NODRC 
}

ULLD_S_1 {
@ Space between two ULLDs >= 0.18um
  (EXT ULLD < 0.18 ABUT<90 REGION) NOT INSIDE NODRC
}

ULLD_S_2 {
@ Space between ULLD and AA >= 0.02um
  (EXT ULLD AA < 0.02 ABUT < 90 SINGULAR REGION) NOT INSIDE NODRC
}

ULLD_S_4 {
@ Space between ULLD and NACT >=0.055um.
  (EXT ULLD NACT < 0.055 ABUT < 90 SINGULAR REGION) NOT INSIDE NODRC
}

ULLD_S_5 {
@ Space between ULLD and GATE along source/drain direction >= 0.18 um.
  LAY_POLY = COPY POLYi
  AA = PACT OR NACT
  X1 = LAY_POLY INSIDE EDGE AA
  (EXT X1 ULLD < 0.18 ABUT < 90 OPPOSITE REGION) NOT INSIDE NODRC
}

ULLD_S_6 {
@ Space between ULLD and AA along GATE poly length direction is >= 0.15um.
  LAY_POLY = COPY POLYi
  AA = PACT OR NACT
  X1 = AA INSIDE EDGE LAY_POLY
  X2 = AA TOUCH EDGE X1
  (EXT X2 ULLD < 0.15 ABUT < 90 OPPOSITE REGION) NOT INSIDE NODRC
}

ULLD_EX_1 {
@ ULLD extention outside of AA is >= 0.02um
  (ENC AA ULLD < 0.02 ABUT < 90 SINGULAR REGION) NOT INSIDE NODRC
}

ULLD_EX_2 {
@ ULLD extention GATE along source/drain direction >= 0.18um.
  LAY_POLY = COPY POLYi
  AA = PACT OR NACT
  X1 = LAY_POLY INSIDE EDGE AA
  (ENC X1 ULLD < 0.18 ABUT < 90 OPPOSITE REGION) NOT INSIDE NODRC
}

ULLD_EX_3a {
@ ULLD extention outside of N+ AA along GATE poly length direction >= 0.15um.
@ if the distance to the related poly is less than or qual to 0.20um.
  LAY_POLY = COPY POLYi
  AA = PACT OR NACT
  X1 = AA INSIDE EDGE LAY_POLY
  X2 = AA TOUCH EDGE X1
  X3 = EXPAND EDGE X1 OUTSIDE BY 0.001 EXTEND BY 0.20
  X4 = X2 COIN EDGE X3
 (ENC X4 ULLD < 0.15 ABUT < 90 OPPOSITE REGION) NOT INSIDE NODRC
}

ULLD_EX_3b {
@ ULLD extention outside of N+ AA along GATE poly length direction >= 0.12um.
@ if the distance to the related poly is larger than 0.20um.
  LAY_POLY = COPY POLYi
  AA = PACT OR NACT
  X1 = AA INSIDE EDGE LAY_POLY
  X2 = AA TOUCH EDGE X1
  X3 = EXPAND EDGE X1 OUTSIDE BY 0.001 EXTEND BY 0.20
  X4 = X2 NOT COIN EDGE X3
  (ENC X4 ULLD < 0.12 ABUT < 90 OPPOSITE REGION) NOT INSIDE NODRC
}

ULLD_A_1 {
@ULLD area >= 0.18um2
(AREA ULLD < 0.18) NOT INSIDE NODRC 
}

ULLD_A_2 {
@ULLD area >= 0.18um2
(AREA (HOLES ULLD INNER) < 0.18) NOT INSIDE NODRC 
}

ULLD_R_1 {
@ It is not alloweded ULLD overlap with (PSUB, DG OR TG)
 (ULLD AND PSUB) NOT INSIDE NODRC 
 (ULLD AND DG) NOT INSIDE NODRC 
 (ULLD AND TG) NOT INSIDE NODRC 
}

ULLD_R_2 {
@ ULLD must interact NVT3 or PVT3
 (ULLD NOT INTERACT HVTN) NOT INSIDE NODRC 
 (ULLD NOT INTERACT HVTP) NOT INSIDE NODRC 
}

//============================
//   DG - Dual Gate DRC
//============================


GROUP DG DG_?

DG_W_1 {
@ DG width >= 0.47 um
  (INT DG < 0.47 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}

DG_S_1 {
@ Space between two DGs >= 0.47um
  (EXT DG < 0.47 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}

DG_S_2 {
@ Space between DG and MOS AA, overlap is not allowed  >= 0.25um
  (EXT DG MOS < 0.25 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
  (EXT DG AA_LDMOS < 0.25 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}

DG_S_3 {
@ Space between DG and GATE, overlap is not allowed >= 0.32um
  (EXT DG GATE < 0.32 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}

DG_S_4 {
@ Space between DG and NW >= 0.47um
  (EXT NW DG > 0 < 0.47 ABUT>0<90 SINGULAR REGION) NOT INSIDE NODRC
}

DG_S_5 {
@ Space between DG and PSUB >= 0.47um
  (EXT PSUB DG > 0 < 0.47 ABUT>0<90 SINGULAR REGION) NOT INSIDE NODRC
}

DG_EN_1 {
@ Enclosure of AA by DG(Except pick-up AA) >= 0.25um
  (ENC (AA NOT (NTAP OR PTAP)) DG < 0.25 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}

DG_EN_2 {
@ Enclosure of AA by DG along GATE poly direction >= 0.25um
  X = MOS TOUCH EDGE (GATE INSIDE DG)
  ENC X DG < 0.25 ABUT<90 REGION
}

DG_EN_3 {
@ Enclosure of GATE by DG, along source/drain direction >= 0.32um
  (ENC GATE_W DG < 0.32 ABUT<90  REGION OPPOSITE) NOT INSIDE NODRC
}

DG_EX_1 {
@ NW extention to DG, Extention = 0 is allowed >= 0.47um
  (ENC DG NW > 0 < 0.47 ABUT>0<90 SINGULAR REGION) NOT INSIDE NODRC
}

DG_EX_2 {
@ DG extention on NW, Extention = 0 is allowed  >= 0.47um
  (ENC NW DG > 0 < 0.47 ABUT>0<90 SINGULAR REGION) NOT INSIDE NODRC
}

DG_EX_3 {
@ DG extention on PSUB, Extention = 0 is allowed  >= 0.47um
  (ENC PSUB DG > 0 < 0.47 ABUT>0<90 SINGULAR REGION) NOT INSIDE NODRC
}

DG_O_1 {
@ Overlap of DG and NW, Overlap = 0 is allowed  >= 0.47um
  (INT DG NW > 0 < 0.47 ABUT>0<90 SINGULAR REGION) NOT INSIDE NODRC
}

DG_O_2 {
@ Overlap of DG and PSUB, Overlap = 0 is allowed >= 0.47um
  (INT DG PSUB > 0 < 0.47 ABUT>0<90 SINGULAR REGION) NOT INSIDE NODRC
}


//==========================
//   TG - Triple Gate DRC
//==========================

GROUP GTG TG_? 

TG_W_1 {
@ TG width >= 0.47um
  (INT TG < 0.47 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
TG_S_1 { 
@ Space between two TGs >= 0.47um
  (EXT TG < 0.47 ABUT<90 SINGULAR REGION ) NOT INSIDE NODRC
} 
TG_S_2 { 
@ Space between TG and MOS AA >= 0.25um.
  (EXT TG MOS < 0.25 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}

TG_S_3 {
@ Space between TG and GATE >= 0.32um
  (EXT GATE TG < 0.32 ABUT<90  REGION) NOT INSIDE NODRC 
}

TG_S_4 {
@ Space between TG and NW >= 0.47um
  (EXT NW TG > 0 < 0.47 ABUT>0<90 SINGULAR REGION) NOT INSIDE NODRC
}

TG_S_5 {
@ Space between TG and PSUB >= 0.47um
  (EXT TG PSUB < 0.47 ABUT<90 SINGULAR REGION ) NOT INSIDE NODRC
}

TG_S_6 {
@ Space between TG and DG >= 0.47um
  (EXT TG DG < 0.47 ABUT<90 SINGULAR REGION INSIDE ALSO ) NOT INSIDE NODRC
}

TG_EN_1 { 
@ Enclosure of AA by TG(except pickup AA) >= 0.25um 
  (ENC MOS TG < 0.25 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
} 

TG_EN_2 { 
@ Enclosure of GATE along GATE poly direction >= 0.25um
  X = MOS TOUCH EDGE (GATE INSIDE TG)
  (ENC X TG < 0.25 ABUT<90 REGION) NOT INSIDE NODRC
}
TG_EN_3 {
@ Enclosure of GATE by TG, along source/drain direction >= 0.32um
  (ENC GATE_W TG < 0.32 ABUT<90  REGION OPPOSITE ) NOT INSIDE NODRC 
}
TG_EX_1 {
@ NW extention on TG, Extention = 0 is allowed >= 0.47um
  (ENC TG NW > 0 < 0.47 ABUT>0<90 SINGULAR REGION) NOT INSIDE NODRC
}
TG_EX_2 {
@ TG extension on NW, Extention = 0 is allowed >= 0.47um
  (ENC NW TG > 0 < 0.47 ABUT>0<90 SINGULAR REGION) NOT INSIDE NODRC
}

TG_EX_3 {
@ TG extension of PSUB, Extention = 0 is allowed >= 0.47um
  (ENC PSUB TG > 0 < 0.47 ABUT>0<90 SINGULAR REGION) NOT INSIDE NODRC
}

TG_O_1 {
@ Overlap of TG and NW, overlap = 0 is allowed >= 0.47um
  (INT TG NW > 0 < 0.47 ABUT>0<90 SINGULAR REGION) NOT INSIDE NODRC
}

TG_O_2 {
@ Overlap of TG and PSUB, overlap = 0 is allowed >= 0.47um
  (INT TG PSUB > 0 < 0.47 ABUT>0<90 SINGULAR REGION) NOT INSIDE NODRC
}
		


GROUP GPO PO_?
PO_W_1 {
    @ PO width >=0.06 um
    (INT PO <0.06 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
PO_W_2a {
    @ Channel length for 0.9/1.2V NMOS/PMOS transistors >= 0.06um
    X = PO INSIDE EDGE (AA NOT (DG OR TG))
    (INT X < 0.06 ABUT<90 OPPOSITE REGION) NOT INSIDE NODRC
}
PO_W_2b {
    @ Channel length for 1.8V NMOS/PMOS transistors >= 0.20um
    X = PO INSIDE EDGE (AA AND DG )
    Y = INT X < 0.20 ABUT<90 OPPOSITE REGION
    (Y NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

#IFDEF IO 1825

PO_W_2c {
    @ Channel length for 2.5V NMOS/PMOS transistors >= 0.28um
    X = PO INSIDE EDGE ((AA AND TG) NOT INTERACT UD)
    Y = INT X < 0.28 ABUT<90 OPPOSITE REGION
    (Y NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

#ENDIF


#IFDEF IO 1833

PO_W_2d {
    @ Min Channel length for 3.3V NMOS transistors is 0.38
    @ Min Channel length for 3.3V PMOS transistors is 0.38
    X = (PO AND SDN) INSIDE EDGE (AA AND TG)
    Y = INT X < 0.38 ABUT<90 OPPOSITE REGION
    (Y NOT INSIDE SRAMALL) NOT INSIDE NODRC
    X1 = (PO AND SDP) INSIDE EDGE (AA AND TG)
    Y1 = INT X1 < 0.38 ABUT<90 OPPOSITE REGION
    (Y1 NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

#ENDIF


#IFDEF IO 1825

PO_W_2f {
    @ Channel length for 2.5V NMOS/PMOS transistors (over drive to 3.3V and 4.1V) >= 0.50(NMOS)um
    @ >= 0.40(PMOS)um
    X = PO INSIDE EDGE ((NACT AND TG) AND OD)
    Y = PO INSIDE EDGE ((PACT AND TG) AND OD)
    Z1 = INT X < 0.50 ABUT<90 OPPOSITE REGION
    Z2 = INT Y < 0.40 ABUT<90 OPPOSITE REGION
    (Z1 NOT INSIDE SRAMALL) NOT INSIDE NODRC
    (Z2 NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
PO_W_2e {
    @ Channel length for 2.5V NMOS/PMOS transistors (under drive to 1.8V) >= 0.22um
    X = PO INSIDE EDGE ((AA AND TG) AND UD)
    Y = INT X < 0.22 ABUT<90 OPPOSITE REGION
    (Y NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

#ENDIF

PO_W_3 {
    @ Width of 45 degree PO >= 0.18um
    PO_CHECK = PO NOT INSIDE (AA OR AADUM)
    X = ANGLE PO_CHECK == 45
    (INT X < 0.18 ABUT<90 REGION) NOT INSIDE NODRC
}
PO_S_1 {
    @ Space between two POs
    @ DRC waive check the INDALL covered region. >= 0.12um
    X = EXT PO < 0.12 ABUT<90 SINGULAR REGION
    (X NOT INSIDE (SRAMALL OR INDALL)) NOT INSIDE NODRC
}
PO_S_2 {
    @ Space between two POs when one or both PO width is > 0.13um, and the run length of two POs is > 0.18um. >= 0.18um
    PO_W = WITH WIDTH PO > 0.13
    PO_S = EXT PO_W PO < 0.18 OPPOSITE REGION PARA ONLY
    PO_LS = LENGTH PO_S > 0.18
    (PO_S WITH EDGE PO_LS) NOT INSIDE EDGE NODRC
}
PO_S_3 {
    @ Space between two POs on AA
    @ DRC waive check the INDALL covered region. >= 0.13um
    X = (AA AND PO) COIN EDGE PO
    Y = EXT X < 0.13 ABUT < 90 REGION
    (Y NOT INSIDE INDALL) NOT INSIDE NODRC
}
LAYER MAP 999 DATATYPE 1111 4321
LAYER EMPTY 4321
PO_EMPTY = EMPTY OR (PO AND AA)
AA_EMPTY = EMPTY OR AA
CONNECT PO_EMPTY AA_EMPTY

#IFDEF OPEN_RECOMMENDED_ON YES

PO_S_4_R {
    @ Recommended Space between POs on the same AA
    @ DRC waive check if no contacts between two POs, and waive check the INDALL covered region. >= 0.2um
    X = EXT PO_EMPTY < 0.2 ABUT<90 SINGULAR REGION CONNECTED
    Y = X INTERACT CT
    (Y NOT INSIDE (INDALL OR SRAMALL) ) NOT INSIDE NODRC
}

#ENDIF

PO_S_5 {
    @ Space between POs on the same AA inside TG
    @ DRC waive check if no contacts between two POs, and waive check the INDALL covered region. >= 0.24um
    X = EXT (PO_EMPTY AND TG) < 0.24 ABUT<90 SINGULAR REGION CONNECTED
    Y = X INTERACT CT
    (Y NOT INSIDE (INDALL OR SRAMALL)) NOT INSIDE NODRC
}
PO_S_6 {
    @ Space to 45-degree PO, except EFUSEALL and FUSEALL region. >= 0.18um
    PO_CHECK = PO NOT INSIDE (OR EFUSEALL AA AADUM)
    X = (ANGLE PO_CHECK == 45) NOT INSIDE EDGE EFUSEALL
    (((EXT X (PO NOT INSIDE EFUSEALL) < 0.18 ABUT<90 REGION) NOT INSIDE EFUSEALL) NOT INSIDE FUSEALL) NOT INSIDE NODRC
}
PO_S_7 {
    @ GATE space when L-shape AA and L-shape PO enclosed area is < 0.012um2 >= 0.15um
    X = AA_LS OR PO_LS
    Y = AREA (HOLES X INNER) < 0.012
    Z = GATE INTERACT Y SINGULAR ONLY
    ((EXT Z < 0.15 ABUT<90 REGION) INTERACT Y) NOT INSIDE NODRC
}

#IFDEF OPEN_RECOMMENDED_ON YES

PO_S_7a_R {
    @ Recommended GATE space when L-shape AA and L-shape PO enclosed area is < 0.0196um2 >= 0.2um
    X = AA_LS OR PO_LS
    Y = AREA (HOLES X INNER) < 0.0196
    Z = GATE INTERACT Y SINGULAR ONLY
    ((EXT Z < 0.2 ABUT<90 REGION) INTERACT Y) NOT INSIDE NODRC
}
PO_S_8_R {
    @ Recommended space of GATE (channel length <= 0.08um) to neighboring poly for thr CDU control <= 1.0
    X = LENGTH GATE_L <= 0.08
    Y = (GATE INTERACT (EXPAND EDGE X OUTSIDE BY 0.001)) NOT INSIDE SRAMALL
    Z = Y INSIDE EDGE AA
    A = EXPAND EDGE Z OUTSIDE BY 1.0
    (A NOT INTERACT PO > 1) NOT INSIDE NODRC
}

#ENDIF

PO_S_9 {
    @ Space at PO line end(PO width <0.09um), in the dense line end configuration:
    @ if PO has parallel run length with opposite PO
    @ along 2 adjacent edge of PO(any one edge < 0.09um distance from the conner of
    @ the 2 edges), then one of the space need to bigger than 0.14
    LINE_END = CONVEX EDGE PO ANGLE1 == 90 ANGLE2 == 90 WITH LENGTH < 0.09
    LINE_END_SP = EXT [LINE_END] PO < 0.14 ABUT<90 OPPOSITE
    LINE_SIDE = LINE_END TOUCH INSIDE EDGE LINE_END_SP
    LINE_END_PO = INT LINE_SIDE [PO] < 0.09 ABUT == 90 INTERSECTING ONLY
    LINE_END_PO_006 = LENGTH LINE_END_PO >= 0.06
    ((EXT LINE_END_PO_006 PO < 0.14 ABUT<90 OPPOSITE REGION) NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
PO_S_11 {
    @ Space between AA and PO on STI >= 0.05um
    X = EXT AA PO < 0.05 ABUT<90 SINGULAR REGION
    ((X NOT INSIDE (AA OR AADUM)) NOT INSIDE (SRAMALL OR INDALL)) NOT INSIDE NODRC
}
PO_S_12 {
    @ Minimum space of PO within SAB >=0.25
    PO_SAB = PO NOT OUTSIDE SAB
    (EXT PO_SAB < 0.25 ABUT < 90 OPPOSITE REGION ) NOT INSIDE NODRC
}
AAconer = EXT AA <0.01 ABUT == 90 INTERSECTING ONLY REGION
POconer = EXT PO < 0.01 ABUT == 90 INTERSECTING ONLY REGION

#IFDEF OPEN_RECOMMENDED_ON YES

PO_S_13_R {
    @ Strongly suggest the minimum space of GATE to neighboring poly for sensitive circuit with minimum PO width = 0.06um, >=0.19
    X = WITH WIDTH GATE == 0.06
    (EXT X PO < 0.19 ABUT < 90 OPPOSITE REGION) NOT INSIDE NODRC
}

#ENDIF

PO_S_14 {
    @ Min space between L-shape AA to PO in the same MOS when channel width <0.15um is 0.1.
    A = EXT AA_CP PO_CP < 0.1 OPPOSITE REGION CONNECTED
    (((A INTERACT AAcorner) INTERACT GATE_WIDTH_D15) NOT INSIDE EDGE SRAMALL) NOT INSIDE EDGE NODRC
}

#IFDEF OPEN_RECOMMENDED_ON YES

PO_S_14a_R {
    @ Min space between L-shape AA to PO in the same MOS when channel width >= 0.15um is 0.1.
    A = EXT AA_CP PO_CP < 0.1 OPPOSITE REGION CONNECTED
    (((A INTERACT AAcorner) INTERACT GATE_WIDTH_U15) NOT INSIDE EDGE SRAMALL) NOT INSIDE EDGE NODRC
}

#ENDIF

PO_S_15 {
    @ Min space between L-shape PO to AA in the same MOSwhen channel width < 0.15um is 0.1.
    A = EXT PO015 AAintPO015 < 0.1 OPPOSITE REGION CONNECTED
    (((A INTERACT POcorner) INTERACT GATE_WIDTH_D15) NOT INSIDE EDGE SRAMALL) NOT INSIDE EDGE NODRC
}
PO_S_16 {
    @ Space between large PO and GATE with narrow channel length <= 0.08um
    @ The large PO definition:
    @ PO area >= 630um2 and within regions of density > 70% in window 30um x 30um, stepping 15um. Dummy poly isnBFt included in the density check. >= 1.00um
    Density_region = DENSITY POLYi > 0.7 WINDOW 30 STEP 15
    Large_PO = (AREA POLYi >= 630) INSIDE Density_region
    GATE_check = GATE WITH EDGE (LENGTH GATE_LE <= 0.08)
    GATE_LE = (GATE TOUCH EDGE (INT GATE_W [GATE] < 0.005 ABUT INTERSECTING ONLY)) NOT COIN EDGE GATE_W
    EXT Large_PO GATE_check < 1 ABUT<90 SINGULAR REGION
}

#IFDEF OPEN_RECOMMENDED_ON YES

PO_S_18_R {
    @ Recommended core nmos gate space to (TG OR (NW OR PSUB), >=1.0
    CHECK_GATE = GATE_core AND SDN
    CHECK_WELL = OR TG NW PSUB
    ((EXT CHECK_GATE CHECK_WELL < 1.0 ABUT<90 REGION OPPOSITE) NOT INTERACT SRAMALL) NOT INSIDE NODRC
}

#ENDIF


#IFDEF OPEN_RECOMMENDED_ON YES

PO_EN_1_R {
    @ Recommended core pmos gate enclose by (NW NOT TG), >=1.0
    CHECK_GATE = (GATE_core AND SDP) NOT TG
    CHECK_WELL = NW NOT TG
    ((ENC CHECK_GATE CHECK_WELL < 1.0 ABUT<90 REGION OPPOSITE) NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
PO_EN_2_R {
    @ Recommended IO nmos gate enclose by (TG NOT (NW OR PSUB)), >=2.0
    CHECK_GATE = (GATE AND SDN) AND TG
    CHECK_WELL = TG NOT NW
    (ENC CHECK_GATE CHECK_WELL < 2.0 ABUT<90 REGION OPPOSITE) NOT INSIDE NODRC
}
PO_EN_3_R {
    @ Recommended IO pmos gate enclose by (TG AND NW), >=2.0
    CHECK_GATE = (GATE AND SDP) AND TG
    CHECK_WELL = TG AND NW
    (ENC CHECK_GATE CHECK_WELL < 2.0 ABUT<90 REGION OPPOSITE) NOT INSIDE NODRC
}

#ENDIF

PO_EX_1 {
    @ Extension of AA outside of PO >= 0.11um
    X = ENC PO (AA NOT COIN EDGE LDMOSSTI) < 0.11 ABUT<90 REGION OPPOSITE
    ((X NOT INSIDE SRAMALL) NOT INSIDE INDALL) NOT INSIDE NODRC
}

#IFDEF OPEN_RECOMMENDED_ON YES

PO_EX_1_R {
    @ Recommended Extension of AA outside of PO(when channel width >1 um) >= 0.18um
    X = LENGTH (GATE INSIDE EDGE AA) >= 1.0
    Y = PO WITH EDGE X
    Z = ENC Y (AA NOT TOUCH LDMOSSTI) < 0.18 ABUT<90 REGION OPPOSITE
    ((Z NOT INSIDE SRAMALL) NOT INSIDE INDALL) NOT INSIDE NODRC
}

#ENDIF

PO_EX_2 {
    @ Extension of GATE poly outside of AA >= 0.14um
    Y = ENC AA PO < 0.14 ABUT<90 opposite REGION
    Z = EXT PO < 0.002 ABUT==90 REGION INTERSECTING ONLY
    (((Y NOT TOUCH Z) NOT INSIDE SRAMALL) NOT INSIDE LDMOS) NOT INSIDE NODRC
}

#IFDEF OPEN_RECOMMENDED_ON YES

PO_EX_3_R {
    @ PO end-cap extension of AA when:
    @ 1. PO space to L-shape AA in the same MOS is < 0.14um
    @ 2. GATE channel width (W) is >= 0.15um
    @ DRC only check the L-shape opposite side PO end-cap. >= 0.16um
    A = ENC AA PO < 0.16 OPPOSITE REGION
    X = LENGTH GATE_W >= 0.15
    Y = GATE WITH EDGE X
    B = EXT Y AA < 0.14 ABUT==90 PERP ONLY REGION
    ((A WITH EDGE (A TOUCH EDGE B)) NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

#ENDIF

PO_L_1 {
    @ PO length between two CTs without GATE, and the length from any point inside GATE to nearest CT, when the PO width is < 0.13um
    @ This rule is for voltage drop concern. DRC waive check ESDIOE covered region. <= 25.00um
    PO_CHECK = ((WITH WIDTH PO < 0.13) NOT GATE) INTERACT CT
    Z0 = SIZE CT BY 12.5 INSIDE OF PO_CHECK STEP 0.02
    ((PO_CHECK INTERACT Z0 > 1) NOT INSIDE ESDIOE) NOT INSIDE NODRC
    PO_CHECK1 = (PO INTERACT CT) NOT GATE
    Z4 = ((INT PO_CHECK1 < 0.13 OPPOSITE REGION) NOT GATE) NOT INTERACT CT
    Z6 = LENGTH Z4 >25
    (Z6 NOT INSIDE EDGE ESDIOE) NOT INSIDE EDGE NODRC
    X = GATE WITH EDGE (LENGTH GATE_L < 0.13)
    Y = (PO INTERACT X) INTERACT CT
    Z = SIZE CT BY 25 INSIDE OF Y STEP 0.02
    (((GATE INTERACT Y) NOT INSIDE Z) NOT INSIDE ESDIOE) NOT INSIDE NODRC
}

#IFDEF OPEN_RECOMMENDED_ON YES

PO_L_2_R {
    @ Recommanded maximum L shape length of L-shape AA which space to PO (in the same MOS with width >= 0.15um) <= 0.1 is <=0.21
    PO_CHECK = EXPAND EDGE (LENGTH GATE_W >= 0.15) INSIDE BY 0.001
    POmergeAA = (PO OR AA) INTERACT PO_CHECK
    L_edge = CONVEX EDGE POmergeAA ANGLE1 == 90 ANGLE2 == 270
    L_edge_ = EXPAND EDGE L_edge INSIDE BY 0.001
    LAA_ = L_edge_ TOUCH AAconer == 1
    LAA = L_edge COIN EDGE LAA_
    X = LENGTH LAA > 0.21
    Y = EXT X PO < 0.1 REGION
    (X COIN EDGE Y) NOT INSIDE EDGE NODRC
}

#ENDIF


#IFDEF Density_rules YES

PO_D_1_min {
    @ Global PO density for fully chip (including dummy) >= 14%
    (DENSITY PO_all < 0.14 PRINT density_report_PO_D_1_min.log) NOT INSIDE NODRC
}
PO_D_1_max {
    @ Global PO density for fully chip (including dummy) <= 40%
    (DENSITY PO_all > 0.40 PRINT density_report_PO_D_1_max.log) NOT INSIDE NODRC
}
PO_D_2_min {
    @ Local PO density (including dummy) in 100um*100um window with step size: 50um >= 20%
    (DENSITY PO_all < 0.2 WINDOW 100 STEP 50 BACKUP PRINT density_report_PO_D_2_min.log) NOT INSIDE NODRC
}
PO_D_2_max {
    @ Local PO density (including dummy) in 100um*100um window with step size: 50um <= 65%
    (DENSITY PO_all > 0.65 WINDOW 100 STEP 50 BACKUP PRINT density_report_PO_D_2_max.log) NOT INSIDE NODRC
}
PO_D_3 {
    @ The poly density difference between any two neighboring checking windows <= 20%
    (DENSITY PO_all >= 0 WINDOW 100 GRADIENT > 0.2 ABSOLUTE BACKUP INSIDE OF LAYER BULK PRINT density_report_PO_D_3.log) NOT INSIDE NODRC
}

#ENDIF

PO_A_1 {
    @ PO area >= 0.04um2
    ((AREA PO < 0.04) NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

#IFDEF OPEN_RECOMMENDED_ON YES

PO_A_1_R {
    @ PO area when PO is not GATE poly. >= 0.05um2
    ((AREA (PO NOT INTERACT GATE) < 0.05) NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

#ENDIF

PO_A_2 {
    @ PO enclosed area >= 0.09um2
    (AREA ((HOLES PO INNER) NOT PO) < 0.09) NOT INSIDE NODRC
}
PO_R_1 {
    @ No bent PO on AA is allowed.All PO patterns on AA have to be orthogonal to AA edage.
    @ DRC waive check the INDALL and SRAMALL covered region, and waive check (AA AND PO) width <= 0.01um pattern.
    POEIAA1 = (PO AND AA) WITH WIDTH > 0.01
    ((POEIAA1 CONVEX EDGE < 2) NOT INSIDE EDGE (INDALL OR SRAMALL)) NOT INSIDE EDGE NODRC
}
PO_R_2 {
    @ PO must be enclosed by NP and/or PP.
    HRPR = PO INTERACT HPR
    HRP_END = SIZE (HRPR NOT HPR) BY 0.3
    PO_MID = ( PO INTERACT (HPR OR HRP)) NOT HRP_END
    Y = ((((PO INTERACT CT) NOT PO_MID) NOT SDP) NOT SDN) NOT INTERACT MOMLVS1
    (Y NOT INSIDE SRAMALL) NOT INSIDE NODRC
}


DMACRO NPLH_68 LAY_IMP LAY_AA ENC_SD ENC_PO ENC_EXTENSION {
 X = PO INSIDE EDGE LAY_AA
 A = EXPAND EDGE X INSIDE BY ENC_EXTENSION OUTSIDE BY ENC_EXTENSION CORNER FILL
 Y = (PO AND LAY_AA) COIN EDGE LAY_AA
 B = EXPAND EDGE Y OUTSIDE BY ENC_PO EXTEND BY ENC_EXTENSION
 C = A OR B
 (ENC LAY_AA (LAY_IMP INSIDE EDGE C) < ENC_PO ABUT<90 REGION OPPOSITE) NOT INSIDE NODRC
 (ENC X LAY_IMP < ENC_SD ABUT<90 REGION OPPOSITE) NOT INSIDE NODRC
}
DMACRO SNP_68 LAY_IMP LAY_AA ENC_SD ENC_PO ENC_EXTENSION {
 X = PO INSIDE EDGE LAY_AA
 A = EXPAND EDGE X INSIDE BY ENC_EXTENSION OUTSIDE BY ENC_EXTENSION CORNER FILL
 Y = (PO AND LAY_AA) COIN EDGE LAY_AA
 B = EXPAND EDGE Y OUTSIDE BY ENC_PO EXTEND BY ENC_EXTENSION
 C = A OR B
 D = ENC LAY_AA (LAY_IMP INSIDE EDGE C) < ENC_PO ABUT<90 REGION OPPOSITE
 (D NOT INSIDE SRAMALL) NOT INSIDE NODRC
 E = ENC X LAY_IMP < ENC_SD ABUT<90 REGION OPPOSITE
 (E NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

//=================================
//  NP - N+ S/D Implantation DRC
//=================================

GROUP GNP NP_?

NP_W_1 {
@ NP width. Single-point-interaction is allowed. >= 0.18um
  (INT SDN < 0.18 ABUT<90 REGION) NOT INSIDE NODRC
}

NP_S_1 {
@ Space between two NPs. >= 0.18um
  (EXT SDN < 0.18 ABUT<90 OPPOSITE REGION) NOT INSIDE NODRC
}

NP_S_2 {
@ Space between NP and P+ AA inside NW >= 0.12um
  X = (PACT NOT PTAP) NOT TOUCH EDGE SDN
  Y = EXT SDN X < 0.12 ABUT<90 REGION
  (Y NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

NP_S_3 {
@ Space between NP and P+ pick-up AA inside PW >= 0.02um
  X = PTAP NOT TOUCH EDGE NACT
  Y = X NOT TOUCH EDGE SDN
  (EXT SDN Y < 0.02 ABUT<90 REGION) NOT INSIDE NODRC
}

NP_S_4 {
@ Space between NP and butted P+AA (except SRAM area). = 0.00um
  X = SDN AND PACT
  (X NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

NP_S_5 {
@ Space between NP and PMOS GATE >= 0.3um
  X = GATE_W INSIDE EDGE SDP
  Y = EXT X SDN < 0.3 ABUT<90 OPPOSITE  REGION
  (Y NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

NP_S_6 {
@ Butted P+ pick-up AA space to PO in the same AA (the butted N+AA extending <0.16um) is 0.3
  NACTL = NACT TOUCH INSIDE EDGE NGATE
  NACTL_EP = EXPAND EDGE NACTL OUTSIDE BY 0.16 EXTEND BY 0.01
  BUTNA_ED = PACT COIN EDGE (NACT NOT NTAP)
  BUTNA_ED_1 = BUTNA_ED INSIDE EDGE NACTL_EP
  BUTSDN_1 = (PACT INTERACT PW) WITH EDGE BUTNA_ED_1
  
  POSDN_1 = (PO INSIDE EDGE ((NACT NOT NTAP) TOUCH PACT)) COIN EDGE NGATE
  POSDN   = (PO WITH EDGE POSDN_1) TOUCH EDGE NGATE  
  (EXT BUTSDN_1 POSDN < 0.30 ABUT<90 REGION) NOT INSIDE NODRC
}

NP_EN_1 {
@ AA enclosure by NP, except the SRAMALL region. >= 0.02um
  X = ((AA NOT SDNNR) NOT COIN EDGE PACT) NOT COIN EDGE SDP
  ((ENC X SDN < 0.02 ABUT<90 REGION) NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

NP_EN_2 {
@ N+AA enclosure by NP, except the SRAMALL region. >= 0.12um
  X = (((NACT NOT INTERACT NWR) NOT COIN EDGE PACT) NOT COIN EDGE SDP) INSIDE EDGE PW
  ((ENC X (SDN AND PW) < 0.12 ABUT<90 REGION) NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

NP_EN_3 {
@Minimum NP Enclosure PO >= 0.15um
 PO_inter = POLYi NOT (OR AA POLYres HPR) 
 PO_CUT = (PO_inter INTERACT SDN) INTERACT SDP
 ((ENC (PO_inter NOT PO_CUT) SDN < 0.15 ABUT<90 REGION) NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

NP_EX_1_EX_1a {
@ NP extension outside of NMOS GATE poly when NP edge is on AA . >= 0.3um
@ NP extension outside of GATE >= 0.16um
  SDN_S = SDN NOT INSIDE SRAMALL
  NACT_S = NACT NOT INSIDE SRAMALL
  CMACRO SNP_68 SDN_S NACT_S 0.3 0.16 0.2
}


NP_O_1 {
@ Overlap of NP and AA >= 0.12um
  (INT SDN AA < 0.12 ABUT >0 <90 SINGULAR REGION) NOT INSIDE NODRC
}
NP_A_1 {
@ NP area >= 0.12um2
  ((AREA SDN < 0.12) NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
NP_A_2 {
@ NP enclosed area >= 0.12um2
  (AREA ((HOLES SDN INNER) NOT SDN) < 0.12 ) NOT INSIDE NODRC
}
NP_A_3 {
@ Minimum area of butted NW TAP >= 0.04um2
  (AREA (NTAP TOUCH (PACT NOT PTAP))< 0.04 ) NOT INSIDE NODRC
}

//=======================================
//  PP - P+ S/D implantation DRC
//=======================================

GROUP GPP PP_?

PP_W_1 {
@ PP width. Single-point-interaction is allowed. >= 0.18um
  (INT SDP < 0.18 ABUT<90 REGION) NOT INSIDE NODRC
}

PP_S_1 {
@ Space between two PPs. >= 0.18um
  (EXT SDP < 0.18 ABUT<90 OPPOSITE REGION) NOT INSIDE NODRC
}

PP_S_2 {
@ Space between PP and N+ AA >= 0.12um
  X = (NACT NOT NTAP) NOT TOUCH EDGE SDP
  Y = EXT SDP X < 0.12 ABUT<90 REGION
  (Y NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
PP_S_3 {
@ Space between PP and N+ AA inside Nwell >= 0.02um
  X = NTAP NOT TOUCH EDGE PACT
  Y = X NOT TOUCH EDGE SDP
  (EXT SDP Y < 0.02 ABUT<90 REGION) NOT INSIDE NODRC
}
PP_S_4 {
@ Space between PP and butted N+AA (except SRAM area). = 0.00um
  X = SDP AND NACT
  (X NOT INSIDE SRAMALL) NOT INSIDE NODRC
} 

PP_S_5 {
@ Space between PP and NMOS GATE. >= 0.30um
  X = PO INSIDE EDGE NACT
  Y = EXT SDP X < 0.30 ABUT<90 REGION OPPOSITE
  (Y NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

PP_S_6 {
@ Space between utted N+ pick-up AA and PO in the same AA (the butted P+AA extending < 0.16um) >= 0.30um
  PACTL = PACT TOUCH INSIDE EDGE PGATE
  PACTL_EP = EXPAND EDGE PACTL OUTSIDE BY 0.16 EXTEND BY 0.01
  BUTNA_ED = NACT COIN EDGE (PACT NOT PTAP)
  BUTNA_ED_1 = BUTNA_ED INSIDE EDGE PACTL_EP
  BUTSDN_1 = (NACT INTERACT NW) WITH EDGE BUTNA_ED_1
  POSDP_1 = (PO INSIDE EDGE (PACT  TOUCH NACT)) COIN EDGE PGATE
  POSDP   = (PO WITH EDGE POSDP_1) TOUCH EDGE PGATE  
  (EXT BUTSDN_1 POSDP < 0.30 ABUT<90 REGION) NOT INSIDE NODRC
}


PP_EN_1 {
@ Enclosure of P+ AA in PW, except the SRAMALL region >= 0.02um
  X = ((PTAP NOT INTERACT NWR) NOT COIN EDGE NACT) NOT COIN EDGE SDN
  ((ENC X SDP < 0.02 ABUT<90 REGION) NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
PP_EN_2 {
@ Enclosure of P+ AA NW, except the SRAMALL region. >= 0.12um
  X = (((PACT NOT INTERACT NWR) NOT COIN EDGE NACT) NOT COIN EDGE SDN) INSIDE EDGE NW
  ((ENC X (SDP AND NW) < 0.12 ABUT<90 REGION) NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

PP_EN_3 {
@Minimum PP Enclosure of POLY >=0.15um
 PO_inter = POLYi NOT (OR AA POLYres HPR) 
 PO_CUT = (PO_inter INTERACT SDP) INTERACT SDN
 ((ENC (PO_inter NOT PO_CUT) SDP < 0.15 ABUT<90 REGION) NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

PP_EX_1_EX_1a {
@ PP extension outside of PMOS GATE along source/drain direction. >= 0.16um
@ PP extension of PMOS gate poly when PP edge on AA. >= 0.3um
 SDP_S = SDP NOT INSIDE SRAMALL
 PACT_S = PACT NOT INSIDE SRAMALL
 CMACRO SNP_68 SDP_S PACT_S 0.3 0.16 0.2
}

PP_O_1 {
@ Overlap of PP and AA >= 0.12um
  (INT SDP (AA NOT TOUCH EDGE SDP) < 0.12 ABUT<90 REGION) NOT INSIDE NODRC
}
PP_A_1 {
@ PP area >= 0.12um2
  ((AREA SDP < 0.120) NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
PP_A_2 {
@ PP enclosed area >= 0.12um2
  (AREA ((HOLES SDP INNER) NOT SDP) < 0.12) NOT INSIDE NODRC
}
PP_A_3 {
@ Minimum area of butted PW TAP >= 0.04um2
  (AREA (PTAP TOUCH (NACT NOT NTAP))< 0.04 ) NOT INSIDE NODRC
}

PP_R_1 {
@ PP overlap with NP is not allowed
  (AND SDN SDP) NOT INSIDE NODRC
}

PP_R_3 {
@ It is not allowed NP butted PP on unsilicided AA/POLY
 A = SDN COIN EDGE SDP
 A INSIDE EDGE ((AA OR PO) AND SAB)
}

//=================================
//  SAB - Salicide Block DRC
//=================================

GROUP GSAB SAB_?

SAB_W_1 {
@ SAB width >= 0.42um
  (INT SAB < 0.42 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
SAB_S_1 {
@ Space between two SABs >= 0.42um
  (EXT SAB < 0.42 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
SAB_S_2 {
@ Space between two SABs when one or both SABs interact with PO. DRC waive if no (PO OR AA) exists in the space region. >= 0.44um
  ((EXT (SAB INTERACT PO) SAB < 0.44 ABUT<90 SINGULAR REGION) INTERACT (PO OR AA)) NOT INSIDE NODRC
}
SAB_S_3 {
@ Space between SAB and AA >= 0.21um
  (EXT SAB AA < 0.21 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
SAB_S_4 {
@ Space between SAB and GATE
@ SAB overlap with GATE is forbidden, DRC waive ESDIOE regions and waive the total SAB which overlaps GATE 60nm. >= 0.36um
  (EXT SAB GATE < 0.36 ABUT<90 REGION) NOT INSIDE NODRC
  ESD_REGION = INT GATE_W SAB == 0.06 OPPOSITE REGION 
  (((SAB NOT INTERACT ESD_REGION) AND GATE) NOT INSIDE ESDIOE ) NOT INSIDE NODRC 
}
SAB_S_5 {
@ Space between SAB and poly on field oxide. >= 0.3um
  PO_CHECK = PO NOT (AA OR AADUM)
  ((EXT SAB PO_CHECK < 0.3 ABUT<90 SINGULAR REGION) NOT INSIDE ESDIOE) NOT INSIDE NODRC
}
SAB_S_6 {
@ Space between SAB and CT >= 0.21um
  (EXT SAB CT < 0.21 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
SAB_EX_1 {
@ AA extension outside of SAB >= 0.21um
  (ENC SAB AA < 0.21 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
SAB_EX_2 {
@ Extension of SAB outside of AA >= 0.21um
  (ENC AA SAB < 0.21 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
SAB_EX_3 {
@ Extension of SAB outside of poly on field oxide >= 0.21um
  (ENC (PO NOT (AA OR AADUM)) SAB < 0.21 ABUT<90 REGION) NOT INSIDE NODRC
}

#IFDEF OPEN_RECOMMENDED_ON YES

 SAB_EX_4_R {
@ Extension on unsilicided AA/POLY when SAB width is > 10um
@ DRC waive if > 5 poly fingers interact with the SAB. >= 0.30um
   SAB_CHECK = (SAB WITH WIDTH > 10) NOT INTERACT (PO AND SAB) > 5
  (ENC ((AA OR PO) INTERACT SAB) SAB_CHECK < 0.3 ABUT < 90 REGION) NOT INSIDE NODRC
}
#ENDIF
SAB_A_1 {
@ SAB area >= 0.8um2
  (AREA SAB < 0.8) NOT INSIDE NODRC
}
SAB_A_2 {
@ SAB enclosed area >= 0.8um2
  (AREA ((HOLES SAB INNER) NOT SAB)< 0.8) NOT INSIDE NODRC
}


SAB_R_1 {
@ SAB butted  AA/POLY is not allowed
  (SAB COIN EDGE PO) NOT INSIDE EDGE NODRC
  (SAB COIN EDGE AA) NOT INSIDE EDGE NODRC
}
SAB_R_2 {
@ SAB overlap GATE is not allowed except ESD MOS
  ((SAB AND GATE) NOT INSIDE ESDIOE ) NOT INSIDE EDGE NODRC
}

//========================
//  CT - Contact DRC
//========================

GROUP GCT CT_?

CTN = CT AND (RECTANGLE CT ASPECT == 1)

CT_W_1 {
@ Fixed CT width (square shape) exclude SRAMALL(177;4) FUSEALL, and GRID
@ DRC waive rectangular CT in SRAM and EFUSEALL area, and waive protection ring purpose non-rectangular CT in GRID area =0.09um
  X = NOT RECTANGLE ((CT NOT RCT) NOT GCT) == 0.09 BY == 0.09
  (X NOT INSIDE ((GRID OR SRAMALL) OR EFUSEALL)) NOT INSIDE (SRINGBLK OR NODRC)
  (NOT RECTANGLE (RECTANGLE (CT AND GRID)) == 0.09 BY == 0.09) NOT INSIDE (SRINGBLK OR NODRC)
  (NOT RECTANGLE (RECTANGLE (CT AND EFUSEALL) ASPECT == 1) == 0.09 BY == 0.09) NOT INSIDE (SRINGBLK OR NODRC)
  (NOT RECTANGLE (RECTANGLE (CT AND SRAMALL) ASPECT == 1) == 0.09 BY == 0.09) NOT INSIDE (SRINGBLK OR NODRC)
 
}
CT_W_2 {
@ Fixed CT bar width, except rectangular CT in SRAMALL (177;4) FUSEALL region = 0.09um
   (WITH WIDTH CTbar < 0.09) NOT INSIDE (OR SRAMALL EFUSEALL)
   (WITH WIDTH CTbar > 0.09) NOT INSIDE (OR SRAMALL EFUSEALL)
}


CT_S_1 {
@ Space between two contacts >= 0.11um
  X = EXT CT < 0.11 ABUT<90 SINGULAR REGION
  (X NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
CT_S_1a {
@ Space between CT and 3-neighboring CTs (space is <= 0.15um)  >= 0.14um
  X = SIZE CT BY 0.075 OVERUNDER
  Y = SIZE X BY 0.240 UNDEROVER
  Z = CT INSIDE Y
  (EXT Z < 0.14 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
  
CT_S_2 {
@ CT space at different nets, except SRAMALL region. >= 0.12um
 (EXT CT < 0.12 SINGULAR REGION NOT CONNECTED) NOT INSIDE (SRAMALL OR NODRC)

}
CT_S_3 {
@ Space between AA and contact on POLY >= 0.065um
  (EXT (CT AND PO) AA < 0.065 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
CT_S_4 {
@ Space between POLY and contact on AA for 0.9V/1.2V >= 0.055um
  X = EXT (PO INTERACT GATE_core) AA_CT < 0.055 ABUT<90 SINGULAR REGION 
  (X NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
#IFDEF OPEN_RECOMMENDED_ON YES

CT_S_4_R {
@ Recomended Space between POLY and contact on AA for 0.9V/1.2V >= 0.06 um
  X = EXT (PO INTERACT GATE_core) AA_CT < 0.06 ABUT<90 SINGULAR REGION 
  (X NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
#ENDIF

CT_S_5 {
@ Space between GATE and contact on AA for 1.8/2.5/3.3V >= 0.09um
  X1 = EXT GATE_io1 (AA_CT AND DG) < 0.09 ABUT<90 SINGULAR REGION
  X2 = EXT GATE_io2 (AA_CT AND TG) < 0.09 ABUT<90 SINGULAR REGION
  (X1 OR X2) NOT INSIDE NODRC
}

 CT_S_6 {
@ Space to butted SDN/SDP edge on AA (overlap of NP/PP boundary on AA is not allowed) >= 0.06um
   X = (SDN COIN EDGE SDP) NOT OUTSIDE EDGE AA
   Y = (SDP COIN EDGE SDN) NOT OUTSIDE EDGE AA
   (X INSIDE EDGE CT) NOT INSIDE EDGE NODRC
   (Y INSIDE EDGE CT) NOT INSIDE EDGE NODRC
   (ENC CT X < 0.06 ABUT<90 REGION ) NOT INSIDE NODRC
   (ENC CT Y < 0.06 ABUT<90 REGION ) NOT INSIDE NODRC
}

CT_EN_1 {
@ CT must be fully covered by M1 and (AA OR POLY), except SRAMALL region.
  ((CT NOT (M1 AND (PO OR AA))) NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

CT_EN_2a {
@ CT enclosure by AA for CT >= 0.015um
  X = CT INTERACT AA
  Y = ENC X AA < 0.015 ABUT<90 SINGULAR REGION OUTSIDE ALSO
  (Y NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
CT_EN_2b {
@ CT enclosure by AA for at least two opposite sides >= 0.03um
 X = RECTANGLE ENC (CT INTERACT AA) AA ABUT<90 OUTSIDE ALSO GOOD 0.015 OPPOSITE 0.03 OPPOSITE 0.015 OPPOSITE 0.03 OPPOSITE
  A = ENC [X] AA < 0.03 OPPOSITE
  D2 = INT A < 0.01 ABUT==90 INTERSECTING ONLY REGION      
  D2 NOT INSIDE SRAMALL
  ((CT INTERACT AA) NOT AA) NOT INSIDE SRAMALL
}
#IFDEF OPEN_RECOMMENDED_ON YES
CT_EN_2_R {
@ Recomended CT enclosure by AA for all sides >= 0.04um
  X = CT INTERACT AA
  Y = ENC X AA < 0.04 ABUT<90 SINGULAR REGION OUTSIDE ALSO
  (Y NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
#ENDIF
CT_EN_3a_3b_3c {
@ Min CT enclosure by poly is 0.01
@ Min CT enclosure by poly when one or both perpendicular directions <0.04um is 0.04um
@ Min CT enclosure by poly all side is 0.025
   X = RECTANGLE ENC (CT INTERACT PO) PO ABUT<90 OUTSIDE ALSO
  GOOD 0.01 OPPOSITE 0.04 OPPOSITE 0.01 OPPOSITE 0.04 OPPOSITE
  GOOD 0.025 0.025 0.025 0.025 

  D1 = ENC X PO < 0.01 ABUT<90 SINGULAR REGION OVERLAP OUTSIDE ALSO
  (D1 NOT INSIDE SRAMALL) NOT INSIDE NODRC

  A = ENC [X] PO < 0.04 OPPOSITE
  D2 = INT A < 0.01 ABUT==90 INTERSECTING ONLY REGION      //; For CT not touching M1
  D2 NOT INSIDE SRAMALL

  B = ENC X PO < 0.025 ABUT<90 SINGULAR REGION OVERLAP OUTSIDE ALSO
  (B NOT INSIDE SRAMALL) NOT INSIDE NODRC

  ((CT INTERACT PO) NOT PO) NOT INSIDE SRAMALL
  }
#IFDEF OPEN_RECOMMENDED_ON YES
CT_EN_3_R {
@ Recommended CT enclosure by poly for all sides to avoid high RC >= 0.06um
  X = CT INTERACT PO
  Y = ENC X PO < 0.06 ABUT<90 SINGULAR REGION OUTSIDE ALSO
  (Y NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
#ENDIF

CT_EN_4a_4b_4c {
@ Enclosure by M1 >= 0 um
@ Enclosure by M1 at least two opposite sides < 0.04um >= 0.04um
@ Enclosure by M1 for all sides >= 0.025 um
  X = RECTANGLE ENC (CT NOT TOUCH M1) M1 ABUT<90 OUTSIDE ALSO
  GOOD 0 0.04 OPPOSITE 0 0.04 OPPOSITE GOOD 0.025 0.025 0.025 0.025 OPPOSITE

  A = ENC [X] M1 < 0.04 OPPOSITE
  D1 = INT A < 0.01 ABUT==90 INTERSECTING ONLY REGION      //; For CT not touching M1
  (D1 NOT INSIDE SRAMALL) NOT INSIDE NODRC

  B = CT COIN EDGE M1
  D2 = INT B < 0.01 ABUT==90 REGION        //; For CT touch M1 with >= 2 butting edges
  (D2 NOT INSIDE SRAMALL) NOT INSIDE NODRC

  Y = ENC CT M1 < 0.04 OPPOSITE REGION
  C1 = CT COIN EDGE M1
  C2 = CT COIN EDGE Y
  D3 = INT C1 C2 < 0.01 ABUT==90 REGION	//; For CT touch M1 with only 1 edge
  (D3 NOT INSIDE SRAMALL) NOT INSIDE NODRC

  ((CT NOT M1) NOT INSIDE SRAMALL) NOT INSIDE NODRC
  (CT NOT INTERACT M1) NOT INSIDE NODRC
}

#IFDEF OPEN_RECOMMENDED_ON YES
CT_EN_4a_R_4b_R {
@ Recomended M1 enclosure of CT to avoide high RC >= 0.04 um
@ Recommended Minimum M1 enclosure of CT in line end region (at least two opposite sides) >=0.06 
   X = RECTANGLE ENC (CT INTERACT M1) M1 ABUT<90 OUTSIDE ALSO GOOD 0.04 0.06 OPPOSITE 0.04 0.06 OPPOSITE
  ((X NOT INSIDE SRAMALL) NOT INSIDE SRINGBLK) NOT INSIDE NODRC

  A = ENC X M1 < 0.06 OPPOSITE REGION
  A NOT INSIDE SRAMALL

  ((CT INTERACT M1) NOT M1) NOT INSIDE SRAMALL
}

CT_R_4 {
@ Recomended at least two CTs for connection except Reserved area, DRC help to mark single CT
  X1 = (NSD OR NTAP) INTERACT CT == 1
  (CT AND X1) NOT (NODRC OR SRAMALL)
  X2 = (PSD OR PTAP) INTERACT CT == 1
  (CT AND X2) NOT (NODRC OR SRAMALL)
  X3 = PO INTERACT CT == 1
  (CT AND X3) NOT (NODRC OR SRAMALL) 
}

#ENDIF

CT_EN_4d {
@ Enclosure by M1, when M1 width is > 1um. >= 0.04um
  M1_CHECK = M1 WITH WIDTH > 1
  CT_CHECK = CT NOT OUTSIDE M1_CHECK
  (ENC CT_CHECK M1 < 0.04 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}

CT_R_1  {
@ CT is not allowed to land on GATE
  ((AND GATE CT) NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
CT_R_2 {
@ CT is not allowed to interact SAB
@ Waive the CT cutting AA in SRAM area.
  ((CT INTERACT SAB) NOT INSIDE (SRAMALL OR EFUSEALL)) NOT INSIDE NODRC
}

CT_R_3 {
@ 45 degree CT is not allowed
    ((CT WITH EDGE (ANGLE CT == 45)) NOT INSIDE SRINGBLK) NOT INSIDE NODRC 
}

CT_R_5 {
@ Recomended to put CTs at both source side and butted well tap side. DRC can flag if the tap is butted on source and the tap or source region without CT
  X1 = (TOUCH NTAP NSDi) NOT INTERACT CT
  X2 = (TOUCH PTAP PSDi) NOT INTERACT CT
  X3 = (TOUCH NTAP PSDi) NOT INTERACT CT
  X4 = (TOUCH PTAP NSDi) NOT INTERACT CT
  (OR X1 X2 X3 X4) NOT NODRC
}

GROUP GMET1 MET1_?
density_checkarea = DRC:1 NOT INDALL
MET1_W_1 {
    @ M1 width >= 0.09um
    @ M1 width <= 12.00um
    (M1 WITH WIDTH > 12) NOT INSIDE NODRC
    (INT M1 < 0.09 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
MET1_W_2 {
    @ Width of metal1 with 45 degree, >= 0.19um
    X = ANGLE M1 == 45
    (INT X < 0.19 REGION) NOT INSIDE NODRC
}
MET1_W_3 {
    @ Minimum M1 width adjoining a huge non-metal region {[} area > 2000000 um2\], non-metal region is defined as (NOT (Mx OR MxDUM)) >= 0.35um
    NON_MAL_REG = AREA (DRC:1 NOT (OR M1 M1DUM)) > 2000000
    CHECK_REGION = ENCLOSE RECTANGLE NON_MAL_REG 10 0.35
    CHECK_MAL = M1 INTERACT CHECK_REGION
    (INT CHECK_MAL < 0.35 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
MET1_S_1 {
    @ Space between two M1s, DRC donBFt flag 89 to 90 degree spaces in the INDALL region. >= 0.09um
    X = EXT M1 < 0.09 ABUT<90 SINGULAR REGION
    ((X NOT INDALL) NOT INSIDE SRAMALL) NOT INSIDE NODRC
    Y = EXT M1 < 0.09 ABUT<89 SINGULAR REGION
    ((Y AND INDALL) NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

#IFDEF OPEN_RECOMMENDED_ON YES

MET1_S_1_R {
    @ Recomended pace between two M1s. >= 0.12um
    X = EXT M1 < 0.12 ABUT<90 SINGULAR REGION
    (X NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

#ENDIF

MET1_S_2 {
    @ Min Space between two M1 is 0.15 um when one or both M1 width >= 0.42um, and the parallel run length of two M1s is >= 0.42um
    span_edge_0 = DFM COPY (DFM SPACE M1ALL < 0.42 BY INT) EDGE
    span_edge_1 = M1ALL NOT COIN EDGE span_edge_0
    span_edge = EXT [span_edge_1] M1ALL < 0.15 ABUT < 90 OPPOSITE
    (LENGTH span_edge >= 0.42) NOT INSIDE EDGE NODRC
}
MET1_S_3 {
    @ Min Space between two M1 is 0.5 um when one or both M1 width >= 1.5um, and the parallel run length of two M1s is >= 1.5um
    span_edge_0 = DFM COPY (DFM SPACE M1ALL < 1.5 BY INT) EDGE
    span_edge_1 = M1ALL NOT COIN EDGE span_edge_0
    span_edge = EXT [span_edge_1] M1ALL < 0.5 ABUT < 90 OPPOSITE
    (LENGTH span_edge >= 1.5) NOT INSIDE EDGE NODRC
}
MET1_S_4 {
    @ Space between metal lines with one or both are 45 degree, >= 0.19um
    X = ANGLE M1 == 45
    (EXT X M1 < 0.19 REGION) NOT INSIDE NODRC
}
MET1_S_5 {
    @ Minimum Space at metal1 line-end(W<0.11um) in a dense-line-end configuration: if metal1 has parallel run length with opposite metal1 along 2 adjacent edge metal1 (any one edge < 0.11um distance from the conner of the two edge), the one of the space(sp1 or sp2) need to be at least 0.11 (except for small jog with edge length < 0.09um)
    LINE_END = CONVEX EDGE M1 ANGLE1 == 90 ANGLE2 == 90 WITH LENGTH < 0.11
    LINE_END_SP = EXT [LINE_END] M1 < 0.11 ABUT<90 OPPOSITE
    LINE_SIDE = LINE_END TOUCH INSIDE EDGE LINE_END_SP
    LINE_END_M1 = INT LINE_SIDE [M1] < 0.11 ABUT == 90 INTERSECTING ONLY
    LINE_END_M1_009 = LENGTH LINE_END_M1 >= 0.09
    (((EXT LINE_END_M1_009 M1 < 0.11 ABUT<90 OPPOSITE REGION) NOT MOMTER)NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
MET1_A_1 {
    @ M1 area >= 0.042um2
    X = AREA M1 < 0.042
    (X NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
MET1_A_2 {
    @ Enclosed dielectric area by M1 >= 0.18um2
    X = (HOLES M1 INNER EMPTY) NOT M1
    (AREA X < 0.18) NOT INSIDE NODRC
}

#IFDEF Density_rules YES

MET1_D_1_min {
    @ M1 density (including dummy) in 100umX100um window with step size 50um. INDALL/GRID/SRINGBLK covered areas are excluded for this rule checking >= 10%
    check_region_1 = (((DRC:1 NOT GRID) NOT SRINGBLK) NOT INDALL) NOT INSIDE NODRC
    DENSITY M1ALLi < 0.10 WINDOW 100 STEP 50 BACKUP INSIDE OF LAYER check_region_1 PRINT M1_D_1_min.log
}
MET1_D_1_max {
    @ M1 density (including dummy) in 100umX100um window with step size 50um. INDALL/GRID/SRINGBLK covered areas are excluded for this rule checking <= 80%
    check_region_1 = (((DRC:1 NOT GRID) NOT SRINGBLK) NOT INDALL) NOT INSIDE NODRC
    DENSITY M1ALLi > 0.80 WINDOW 100 STEP 50 BACKUP INSIDE OF LAYER check_region_1 PRINT M1_D_1_max.log
}
MET1_D_2 {
    @ M1 average density inside the {SIZE dummy block BY 2.5um} area in 100umX100um window with step size 50um >= 10%
    X = DENSITY M1ALLi < 0.1 WINDOW 100 STEP 50 backup PRINT density_report_M1_D_2.log
    Y = SIZE M1DUMB BY 2.5
    Z = SIZE Y BY 12.5 UNDEROVER
    (X AND Z) NOT INSIDE NODRC
}
MET1_D_3 {
    @ The difference between M1 density in 100x100 window (including dummy)
    @ INDALL/GRID/SRINGBLK covered areas are excluded for this rule checking <= 20%
    X = DENSITY M1ALLi >= 0 WINDOW 100 GRADIENT > 0.2 ABSOLUTE BACKUP INSIDE OF LAYER density_checkarea PRINT density_report_M1_D_3.log
    (((X NOT GRID) NOT SRINGBLK) NOT INDALL) NOT INSIDE NODRC
}

#ENDIF

GROUP GM2 M2_?
M2_W_1a {
    @ Mn width >= 0.10um
    (INT M2 < 0.10 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
M2_W_1b {
    @ Mn width
    @ (Exclude DEUPAD region when Mn as TM-1 in 1 top metal option) <= 12.00um
    (M2 WITH WIDTH > 12) NOT INSIDE NODRC
}
M2_W_2 {
    @ Width of Mn with 45 degree, >= 0.19um
    X = ANGLE M2 == 45
    (INT X < 0.19 REGION) NOT INSIDE NODRC
}
M2_W_3 {
    @ Minimum Mn width adjoining a huge non-metal region {[} area > 2000000 um2\], non-metal region is defined as (NOT (Mx OR MxDUM)) >= 0.35um
    NON_MAL_REG = AREA (DRC:1 NOT (OR M2 M2DUM)) > 2000000
    CHECK_REGION = ENCLOSE RECTANGLE NON_MAL_REG 10 0.35
    CHECK_MAL = M2 INTERACT CHECK_REGION
    (INT CHECK_MAL < 0.35 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
M2_S_1 {
    @ Space between two Mns,
    X = EXT M2 < 0.10 ABUT<90 SINGULAR REGION
    (X NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

#IFDEF OPEN_RECOMMENDED_ON YES

M2_S_1_R {
    @ Recommended Space between two Mns,
    X = EXT M2 < 0.13 ABUT<90 SINGULAR REGION
    (X NOT INSIDE SRAMALL) NOT INSIDE NODRC
}

#ENDIF

M2_S_2 {
    @ Space between two Mns when one or both Mn width >=0.42um, and the parallel run length of two Mns is >= 0.42um.>=0.15um
    span_edge_0 = DFM COPY (DFM SPACE M2ALL < 0.42 BY INT) EDGE
    span_edge_1 = M2ALL NOT COIN EDGE span_edge_0
    span_edge = EXT [span_edge_1] M2ALL < 0.15 ABUT < 90 OPPOSITE
    (LENGTH span_edge >= 0.42) NOT INSIDE EDGE NODRC
}
M2_S_3 {
    @ Space between two Mns when one or both Mn width >=1.5um, and the parallel run length of two Mns is >= 1.5um.>=0.5um
    span_edge_0 = DFM COPY (DFM SPACE M2ALL < 1.5 BY INT) EDGE
    span_edge_1 = M2ALL NOT COIN EDGE span_edge_0
    span_edge = EXT [span_edge_1] M2ALL < 0.5 ABUT < 90 OPPOSITE
    (LENGTH span_edge >= 1.5) NOT INSIDE EDGE NODRC
}
M2_S_4 {
    @ Space between metal lines with one or both is 45 degree (the area with 0.1um distance from bending point need not follow this rule) >= 0.19um
    X = ANGLE M2 == 45
    (EXT X < 0.19 REGION) NOT INSIDE NODRC
    (EXT M2 X < 0.19 REGION corner to edge) NOT INSIDE NODRC
}
M2_S_5 {
    @ Minimum Space at metalX line-end(W<0.12um) in a dense-line-end configuration:if metalx has parallel run length with opposite metalx along 2 adjacent edge metalx (any one edge < 0.12um distance from the conner of the two edge), the one of the space(sp1 or sp2) need to be at least 0.12 (except for small jog with edge length < 0.10um)
    LINE_END = CONVEX EDGE M2 ANGLE1 == 90 ANGLE2 == 90 WITH LENGTH < 0.12
    LINE_END_SP = EXT [LINE_END] M2 < 0.12 ABUT<90 OPPOSITE
    LINE_SIDE = LINE_END TOUCH INSIDE EDGE LINE_END_SP
    LINE_END_Mn = INT LINE_SIDE [M2] < 0.12 ABUT == 90 INTERSECTING ONLY
    LINE_END_Mn_010 = LENGTH LINE_END_Mn >= 0.10
    ((EXT LINE_END_Mn_010 M2 < 0.12 ABUT<90 OPPOSITE REGION)NOT MOMTER) NOT INSIDE NODRC
}
M2_A_1 {
    @ Mn area >= 0.052um2
    X = AREA M2 < 0.052
    (X NOT INSIDE SRAMALL) NOT INSIDE NODRC
}
M2_A_2 {
    @ Enclosed dielectric area by Mn >= 0.18um2
    X = (HOLES M2 INNER) NOT M2
    (AREA X < 0.18) NOT INSIDE NODRC
}

#IFDEF Density_rules YES

M2_D_1_min {
    @ Mn density (including dummy) in 100umX100um window with step size 50um. INDALL/GRID/SRINGBLK covered areas are excluded for this rule checking >= 10%
    check_region_1 = (((DRC:1 NOT GRID) NOT SRINGBLK) NOT INDALL) NOT INSIDE NODRC
    DENSITY M2ALLi < 0.10 WINDOW 100 STEP 50 BACKUP INSIDE OF LAYER check_region_1 PRINT M2_D_1_min.log
}
M2_D_1_max {
    @ Mn density (including dummy) in 100umX100um window with step size 50um. INDALL/FUTR/GRID/SRINGBLK covered areas are excluded for this rule checking <= 80%
    check_region_1 = (((DRC:1 NOT GRID) NOT SRINGBLK) NOT INDALL) NOT INSIDE NODRC
    DENSITY M2ALLi > 0.80 WINDOW 100 STEP 50 BACKUP INSIDE OF LAYER check_region_1 PRINT M2_D_1_max.log
}
M2_D_2 {
    @ Average density for Mn inside the dummy block area size 2.5um in 100umX100um window with step size 50um >= 10%
    X = DENSITY M2ALLi < 0.1 WINDOW 100 STEP 50 backup PRINT density_report_M2_D_2.log
    Y = SIZE M2DUMB BY 2.5
    Z = SIZE Y BY 12.5 UNDEROVER
    (X AND Z) NOT INSIDE NODRC
}
M2_D_3 {
    @ The difference between Mn density in 100umX100um those of the adjacent checking windows (including dummy)
    @ INDALL/GRID/SRINGBLK covered areas are excluded for this rule checking <= 20%
    X = DENSITY M2ALLi >= 0 WINDOW 100 GRADIENT > 0.20 ABSOLUTE BACKUP INSIDE OF LAYER density_checkarea PRINT density_report_M2_D_3.log
    (((X NOT GRID) NOT SRINGBLK) NOT INDALL) NOT INSIDE NODRC
}

#ENDIF

