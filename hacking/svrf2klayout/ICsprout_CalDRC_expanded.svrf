all_pad_TXT_M1 = OR all_pad_vdd_M1 all_pad_vss_M1 all_pad_vcc_M1 all_pad_gnd_M1
all_pad_TXT_M2 = OR all_pad_vdd_M2 all_pad_vss_M2 all_pad_vcc_M2 all_pad_gnd_M2
all_pad_TXT_M3 = OR all_pad_vdd_M3 all_pad_vss_M3 all_pad_vcc_M3 all_pad_gnd_M3
all_pad_TXT_M4 = OR all_pad_vdd_M4 all_pad_vss_M4 all_pad_vcc_M4 all_pad_gnd_M4
all_pad_TXT_M5 = OR all_pad_vdd_M5 all_pad_vss_M5 all_pad_vcc_M5 all_pad_gnd_M5
all_pad_TXT_M6 = OR all_pad_vdd_M6 all_pad_vss_M6 all_pad_vcc_M6 all_pad_gnd_M6
all_pad_TXT_M7 = OR all_pad_vdd_M7 all_pad_vss_M7 all_pad_vcc_M7 all_pad_gnd_M7
all_pad_TXT_M8 = OR all_pad_vdd_M8 all_pad_vss_M8 all_pad_vcc_M8 all_pad_gnd_M8
all_pad_TXT_T4M1 = OR all_pad_vdd_T4M1 all_pad_vss_T4M1 all_pad_vcc_T4M1 all_pad_gnd_T4M1
all_pad_TXT_T4M2 = OR all_pad_vdd_T4M2 all_pad_vss_T4M2 all_pad_vcc_T4M2 all_pad_gnd_T4M2
all_pad_TXT_T2M1 = OR all_pad_vdd_T2M1 all_pad_vss_T2M1 all_pad_vcc_T2M1 all_pad_gnd_T2M1
all_pad_TXT_T2M2 = OR all_pad_vdd_T2M2 all_pad_vss_T2M2 all_pad_vcc_T2M2 all_pad_gnd_T2M2
all_pad_TXT_T8M1 = OR all_pad_vdd_T8M1 all_pad_vss_T8M1 all_pad_vcc_T8M1 all_pad_gnd_T8M1
all_pad_TXT_T8M2 = OR all_pad_vdd_T8M2 all_pad_vss_T8M2 all_pad_vcc_T8M2 all_pad_gnd_T8M2
all_pad_TXT_PA = OR all_pad_vdd_PA all_pad_vss_PA all_pad_vcc_PA all_pad_gnd_PA
all_pad_TXT_ALPA = OR all_pad_vdd_ALPA all_pad_vss_ALPA all_pad_vcc_ALPA all_pad_gnd_ALPA
all_pad_TXT = OR all_pad_TXT_M1 all_pad_TXT_M2 all_pad_TXT_M3 all_pad_TXT_M4 all_pad_TXT_M5 all_pad_TXT_M6 all_pad_TXT_M7 all_pad_TXT_M8 all_pad_TXT_T4M1 all_pad_TXT_T4M2 all_pad_TXT_T2M1 all_pad_TXT_T2M2 all_pad_TXT_T8M1 all_pad_TXT_T8M2 all_pad_TXT_PA all_pad_TXT_ALPA
all_pad_TXT1_PA = STAMP all_pad_TXT_PA BY PA_1
all_pad_TXT1_ALPA = STAMP all_pad_TXT_ALPA BY ALPA_1
power_pad_TXT_PA = PA_1 INTERACT (NET AREA RATIO PA_1 all_pad_TXT1_PA > 0)
power_pad_TXT_ALPA = ALPA_1 INTERACT (NET AREA RATIO ALPA_1 all_pad_TXT1_ALPA > 0)
NACT_POWER_PAD_PA = NET AREA RATIO NACT_PAD power_pad_TXT_PA > 0
PACT_POWER_PAD_PA = NET AREA RATIO PACT_PAD power_pad_TXT_PA > 0
NACT_POWER_PAD_ALPA = NET AREA RATIO NACT_PAD power_pad_TXT_ALPA > 0
PACT_POWER_PAD_ALPA = NET AREA RATIO PACT_PAD power_pad_TXT_ALPA > 0

POWER_PAD2 = STAMP POWER_PAD BY MD_1
POWER_PAD3 = MD_1 INTERACT (NET AREA RATIO MD_1 POWER_PAD2 > 0)
MD_IO_PAD = MD_1 NOT INTERACT POWER_PAD3

NACT_0 = (SDN AND AA) NOT PO
PACT_0 = (SDP AND AA) NOT PO
CT_1 = EMPTY5 OR CT
MD_1 = EMPTY5 OR MD
RDL_1 = EMPTY5 OR RDL
RDLV_1 = EMPTY5 OR RV
RDLPA2_1 = EMPTY5 OR COVER

#IFDEF DEFINE_PAD_BY_TEXT 1

ALPA_1 = EMPTY5 OR ALPA
PA_1 = EMPTY5 OR PA
M1i_EMPTY5 = EMPTY5 OR M1i
all_pad_TXT1_M1 = STAMP all_pad_TXT_M1 BY M1i_EMPTY5
power_pad_TXT_M1 = M1i_EMPTY5 INTERACT (NET AREA RATIO M1i_EMPTY5 all_pad_TXT1_M1 > 0)
NACT_POWER_PAD_M1 = NET AREA RATIO NACT_PAD power_pad_TXT_M1 > 0
PACT_POWER_PAD_M1 = NET AREA RATIO PACT_PAD power_pad_TXT_M1 > 0
M2i_EMPTY5 = EMPTY5 OR M2i
all_pad_TXT1_M2 = STAMP all_pad_TXT_M2 BY M2i_EMPTY5
power_pad_TXT_M2 = M2i_EMPTY5 INTERACT (NET AREA RATIO M2i_EMPTY5 all_pad_TXT1_M2 > 0)
NACT_POWER_PAD_M2 = NET AREA RATIO NACT_PAD power_pad_TXT_M2 > 0
PACT_POWER_PAD_M2 = NET AREA RATIO PACT_PAD power_pad_TXT_M2 > 0
M3i_EMPTY5 = EMPTY5 OR M3i
all_pad_TXT1_M3 = STAMP all_pad_TXT_M3 BY M3i_EMPTY5
power_pad_TXT_M3 = M3i_EMPTY5 INTERACT (NET AREA RATIO M3i_EMPTY5 all_pad_TXT1_M3 > 0)
NACT_POWER_PAD_M3 = NET AREA RATIO NACT_PAD power_pad_TXT_M3 > 0
PACT_POWER_PAD_M3 = NET AREA RATIO PACT_PAD power_pad_TXT_M3 > 0
M4i_EMPTY5 = EMPTY5 OR M4i
all_pad_TXT1_M4 = STAMP all_pad_TXT_M4 BY M4i_EMPTY5
power_pad_TXT_M4 = M4i_EMPTY5 INTERACT (NET AREA RATIO M4i_EMPTY5 all_pad_TXT1_M4 > 0)
NACT_POWER_PAD_M4 = NET AREA RATIO NACT_PAD power_pad_TXT_M4 > 0
PACT_POWER_PAD_M4 = NET AREA RATIO PACT_PAD power_pad_TXT_M4 > 0
M5i_EMPTY5 = EMPTY5 OR M5i
all_pad_TXT1_M5 = STAMP all_pad_TXT_M5 BY M5i_EMPTY5
power_pad_TXT_M5 = M5i_EMPTY5 INTERACT (NET AREA RATIO M5i_EMPTY5 all_pad_TXT1_M5 > 0)
NACT_POWER_PAD_M5 = NET AREA RATIO NACT_PAD power_pad_TXT_M5 > 0
PACT_POWER_PAD_M5 = NET AREA RATIO PACT_PAD power_pad_TXT_M5 > 0
V1_EMPTY5 = EMPTY5 OR V1
V2_EMPTY5 = EMPTY5 OR V2
V3_EMPTY5 = EMPTY5 OR V3
V4_EMPTY5 = EMPTY5 OR V4
T4M2i_EMPTY5 = EMPTY5 OR T4M2i
T4V2i_EMPTY5 = EMPTY5 OR T4V2i
all_pad_TXT1_T4M2 = STAMP all_pad_TXT_T4M2 BY T4M2i_EMPTY5
power_pad_TXT_T4M2 = T4M2i_EMPTY5 INTERACT (NET AREA RATIO T4M2i_EMPTY5 all_pad_TXT1_T4M2 > 0)
NACT_POWER_PAD_T4M2 = NET AREA RATIO NACT_PAD power_pad_TXT_T4M2 > 0
PACT_POWER_PAD_T4M2 = NET AREA RATIO PACT_PAD power_pad_TXT_T4M2 > 0
NACT_POWER_PAD_all_0 = OR NACT_POWER_PAD_M1 NACT_POWER_PAD_PA NACT_POWER_PAD_ALPA
PACT_POWER_PAD_all_0 = OR PACT_POWER_PAD_M1 PACT_POWER_PAD_PA PACT_POWER_PAD_ALPA
NACT_POWER_PAD_all_1 = NACT_POWER_PAD_all_0 OR NACT_POWER_PAD_M2
NACT_POWER_PAD_all_2 = NACT_POWER_PAD_all_1 OR NACT_POWER_PAD_M3
NACT_POWER_PAD_all_3 = NACT_POWER_PAD_all_2 OR NACT_POWER_PAD_M4
NACT_POWER_PAD_all_4 = NACT_POWER_PAD_all_3 OR NACT_POWER_PAD_M5
NACT_POWER_PAD_all_5 = NACT_POWER_PAD_all_4 OR NACT_POWER_PAD_T4M2
  
PACT_POWER_PAD_all_1 = PACT_POWER_PAD_all_0 OR PACT_POWER_PAD_M2
PACT_POWER_PAD_all_2 = PACT_POWER_PAD_all_1 OR PACT_POWER_PAD_M3
PACT_POWER_PAD_all_3 = PACT_POWER_PAD_all_2 OR PACT_POWER_PAD_M4
PACT_POWER_PAD_all_4 = PACT_POWER_PAD_all_3 OR PACT_POWER_PAD_M5
PACT_POWER_PAD_all_5 = PACT_POWER_PAD_all_4 OR PACT_POWER_PAD_T4M2
NACT_IO_PAD = NACT_PAD NOT INTERACT NACT_POWER_PAD_all_5
PACT_IO_PAD = PACT_PAD NOT INTERACT PACT_POWER_PAD_all_5
NMOS_IO_PAD = NMOS_PAD INTERACT NACT_IO_PAD
PMOS_IO_PAD = PMOS_PAD INTERACT PACT_IO_PAD

#ENDIF


#IFDEF DEFINE_PAD_BY_TEXT 0

ALPA_1 = EMPTY5 OR ALPAi
PA_1 = EMPTY5 OR CBi
M1i_EMPTY5 = EMPTY5 OR M1i
V1_EMPTY5 = EMPTY5 OR V1
M2i_EMPTY5 = EMPTY5 OR M2i
V2_EMPTY5 = EMPTY5 OR V2
M3i_EMPTY5 = EMPTY5 OR M3i
V3_EMPTY5 = EMPTY5 OR V3
M4i_EMPTY5 = EMPTY5 OR M4i
V4_EMPTY5 = EMPTY5 OR V4
M5i_EMPTY5 = EMPTY5 OR M5i
T4V2i_EMPTY5 = EMPTY5 OR T4V2i
T4M2i_EMPTY5 = EMPTY5 OR T4M2i

NACT_IO_PAD = NET AREA RATIO NACT_1 MD_IO_PAD > 0
PACT_IO_PAD = NET AREA RATIO PACT_1 MD_IO_PAD > 0
NMOS_IO_PAD = NMOS1 INTERACT NACT_IO_PAD
PMOS_IO_PAD = PMOS1 INTERACT PACT_IO_PAD


#ENDIF


#IFDEF CONNECT_ALL_RESISTOR 0

NACT_1 = EMPTY5 OR (NACT_0 NOT (AA_resistor OR NW_resistor))
PACT_1 = EMPTY5 OR (PACT_0 NOT (AA_resistor OR NW_resistor))
PO_1 = EMPTY5 OR (PO_raw NOT PO_resistor)

#ENDIF


#IFDEF CONNECT_ALL_RESISTOR 1

NACT_1 = EMPTY5 OR NACT_0
PACT_1 = EMPTY5 OR PACT_0
PO_1 = EMPTY5 OR PO_raw

#ENDIF

CONNECT M1i_EMPTY5 M2i_EMPTY5 BY V1_EMPTY5
CONNECT M2i_EMPTY5 M3i_EMPTY5 BY V2_EMPTY5
CONNECT M3i_EMPTY5 M4i_EMPTY5 BY V3_EMPTY5
CONNECT M4i_EMPTY5 M5i_EMPTY5 BY V4_EMPTY5
CONNECT M5i_EMPTY5 T4M2i_EMPTY5 BY T4V2i_EMPTY5
CONNECT M1i_EMPTY5 PO_1 NACT_1 PACT_1 BY CT_1
CONNECT T4M2i_EMPTY5 PA_1
CONNECT T4M2i_EMPTY5 RDL_1 BY RDLV_1
CONNECT RDL_1 RDLPA2_1
CONNECT PA_1 ALPA_1
CONNECT RDL_1 ALPA_1
CONNECT ALPA_1 MD_1
NMOS_PAD = NMOS INTERACT (NET AREA RATIO NACT_1 MD_IO_PAD > 0)
PMOS_PAD = PMOS INTERACT (NET AREA RATIO PACT_1 MD_IO_PAD > 0)
NACT_PAD = NET AREA RATIO NACT_1 MD_IO_PAD > 0
PACT_PAD = NET AREA RATIO PACT_1 MD_IO_PAD > 0
PMOS1 = PACT ENCLOSE GATE
NMOS1 = NACT ENCLOSE GATE
NGUARDRING = HOLES NTAP INNER
PGUARDRING = HOLES PTAP INNER
NGUARDHOLE_2 = (HOLES NTAP INNER) ENCLOSE PGUARDRING
PGUARDHOLE_2 = (HOLES PTAP INNER) ENCLOSE NGUARDRING
GATEHV = GATE AND TG
NGATEHV = NGATE AND TG
PGATEHV = PGATE AND TG
GATEMV = GATE AND DG //1.8V or 1.5V
GATELV = GATE NOT INSIDE (DG OR TG)

#IFDEF LATCH_UP_CHECK YES

LU_R_2 {
    @ Guard ring should be used to surround AA injector or a group of AA injectors which are connected to an I/O pad
    @ N+ injector must be surrounded by a P+ guard-ring
    @ P+ injector must be surrounded by a N+ guard-ring
    @ NW/PW pickups rings can be used as guard rings. DRC check the nearest guard-ring which surrounds AA injector or a group of AA injector
    (((NACT_IO_PAD TOUCH PO) NOT PGUARDRING) NOT INSIDE (LATCHUP OR SRINGBLK)) NOT INSIDE NODRC
    (((PACT_IO_PAD TOUCH PO) NOT NGUARDRING) NOT INSIDE (LATCHUP OR SRINGBLK)) NOT INSIDE NODRC
}
LU_W_1 {
    @ Guard-ring width for AA injector connected to an I/O pad
    @ Guard-ring definition please refers to LU.1. >= 0.12um
    (INT ((DONUT NTAP) TOUCH ((HOLES NTAP INNER) ENCLOSE PACT_IO_PAD)) < 0.12 ABUT<90 SINGULAR REGION) NOT INSIDE (OR SRINGBLK LATCHUP NODRC)
    (INT ((DONUT PTAP) TOUCH ((HOLES PTAP INNER) ENCLOSE NACT_IO_PAD)) < 0.12 ABUT<90 SINGULAR REGION) NOT INSIDE (OR SRINGBLK LATCHUP NODRC)
}

#IFDEF LU_3_CHECK FAST

LU_S_1a {
    @ For 0.9/1.2V core N/PMOS AA connected to an I/O pad
    @ Spacing between NMOS and PMOS >= 2.0um
    X = (NMOS_IO_PAD ENCLOSE GATELV) NOT SRINGBLK
    Y = (PMOS_IO_PAD ENCLOSE GATELV) NOT SRINGBLK
    M = (NMOS ENCLOSE GATELV) NOT SRINGBLK
    N = (PMOS ENCLOSE GATELV) NOT SRINGBLK
    Z1 = SIZE X BY 1.036 BEVEL 3
    Z2 = SIZE N BY 1.036 BEVEL 3
    (Z1 AND Z2) NOT INSIDE (OR LATCHUP NODRC)
    Z3 = SIZE M BY 1.036 BEVEL 3
    Z4 = SIZE Y BY 1.036 BEVEL 3
    (Z3 AND Z4) NOT INSIDE (OR LATCHUP NODRC)
}
LU_S_1b {
    @ LU.3a-LU.3d define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS AA connected to I/O pad. (Fig.1).
    @ For 1.8V N/PMOS AA connected to an I/O pad
    @ Spacing between 1.8V NMOS and 1.8V PMOS and Spacing between 1.8V PMOS and 1.8V/Core NMOS. >= 2.3um
    X = NMOS_IO_PAD ENCLOSE GATEMV
    Y = PMOS_IO_PAD ENCLOSE GATEMV
    M = NMOS ENCLOSE (GATELV OR GATEMV)
    N = PMOS ENCLOSE (GATELV OR GATEMV)
    Z1 = SIZE X BY 1.191 BEVEL 3
    Z2 = SIZE N BY 1.191 BEVEL 3
    ((Z1 AND Z2) NOT SRINGBLK) NOT INSIDE (OR LATCHUP NODRC)
    Z3 = SIZE M BY 1.191 BEVEL 3
    Z4 = SIZE Y BY 1.191 BEVEL 3
    ((Z3 AND Z4) NOT SRINGBLK) NOT INSIDE (OR LATCHUP NODRC)
}
LU_S_1c {
    @ LU.3a-LU.3d define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS AA connected to I/O pad. (Fig.1).
    @ For 2.5V N/PMOS AA connected to an I/O pad
    @ Spacing between 2.5V NMOS and 2.5V PMOS and Spacing between 2.5V PMOS and 2.5V/Core NMOS. >= 3.2um
    X = NMOS_IO_PAD ENCLOSE GATEHV
    Y = PMOS_IO_PAD ENCLOSE GATEHV
    M = NMOS ENCLOSE (GATELV OR GATEHV )
    N = PMOS ENCLOSE (GATELV OR GATEHV)
    Z1 = SIZE X BY 1.657 BEVEL 3
    Z2 = SIZE N BY 1.657 BEVEL 3
    ((Z1 AND Z2) NOT SRINGBLK) NOT INSIDE (OR LATCHUP NODRC)
    Z3 = SIZE M BY 1.657 BEVEL 3
    Z4 = SIZE Y BY 1.657 BEVEL 3
    ((Z3 AND Z4) NOT SRINGBLK) NOT INSIDE (OR LATCHUP NODRC)
}
LU_S_1d {
    @ For 3.3 V N/PMOS (or 2.5V overdrive 3.3V) AA connected to an I/O pad
    @ Spacing between 3.3V NMOS and 3.3V/0.9V/1.2V PMOS and
    @ Spacing between 3.3V PMOS and 3.3V/0.9V/1.2V NMOS. >= 5um
    X = NMOS_IO_PAD ENCLOSE GATEHV
    Y = PMOS_IO_PAD ENCLOSE GATEHV
    M = NMOS ENCLOSE (GATELV OR GATEHV )
    N = PMOS ENCLOSE (GATELV OR GATEHV )
    Z1 = SIZE X BY 2.589 BEVEL 3
    Z2 = SIZE N BY 2.589 BEVEL 3
    ((Z1 AND Z2) NOT SRINGBLK) NOT INSIDE (OR LATCHUP NODRC)
    Z3 = SIZE M BY 2.589 BEVEL 3
    Z4 = SIZE Y BY 2.589 BEVEL 3
    ((Z3 AND Z4) NOT SRINGBLK) NOT INSIDE (OR LATCHUP NODRC)
}

#ENDIF


#IFDEF LU_3_CHECK ACCURATE

LU_S_1a {
    @ LU.3a-LU.3d define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS AA connected to I/O pad. (Fig.1).
    @ For core N/PMOS connected to an I/O pad
    @ Spacing between NMOS and PMOS. >= 2um
    X = NMOS_IO_PAD ENCLOSE GATELV
    Y = PMOS_IO_PAD ENCLOSE GATELV
    M = NMOS ENCLOSE GATELV
    N = PMOS ENCLOSE GATELV
    ((EXT X N < 2 ABUT<90 SINGULAR REGION) NOT SRINGBLK) NOT INSIDE (OR LATCHUP NODRC)
    ((EXT M Y < 2 ABUT<90 SINGULAR REGION) NOT SRINGBLK) NOT INSIDE (OR LATCHUP NODRC)
}
LU_S_1b {
    @ LU.3a-LU.3d define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS AA connected to I/O pad. (Fig.1).
    @ For 1.8V N/PMOS AA connected to an I/O pad
    @ Spacing between 1.8V NMOS and 1.8V/Core PMOS and Spacing between 1.8V PMOS and 1.8V/Core NMOS. >= 2.3um
    X = NMOS_IO_PAD ENCLOSE GATEMV
    Y = PMOS_IO_PAD ENCLOSE GATEMV
    M = NMOS ENCLOSE (GATELV OR GATEMV)
    N = PMOS ENCLOSE (GATELV OR GATEMV)
    ((EXT M Y < 2.3 ABUT<90 SINGULAR REGION) NOT SRINGBLK ) NOT INSIDE (OR LATCHUP NODRC)
    ((EXT X N < 2.3 ABUT<90 SINGULAR REGION) NOT SRINGBLK ) NOT INSIDE (OR LATCHUP NODRC)
}
LU_S_1c {
    @ LU.3a-LU.3d define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS AA connected to I/O pad. (Fig.1).
    @ For 2.5V N/PMOS AA connected to an I/O pad
    @ Spacing between 2.5V NMOS and 2.5V/Core PMOS and Spacing between 2.5V PMOS and 2.5V/Core NMOS. >= 3.2um
    X = NMOS_IO_PAD ENCLOSE GATEHV
    Y = PMOS_IO_PAD ENCLOSE GATEHV
    M = NMOS ENCLOSE (GATELV OR GATEHV )
    N = PMOS ENCLOSE (GATELV OR GATEHV)
    ((EXT M Y < 3.2 ABUT<90 SINGULAR REGION) NOT SRINGBLK) NOT INSIDE (OR LATCHUP NODRC)
    ((EXT X N < 3.2 ABUT<90 SINGULAR REGION) NOT SRINGBLK) NOT INSIDE (OR LATCHUP NODRC)
}
LU_S_1d {
    @ LU.3a-LU.3d define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS AA connected to I/O pad. (Fig.1).
    @ For 3.3 V N/PMOS AA (2.5V overdrive) connected to an I/O pad
    @ Spacing between 3.3V NMOS and 3.3V/Core PMOS and Spacing between 3.3V PMOS and 3.3V/Core NMOS >= 5.0um.
    X = NMOS_IO_PAD ENCLOSE GATEHV
    Y = PMOS_IO_PAD ENCLOSE GATEHV
    M = NMOS ENCLOSE (GATELV OR GATEHV)
    N = PMOS ENCLOSE (GATELV OR GATEHV)
    ((EXT X N < 5 ABUT<90 SINGULAR REGION) NOT SRINGBLK) NOT INSIDE (OR LATCHUP NODRC)
    ((EXT Y M < 5 ABUT<90 SINGULAR REGION) NOT SRINGBLK) NOT INSIDE (OR LATCHUP NODRC)
}

#ENDIF

LU_S_2_NTAP {
    @ Space (S2) from any point within the Source/Drain region to the nearest pickup AA region inside the same well for I/O and internal circuits. (Fig.2).
    @ For native device, DRC check the pickup AA inside the PSUB butted PW area, and PW is still treated as connection by substrate even one NW ring inserted. <= 35um
    NW_MINUS_NTAP_0 = SIZE NTAP BY 5 INSIDE OF NW STEP 0.38 BEVEL 4
    MAYBE_BAD_b = NW NOT NW_MINUS_NTAP_0
    NW_FILTER = NW INTERACT MAYBE_BAD_b
    NW_MINUS_NTAP_1 = NW_MINUS_NTAP_0 AND NW_FILTER
    NW_MINUS_NTAP = SIZE NW_MINUS_NTAP_1 BY 30 INSIDE OF NW_FILTER STEP 0.38 BEVEL 4
    X = PMOS1 AND NW_FILTER
    ((OUTSIDE EDGE X NW_MINUS_NTAP) NOT INSIDE EDGE SRINGBLK) NOT INSIDE EDGE NODRC
}
LU_S_2_PTAP {
    @ Space (S2) from any point within the Source/Drain region to the nearest pickup AA region inside the same well for I/O and internal circuits.(Fig. 7.3.14-2)
    @ For native device, DRC check the pickup AA inside the PSUB butted PW area, and PW is still treated as connection by substrate even one NW ring inserted. <= 35um
    PW_MINUS_PTAP_0 = SIZE PTAP BY 5 INSIDE OF PW STEP 0.38 BEVEL 4
    MAYBE_BAD_b = PW NOT PW_MINUS_PTAP_0
    PW_FILTER = PW INTERACT MAYBE_BAD_b
    PW_MINUS_PTAP_1 = PW_MINUS_PTAP_0 AND PW_FILTER
    PW_MINUS_PTAP = SIZE PW_MINUS_PTAP_1 BY 30 INSIDE OF PW_FILTER STEP 0.38 BEVEL 4
    X = NMOS1 AND PW_FILTER
    ((OUTSIDE EDGE X PW_MINUS_PTAP) NOT INSIDE EDGE SRINGBLK) NOT INSIDE EDGE NODRC
    SIZE_REGION = OR PW PSUB NW
    SIZE_PTAP_NOT_DNW = PTAP NOT (DNW NOT INTERACT PSUB)
    PW_SIZE_a = SIZE SIZE_PTAP_NOT_DNW BY 5 INSIDE OF SIZE_REGION STEP 0.38 BEVEL 4
    MAYBE_BAD_PSUB_a = SIZE_REGION NOT PW_SIZE_a
    PW_FILTER_PSUB_a = SIZE_REGION INTERACT MAYBE_BAD_PSUB_a
    PW_MINUS_PTAP_PSUB_a = PW_SIZE_a AND PW_FILTER_PSUB_a
    PW_SIZE_1 = SIZE PW_MINUS_PTAP_PSUB_a BY 30 INSIDE OF PW_FILTER_PSUB_a STEP 0.38 BEVEL 4
    NMOS_PSUB_a = ((NMOS1 AND PSUB) NOT INTERACT DNW) AND PW_FILTER_PSUB_a
    ((OUTSIDE EDGE NMOS_PSUB_a PW_SIZE_1) NOT INSIDE EDGE SRINGBLK) NOT INSIDE EDGE NODRC
    SIZE_PTAP_AND_DNW = (PTAP AND (PW INTERACT PSUB)) INTERACT DNW
    PW_SIZE_b = SIZE SIZE_PTAP_AND_DNW BY 5 INSIDE OF SIZE_REGION STEP 0.38 BEVEL 4
    MAYBE_BAD_PSUB_b = SIZE_REGION NOT PW_SIZE_b
    PW_FILTER_PSUB_b = SIZE_REGION INTERACT MAYBE_BAD_PSUB_b
    PW_MINUS_PTAP_PSUB_b = PW_SIZE_b AND PW_FILTER_PSUB_b
    PW_SIZE_2 = SIZE PW_MINUS_PTAP_PSUB_b BY 30 INSIDE OF PW_FILTER_PSUB_b STEP 0.38 BEVEL 4
    NMOS_PSUB_b = ((NMOS1 AND PSUB) INTERACT DNW) AND PW_FILTER_PSUB_b
    ((OUTSIDE EDGE NMOS_PSUB_b PW_SIZE_2) NOT INSIDE EDGE SRINGBLK) NOT INSIDE EDGE NODRC
}

#ENDIF


#IFDEF MOM_CHECK YES

GROUP GMOM MOM_?
MOM_R_1 {
    @ It is not allowed:
    @ 1) V1 in M1MOM
    @ 2) Vn/Vn-1 in MOMMKn (n = 2~8), whereVn-1 is the via underneath Mn, and Vn is the via above Mn. Vn can be inter-via or T4V1/T2V1 or T4V2/T2V2
    (V1 AND M1MOM) NOT INSIDE NODRC
    (V1 AND M2MOM) NOT INSIDE NODRC
    (V2 AND M2MOM) NOT INSIDE NODRC
    (V2 AND M3MOM) NOT INSIDE NODRC
    (V3 AND M3MOM) NOT INSIDE NODRC
    (V3 AND M4MOM) NOT INSIDE NODRC
    (V4 AND M4MOM) NOT INSIDE NODRC
    (V4 AND M5MOM) NOT INSIDE NODRC
    (T4V2 AND M5MOM) NOT INSIDE NODRC
}
MOM_S_1 {
    @ The space between (Mn AND MOMMKn AND MOMLVS1) and Vn/Vn-1 (n = 1~8) outside of MOMLVS1, whereVn-1 is the via underneath Mn, and Vn is the via above Mn. Vn can be inter-via or T4V1 or T4V2. >= 0.11um
    (EXT (V1 OUTSIDE MOMLVS1) ((M1 AND M1MOM) AND MOMLVS1) < 0.11 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
    (EXT (V1 OUTSIDE MOMLVS1) ((M2 AND M2MOM) AND MOMLVS1) < 0.11 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
    (EXT (V2 OUTSIDE MOMLVS1) ((M2 AND M2MOM) AND MOMLVS1) < 0.11 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
    (EXT (V2 OUTSIDE MOMLVS1) ((M3 AND M3MOM) AND MOMLVS1) < 0.11 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
    (EXT (V3 OUTSIDE MOMLVS1) ((M3 AND M3MOM) AND MOMLVS1) < 0.11 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
    (EXT (V3 OUTSIDE MOMLVS1) ((M4 AND M4MOM) AND MOMLVS1) < 0.11 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
    (EXT (V4 OUTSIDE MOMLVS1) ((M4 AND M4MOM) AND MOMLVS1) < 0.11 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
    (EXT (V4 OUTSIDE MOMLVS1) ((M5 AND M5MOM) AND MOMLVS1) < 0.11 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
    (EXT (T4V2 OUTSIDE MOMLVS1) ((M5 AND M5MOM) AND MOMLVS1) < 0.11 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
MOM_R_2 {
    @ MOMLVS1 and MOMMKn layers are must for MOM device. DRC checking is based on the label text by MOMLVS1 layer. Possible label texts and related MOMMKn follow the Table-1. DRC need flag the stacked MOM structure
