    X4_far = (EXPAND EDGE X3 OUTSIDE BY (1.5 + 0.01)) NOT X4_near
    X5 = X4_near NOT M7ALL
    X6_near = EXT X1 X5 < 1.5 OPPOSITE REGION
    X6_far = EXT X4_far X5 < 1.5 OPPOSITE REGION
    X7 = (X4_near NOT X5) NOT (X6_near OR X6_far)
    X7_edge = LENGTH (X7 COIN EDGE X1) >= 1.5
