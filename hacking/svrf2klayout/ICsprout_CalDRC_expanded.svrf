GROUP GV4 V4_?
V4_W_1 {
    @ Fixed V4 size (square shape) is 0.09,exclude GRING OR SRINGBLK area
    (NOT RECTANGLE V4 == 0.09 BY == 0.09) NOT INSIDE (OR GRID SRINGBLK NODRC)
}
V4_W_2 {
    @ Fixed V4 width(datatype 13) is 0.09,exclude EFUSEALL OR SRAMALL OR FUSEALL area
    (WITH WIDTH V4bar < 0.09 ) INSIDE (OR SRAMALL EFUSEALL FUSEALL)
    (WITH WIDTH V4bar > 0.09 ) INSIDE (OR SRAMALL EFUSEALL FUSEALL)
}
V4_S_1 {
    @ Space between two V4 is 0.11
    (EXT V4 < 0.11 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
V4_S_2 {
    @ Space between V4s between V and 3-neighboring Vs whose space is < 0.14um. >= 0.13.
    X = SIZE V4 BY 0.07 OVERUNDER
    Y = SIZE X BY 0.240 UNDEROVER
    Z = V4 INSIDE Y
    (EXT Z < 0.13 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
V4_S_3 {
    @ Minimum Space between two neighbor V4s (different net and run length>0) >= 0.13um.
    (EXT V4 < 0.13 ABUT<90 OPPOSITE REGION NOT CONNECTED) NOT INSIDE NODRC
}
V4_EN_2a_2b_2c {
    @ Vn must be fully enclosed by Mn >= 0
    @ Min M4 enclosure of V4 for two opposite sides >=0.04
    @ Vn must be fully enclosed by Mn/Mn+1 all sides >=0.03
    X = RECTANGLE ENC V4 M4 ABUT<90 OUTSIDE ALSO GOOD 0 0.04 OPPOSITE 0 0.04 OPPOSITE GOOD 0.03 0.03 0.03 0.03 OPPOSITE
    X NOT INSIDE (OR NODRC SRAMALL SRINGBLK)
    (V4 NOT M4) NOT INSIDE NODRC
}

#IFDEF OPEN_RECOMMENDED_ON YES

V4_2a_R_2b_R {
    @ Vn must be fully enclosed by Mn >= 0.04
    @ Min M4 enclosure of V4 for two opposite sides >=0.07
    X = RECTANGLE ENC V4 M4 ABUT<90 OUTSIDE ALSO GOOD 0.04 0.07 OPPOSITE 0.04 0.07 OPPOSITE GOOD 0.04 0.04 0.04 0.04 OPPOSITE
    X NOT INSIDE (OR NODRC SRINGBLK SRAMALL)
    (V4 NOT M4) NOT INSIDE NODRC
}

#ENDIF

V4_EN_5a_5b {
    @ Vn must be fully enclosed by Mn+1
    @ Min M5 enclsoure of V4 is 0.005
    @ Min M5 enclosure of V4 is 0.02 when M5 enclosure on one or both perpendicular directions<0.02um
    X = RECTANGLE ENC V4 M5 ABUT<90 OUTSIDE ALSO GOOD 0.005 OPPOSITE 0.02 OPPOSITE 0.005 OPPOSITE 0.02 OPPOSITE
    (ENC X M5 < 0.005 ABUT<90 SINGULAR REGION OVERLAP OUTSIDE ALSO) NOT INSIDE NODRC
    Y = ENC [X] M5 < 0.02 OPPOSITE
    (INT Y < 0.01 ABUT==90 INTERSECTING ONLY REGION) NOT INSIDE NODRC
    (V4 NOT M5) NOT INSIDE NODRC
}

#IFDEF OPEN_RECOMMENDED_ON YES

V4_R_2a_2b {
    @ There should be at least 2(Via with space <= 0.2um) or 4(Via with space <= 0.25um) at the intersection of Mn and Mn+1, when either Mn or Mn+1 width > 0.3um
    @ There should be at least 4(Via with space <= 0.2um) or 9(Via with space <= 0.55um) at the intersection of Mn and Mn+1, when either Mn or Mn+1 width > 0.7um
    w03b = M4 WITH WIDTH > 0.3
    w03u = M5 WITH WIDTH > 0.3
    w03 = M4 AND M5
    wide03 = ((w03 ENCLOSE (V4 NOT OUTSIDE w03b)) OR (w03 ENCLOSE (V4 NOT OUTSIDE w03u))) NOT wide07
    wide03v2s = SIZE (V4 INTERACT wide03) BY 0.1 INSIDE OF wide03 STEP 0.05
    wide03v4s = SIZE (V4 INTERACT wide03) BY 0.125 INSIDE OF wide03 STEP 0.05
    wide03v2 = wide03v2s INTERACT V4 >= 2
    wide03v4 = wide03v4s INTERACT V4 >= 4
    (wide03 NOT INTERACT (wide03v2 OR wide03v4)) NOT INSIDE NODRC
    w07b = M4 WITH WIDTH > 0.7
    w07u = M5 WITH WIDTH > 0.7
    w07 = M4 AND M5
    wide07 = (w07 ENCLOSE (V4 NOT OUTSIDE w07b)) OR (w07 ENCLOSE (V4 NOT OUTSIDE w07u))
    wide07v4s = SIZE (V4 INTERACT wide07) BY 0.1 INSIDE OF wide07 STEP 0.05
    wide07v9s = SIZE (V4 INTERACT wide07) BY 0.275 INSIDE OF wide07 STEP 0.05
    wide07v4 = wide07v4s INTERACT V4 >= 4
    wide07v9 = wide07v9s INTERACT V4 >= 9
    (wide07 NOT INTERACT (wide07v4 OR wide07v9)) NOT INSIDE NODRC
}

#ENDIF

V4_R_5 {
    @ 45-dgree rotated via is not allowed
    ((V4 WITH EDGE (ANGLE V4 == 45)) NOT INSIDE SRINGBLK) NOT INSIDE NODRC
}
TMP = AA AND PO
V1N_M = V1N INTERACT st_1
st_1 = (M1 AND M2) ENCLOSE V1 == 1
V1N = V1 AND (RECTANGLE V1 == 0.09 BY == 0.09)
RV1 = V1 AND (RECTANGLE V1 ASPECT != 1)
V1_R_3 {
    @ Single Vn is not allowed in H-shape Mn+1 when:
    @ 1) The Mn+1 has H-shape metal interact with two metal holes: both two metal holes' length (L2) <= 5um and area <= 5um2.
    @ 2) The Vn overlaps on the center metal bar of this H-shape Mn+1
    @ 3) The center metal bar has the length (L) <= 1um and the width <= 3um
    X0 = AREA (RECTANGLE (HOLES M2 INNER)) <= 5
    X1 = X0 NOT WITH EDGE (LENGTH X0 > 5)
    Y = M2 COIN EDGE X1
    Y1 = (EXT Y <= 3 OPPOSITE REGION) NOT M2
    Z0 = M2 INTERACT Y1 == 2
    Z1 = LENGTH (M2 COIN EDGE Z0) <= 1
    Z = Z0 WITH EDGE Z1
    (Z INTERACT V1N == 1) NOT INSIDE NODRC
}
V2N_M = V2N INTERACT st_2
st_2 = (M2 AND M3) ENCLOSE V2 == 1
V2N = V2 AND (RECTANGLE V2 == 0.09 BY == 0.09)
RV2 = V2 AND (RECTANGLE V2 ASPECT != 1)
V2_R_3 {
    @ Single Vn is not allowed in H-shape Mn+1 when:
    @ 1) The Mn+1 has H-shape metal interact with two metal holes: both two metal holes' length (L2) <= 5um and area <= 5um2.
    @ 2) The Vn overlaps on the center metal bar of this H-shape Mn+1
    @ 3) The center metal bar has the length (L) <= 1um and the width <= 3um
    X0 = AREA (RECTANGLE (HOLES M3 INNER)) <= 5
    X1 = X0 NOT WITH EDGE (LENGTH X0 > 5)
    Y = M3 COIN EDGE X1
    Y1 = (EXT Y <= 3 OPPOSITE REGION) NOT M3
    Z0 = M3 INTERACT Y1 == 2
    Z1 = LENGTH (M3 COIN EDGE Z0) <= 1
    Z = Z0 WITH EDGE Z1
    (Z INTERACT V2N == 1) NOT INSIDE NODRC
}
V3N_M = V3N INTERACT st_3
st_3 = (M3 AND M4) ENCLOSE V3 == 1
V3N = V3 AND (RECTANGLE V3 == 0.09 BY == 0.09)
RV3 = V3 AND (RECTANGLE V3 ASPECT != 1)
V3_R_3 {
    @ Single Vn is not allowed in H-shape Mn+1 when:
    @ 1) The Mn+1 has H-shape metal interact with two metal holes: both two metal holes' length (L2) <= 5um and area <= 5um2.
    @ 2) The Vn overlaps on the center metal bar of this H-shape Mn+1
    @ 3) The center metal bar has the length (L) <= 1um and the width <= 3um
    X0 = AREA (RECTANGLE (HOLES M4 INNER)) <= 5
    X1 = X0 NOT WITH EDGE (LENGTH X0 > 5)
    Y = M4 COIN EDGE X1
    Y1 = (EXT Y <= 3 OPPOSITE REGION) NOT M4
    Z0 = M4 INTERACT Y1 == 2
    Z1 = LENGTH (M4 COIN EDGE Z0) <= 1
    Z = Z0 WITH EDGE Z1
    (Z INTERACT V3N == 1) NOT INSIDE NODRC
}
V4N_M = V4N INTERACT st_4
st_4 = (M4 AND M5) ENCLOSE V4 == 1
V4N = V4 AND (RECTANGLE V4 == 0.09 BY == 0.09)
RV4 = V4 AND (RECTANGLE V4 ASPECT != 1)
V4_R_3 {
    @ Single Vn is not allowed in H-shape Mn+1 when:
    @ 1) The Mn+1 has H-shape metal interact with two metal holes: both two metal holes' length (L2) <= 5um and area <= 5um2.
    @ 2) The Vn overlaps on the center metal bar of this H-shape Mn+1
    @ 3) The center metal bar has the length (L) <= 1um and the width <= 3um
    X0 = AREA (RECTANGLE (HOLES M5 INNER)) <= 5
    X1 = X0 NOT WITH EDGE (LENGTH X0 > 5)
    Y = M5 COIN EDGE X1
    Y1 = (EXT Y <= 3 OPPOSITE REGION) NOT M5
    Z0 = M5 INTERACT Y1 == 2
    Z1 = LENGTH (M5 COIN EDGE Z0) <= 1
    Z = Z0 WITH EDGE Z1
    (Z INTERACT V4N == 1) NOT INSIDE NODRC
}
GROUP GT4V2 T4V2_?
T4V2_W_1 {
    @ Fixed T4V2 size (square shape),exclude SRINGBLK and GRBLK region. = 0.36,
    ((NOT RECTANGLE (T4V2 NOT GT4V2) == 0.36 BY == 0.36) NOT GRID) NOT INSIDE (SRINGBLK OR NODRC)
    (NOT RECTANGLE (RECTANGLE (T4V2 AND GRID)) == 0.36 BY == 0.36 ) NOT INSIDE (SRINGBLK OR NODRC)
}
T4V2_W_2 {
    @ Fixed T4V2bar width = 0.36,
    T4V2bar WITH WIDTH < 0.36
    T4V2bar WITH WIDTH > 0.36
}
T4V2_S_1 {
    @ Space between two T4V2s >= 0.34
    (EXT T4V2 < 0.34 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
T4V2_S_2 {
    @ Space between T4V2s within array greater or equal to 3x3 (Two via regions whose space is <=0.56um are considered to be in the same array) is >= 0.5
    @ NOTICE: It is a recommended rule.
    X = SIZE T4V2 BY 0.28 OVERUNDER
    Y = SIZE X BY 0.855 UNDEROVER
    Z = T4V2 INSIDE Y
    (EXT Z < 0.5 ABUT < 90 SINGULAR REGION) NOT INSIDE NODRC
}
T4V2_EN_2_EN_3 {
    @ Min M5 fully enclosure of T4V2 >= 0.01
    @ Min M5 enclosure of T4V2 when T4M1 enclosure on one or both perpendicular directions < 0.05um. >= 0.05
    X = RECTANGLE ENC T4V2 M5 ABUT<90 OUTSIDE ALSO GOOD 0.01 OPPOSITE 0.05 OPPOSITE 0.01 OPPOSITE 0.05 OPPOSITE
    (ENC X M5 < 0.01 ABUT<90 SINGULAR REGION OVERLAP OUTSIDE ALSO) NOT INSIDE NODRC
    Y = ENC [X] M5 < 0.05 OPPOSITE
    (INT Y < 0.01 ABUT==90 INTERSECTING ONLY REGION) NOT INSIDE NODRC
    (T4V2 NOT M5) NOT INSIDE NODRC
}
T4V2_EN_5_EN_6 {
    @ Min T4V2 fully enclosure by T4M2 >= 0.02
    (ENC T4V2 T4M2 < 0.02 ABUT < 90 SINGULAR REGION OUTSIDE ALSO) NOT INSIDE NODRC
}

#IFDEF OPEN_RECOMMENDED_ON YES

T4V2_R_1_R {
    @ There should be at least two square T4V2s at the intersection of Mn/T4M1/T2M1 and T4M2 when either metal width >= 0.5um,exclude SRINGBLK and GRBLK region.
    T4V2_SQ = RECTANGLE T4V2 ASPECT == 1
    X1_M5 = M5 ENCLOSE (M5 WITH WIDTH >= 0.5)
    X1_T4M2 = T4M2 ENCLOSE (T4M2 WITH WIDTH >= 0.5)
    M5T4M2 = M5 AND T4M2
    X1 = X1_M5 OR X1_T4M2
    ((M5T4M2 INTERACT T4V2_SQ == 1) INTERACT X1) NOT INSIDE (OR SRINGBLK GRBLK NODRC)
}

#ENDIF

T4V2_R_3 {
    @ 45-dgree T4V2 is not allowed
    ((T4V2 WITH EDGE (ANGLE T4V2 == 45)) NOT INSIDE SRINGBLK) NOT INSIDE NODRC
}

#IFDEF OPEN_RECOMMENDED_ON YES

T4V2_R_4_R {
    @ Recommended us redundant T4V2s as possible, DRC can help to flag single T4V2
    (M5 AND T4M2) INTERACT T4V2 == 1
}

#ENDIF

GROUP GT4M2 T4M2_?
T4M2_W_1 {
    @ T4M2 width ,DRC waive check 89 to 90 degree widths in the INDALL and DEUPAD region >= 0.40
    @ T4M2 width <= 20
    ((INT T4M2 < 0.40 ABUT<90 SINGULAR REGION) NOT INDALL) NOT INSIDE NODRC
    ((INT T4M2 < 0.40 ABUT<89 SINGULAR REGION) AND INDALL) NOT INSIDE NODRC
    X = (T4M2 NOT DEUPAD) WITH WIDTH > 20.00
    ((X NOT INTERACT PA) NOT INDALL) NOT INSIDE NODRC
}
T4M2_S_1 {
    @ Space between T4M2s DRC waive check 89 to 90 degree spaces in the INDALL region. >= 0.40,
    ((EXT T4M2 < 0.40 ABUT<90 SINGULAR REGION) NOT INDALL) NOT INSIDE NODRC
    ((EXT T4M2 < 0.40 ABUT<89 SINGULAR REGION) AND INDALL) NOT INSIDE NODRC
}
T4M2_S_2 {
    @ Space between two T4M2s when one or both T4M2 width or length >= 2um, and the run length of two T4M2s is >= 2um. >= 0.5
    span_edge_0 = DFM COPY (DFM SPACE T4M2ALL < 2 BY INT) EDGE
    span_edge_1 = T4M2ALL NOT COIN EDGE span_edge_0
    span_edge = EXT [span_edge_1] T4M2ALL < 0.5 ABUT < 90 OPPOSITE
    (LENGTH span_edge >= 2) NOT INSIDE EDGE NODRC
}
T4M2_A_1 {
    @ T4M2 area >= 0.40
    (AREA T4M2 < 0.40) NOT INSIDE NODRC
}
T4M2_A_2 {
    @ Enclosed area by T4M2 >= 0.6
    X = (HOLES T4M2 INNER) NOT T4M2
    (AREA X < 0.6) NOT INSIDE NODRC
}

#IFDEF Density_rules YES

T4M2_D_1_min {
    @ T4M2 density (including dummy) in 100umX100um window with step size 50um is >= 20% and <= 85%.
    @ INDALL/GRID/SRINGBLK covered areas are excluded for this rule checking.
    X = DENSITY T4M2ALLi < 0.20 WINDOW 100 STEP 50 backup INSIDE OF LAYER density_checkarea PRINT density_report_T4M2_D_1_min.log
    Y = OR GRID SRINGBLK INDALL
    (X NOT Y) NOT INSIDE NODRC
}
T4M2_D_1_max {
    @ T4M2 density (including dummy) in 100umX100um window with step size 50um is >= 20% and <= 85%.
    @ INDALL/GRID/SRINGBLK covered areas are excluded for this rule checking.
    X = DENSITY T4M2ALLi > 0.85 WINDOW 100 STEP 50 backup INSIDE OF LAYER density_checkarea PRINT density_report_T4M2_D_1_max.log
    Y = OR GRID SRINGBLK INDALL
    (X NOT Y) NOT INSIDE NODRC
}
T4M2_D_2 {
    @ T4M2 density inside (T4M2dumb sizing up 2.5um) in 100umX100um window with step size 50um >= 10%
    CHECK_AREA = SIZE T4M2DUMB BY 2.5
    X = DENSITY T4M2ALLi < 0.10 WINDOW 100 STEP 50 backup INSIDE OF LAYER CHECK_AREA PRINT density_report_T4M2_D_2.log
    X NOT INSIDE NODRC
}
T4M2_D_3 {
    @ T4M2 density difference in 100umX100um window <= 20%.
    @ INDALL/GRID/SRINGBLK covered areas are excluded for this rule checking.
    X = DENSITY T4M2ALLi >0 WINDOW 100 GRADIENT > 0.2 ABSOLUTE BACKUP INSIDE OF LAYER density_checkarea PRINT density_report_T4M2_D_3.log
    Y = OR GRID SRINGBLK INDALL
    (X NOT Y) NOT INSIDE NODRC
}

#ENDIF

GROUP GCB CB_?
CB_W_1 {
    @ CB width >= 3.0um
    ((INT PA < 3 - 0.001 ABUT<90 SINGULAR REGION) NOT INDALL) NOT INSIDE NODRC
    ((INT PA < 3 - 0.001 ABUT<90 SINGULAR REGION) AND INDALL) NOT INSIDE NODRC
}
CB_S_1 {
    @ Space between two CBs >= 5.0um
    ((EXT PA < 5 ABUT<90 SINGULAR REGION) NOT INDALL) NOT INSIDE NODRC
    ((EXT PA < 5 - 0.002 ABUT<90 SINGULAR REGION) AND INDALL) NOT INSIDE NODRC
}
CB_EN_1_EN_2 {
    @ CB edge fully enclosure by T4M1 or T2M1 or T8M1, T4M2 or T2M2 or T8M2 directly underneath PA >= 1.5um
    ((ENC PA (OR T2M1 T4M1 T8M1 T4M2 T2M2 T8M2) < 1.50 ABUT<90 SINGULAR REGION OUTSIDE ALSO) NOT INDALL) NOT INSIDE NODRC
    ((ENC PA (OR T2M1 T4M1 T8M1 T4M2 T2M2 T8M2) < 1.50 - 0.002 ABUT<90 SINGULAR REGION OUTSIDE ALSO) AND INDALL) NOT INSIDE NODRC
}


//===============================
// RV -  RDL via design rules
//===============================

GROUP GRV RV_?

RDV_Fuse = RDLVF OR GRDLV

 
RV_W_1 {
@ Fixed RDL Via width and length = 3.0um
  NOT RECTANGLE ((RDLV NOT RDV_Fuse) NOT GRID) == 3 BY == 3
}
RV_S_1 {
@ Space between two RDL vias >= 3.0um
  (EXT (RDLV NOT RDV_Fuse) < 3 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
RV_S_2 {
@ Space between RDL via and CB >= 6.0um
  ((EXT RDLV PA < 6 ABUT<90 SINGULAR REGION) NOT INDALL) NOT INSIDE NODRC
}
RV_EN_1_2 {
@ RDL via enclosure by T4M2 or other metal layer directly underneath RV >= 1.5um
  X11 = ENC (RDLV NOT RDV_Fuse) (OR T4M2 T2M2 T8M2)< 1.50 ABUT<90 SINGULAR REGION OVERLAP OUTSIDE ALSO
  ((X11 NOT LOGO) NOT GRID) NOT INSIDE NODRC
  
}
RV_EN_3_4 {
@ RDL via enclosure by RDL >= 1.5um
  X11 = ENC (RDLV NOT RDV_Fuse) RDL < 1.50 ABUT<90 SINGULAR REGION OVERLAP OUTSIDE ALSO
  ((X11 NOT LOGO) NOT INSIDE (OR SRINGBLK FUTR GRID)) NOT INSIDE NODRC
  RDLV NOT RDL
}

RV_R_1 {
@ Recommended us redundant RVs as possible, DRC can help to flag single RV
 (((OR T4M2 T2M2 T8M2) AND RDL) NOT SRINGBLK) INTERACT RDLV == 1
}

//==================================================             
//  RDL -  Al RDL (re-distribution layer) Rules DRC
//================================================== 

GROUP GRDL RDL_?

RDL_W_1 {
@ RDL Width >= 3.0um
@ RDL width <= 35um
  ((INT RDL < 3.0 ABUT<90 SINGULAR REGION) NOT INDALL) NOT INSIDE NODRC
  ((INT RDL < 3.0 - 0.002 ABUT<90 SINGULAR REGION) AND INDALL) NOT INSIDE NODRC
  ((RDL WITH WIDTH > 35) NOT INDALL) NOT INSIDE NODRC
}
RDL_S_1 {
@ Space between two (RDL OR ALPAD) >= 2.0um
  ((EXT ALPA < 2.0 ABUT<89.9 SINGULAR REGION) NOT INDALL) NOT INSIDE NODRC
  ((EXT ALPA < 2.0 - 0.002 ABUT<89.9 SINGULAR REGION) AND INDALL) NOT INSIDE NODRC
}
RDL_S_2 {
@ Space between (RDL OR ALPAD) with one or both (RDL OR ALPAD) width larger than 10um >= 3.0um
  X1 = (ALPA WITH WIDTH > 10) COIN EDGE ALPA
  ((EXT X1 ALPA <3.0 REGION) NOT INDALL) NOT INSIDE NODRC
  X2 = (ALPA WITH WIDTH > 10) COIN EDGE ALPA
  ((EXT X2 ALPA <3.0 - 0.002 REGION) AND INDALL) NOT INSIDE NODRC
}
RDL_S_3 {
@ Space between (RDL OR ALPAD) with one or both (RDL OR ALPAD) width larger than 35um >= 5.0um
  X1 = (ALPA WITH WIDTH > 35) COIN EDGE ALPA
  ((EXT X1 ALPA <5.0 REGION) NOT INDALL) NOT INSIDE NODRC
  X2 = (ALPA WITH WIDTH > 35) COIN EDGE ALPA
  ((EXT X2 ALPA <5.0 - 0.002 REGION) AND INDALL) NOT INSIDE NODRC
}
RDL_EN_1 {
@ ALPAD must fully enclosure of Cover
 RDLPA2 NOT ALPA
}

RDL_EN_2 {
@ ALPAD must fully enclosure of CB
  CBi NOT ALPAD
}



//=====================================              
//  COVER -  Passivation Two Rules DRC
//===================================== 
M1SL = (HOLES MET1o EMPTY) INTERACT COVER
M2SL = (HOLES MET2o EMPTY) INTERACT COVER
M3SL = (HOLES MET3o EMPTY) INTERACT COVER
M4SL = (HOLES MET4o EMPTY) INTERACT COVER
M5SL = (HOLES MET5o EMPTY) INTERACT COVER
M6SL = (HOLES MET6o EMPTY) INTERACT COVER
M7SL = (HOLES MET7o EMPTY) INTERACT COVER
M8SL = (HOLES MET8o EMPTY) INTERACT COVER
T2M1SL = (HOLES T2M1o EMPTY) INTERACT COVER
T2M2SL = (HOLES T2M2o EMPTY) INTERACT COVER
T4M1SL = (HOLES T4M1o EMPTY) INTERACT COVER
T4M2SL = (HOLES T4M2o EMPTY) INTERACT COVER
T8M1SL = (HOLES T8M1o EMPTY) INTERACT COVER
T8M2SL = (HOLES T8M2o EMPTY) INTERACT COVER
M1PAD = SIZE ((MET1o INTERACT COVER) OR M1SL) BY 21.499 UNDEROVER
M2PAD = SIZE ((MET2o INTERACT COVER) OR M2SL) BY 21.499 UNDEROVER
M3PAD = SIZE ((MET3o INTERACT COVER) OR M3SL) BY 21.499 UNDEROVER
M4PAD = SIZE ((MET4o INTERACT COVER) OR M4SL) BY 21.499 UNDEROVER
M5PAD = SIZE ((MET5o INTERACT COVER) OR M5SL) BY 21.499 UNDEROVER
M6PAD = SIZE ((MET6o INTERACT COVER) OR M6SL) BY 21.499 UNDEROVER
M7PAD = SIZE ((MET7o INTERACT COVER) OR M7SL) BY 21.499 UNDEROVER
M8PAD = SIZE ((MET8o INTERACT COVER) OR M8SL) BY 21.499 UNDEROVER
T2M1PAD = SIZE ((T2M1 INTERACT COVER) OR T2M1SL) BY 21.499 UNDEROVER
T2M2PAD = SIZE ((T2M2 INTERACT COVER) OR T2M2SL) BY 21.499 UNDEROVER
T4M1PAD = SIZE ((T4M1 INTERACT COVER) OR T4M1SL) BY 21.499 UNDEROVER
T4M2PAD = SIZE ((T4M2 INTERACT COVER) OR T4M2SL) BY 21.499 UNDEROVER
T8M1PAD = SIZE ((T8M1 INTERACT COVER) OR T8M1SL) BY 21.499 UNDEROVER
T8M2PAD = SIZE ((T8M2 INTERACT COVER) OR T8M2SL) BY 21.499 UNDEROVER


GROUP GCOVER COVER_?

COVER_W_1 {
    @ COVER width (suggest to consult with package vendor) >= 40.0um
    ((INT RDLPA2 < 40 - 0.002 ABUT<90 SINGULAR REGION) NOT INDALL) NOT INSIDE (OR SRBLK SRINGBLK NODRC)
    ((INT RDLPA2 < 40 - 0.002 ABUT<90 SINGULAR REGION) AND INDALL) NOT INSIDE (OR SRBLK SRINGBLK NODRC)
}
COVER_L_1 {
    @ COVER length (suggest to consult with package vendor) >= 65.0um
    (NOT ENCLOSE RECTANGLE RDLPA2 40 65) NOT INSIDE (OR SRBLK SRINGBLK NODRC)
}
COVER_S_1 {
    @ Covers space (suggest to consult with package vendor) >= 5.0um
    ((EXT RDLPA2 < 5 - 0.002 ABUT<90 SINGULAR REGION) NOT INDALL) NOT INSIDE (OR SRBLK SRINGBLK NODRC)
    ((EXT RDLPA2 < 5 - 0.002 ABUT<90 SINGULAR REGION) AND INDALL) NOT INSIDE (OR SRBLK SRINGBLK NODRC)
}
COVER_S_2 {
    @ Space between metal pad and metal line >= 2.5um
    ((EXT T8M2PAD T8M2o < 2.5 ABUT>0<90 REGION) NOT INDALL) NOT INSIDE NODRC
    ((EXT T8M1PAD T8M1o < 2.5 ABUT>0<90 REGION) NOT INDALL) NOT INSIDE NODRC
    ((EXT T4M2PAD T4M2o < 2.5 ABUT>0<90 REGION) NOT INDALL) NOT INSIDE NODRC
    ((EXT T4M1PAD T4M1o < 2.5 ABUT>0<90 REGION) NOT INDALL) NOT INSIDE NODRC
    ((EXT T2M2PAD T8M2o < 2.5 ABUT>0<90 REGION) NOT INDALL) NOT INSIDE NODRC
    ((EXT T2M1PAD T8M1o < 2.5 ABUT>0<90 REGION) NOT INDALL) NOT INSIDE NODRC
    ((EXT M1PAD MET1o < 2.5 ABUT>0<90 REGION) NOT INDALL) NOT INSIDE NODRC
    ((EXT M2PAD MET2o < 2.5 ABUT>0<90 REGION) NOT INDALL) NOT INSIDE NODRC
    ((EXT M3PAD MET3o < 2.5 ABUT>0<90 REGION) NOT INDALL) NOT INSIDE NODRC
    ((EXT M4PAD MET4o < 2.5 ABUT>0<90 REGION) NOT INDALL) NOT INSIDE NODRC
    ((EXT M5PAD MET5o < 2.5 ABUT>0<90 REGION) NOT INDALL) NOT INSIDE NODRC
    ((EXT M6PAD MET6o < 2.5 ABUT>0<90 REGION) NOT INDALL) NOT INSIDE NODRC
    ((EXT M7PAD MET7o < 2.5 ABUT>0<90 REGION) NOT INDALL) NOT INSIDE NODRC
    ((EXT M8PAD MET8o < 2.5 ABUT>0<90 REGION) NOT INDALL) NOT INSIDE NODRC
}

COVER_EN_1 {
@ Cover enclosed by ALPAD >= 1.5um
  ((ENC RDLPA2 ALPA < 1.5 ABUT<90 SINGULAR REGION) NOT INDALL) NOT INSIDE NODRC
  ((ENC RDLPA2 ALPA < 1.5-0.002 ABUT<90 SINGULAR REGION) AND INDALL) NOT INSIDE NODRC
}



#IFDEF CHIPEDGE_CHECK YES

GROUP GCHIPEDGE CHIPEDGE_?
BD_EXTENT = EXTENT DRAWN ORIGINAL
BD_EXTENT_OTHER = EXTENT DRAWN ORIGINAL IGNORE CHIPBLK
BD_OTHER_OUTSIDE = BD_EXTENT_OTHER NOT CHIPEDGE
MS_OUT_TEMP1 = (((((((M1i AND SRINGBLK) OR (M2i AND SRINGBLK)) OR (M3i AND SRINGBLK)) OR (M4i AND SRINGBLK)) OR (M5i AND SRINGBLK)) OR (M6i AND SRINGBLK)) OR (M7i AND SRINGBLK)) OR (M8i AND SRINGBLK)
MS_OUT_TEMP2 = ((T4M1i AND SRINGBLK) OR (T4M2i AND SRINGBLK)) OR (RDLi AND SRINGBLK)
MS_OUT = MS_OUT_TEMP1 OR MS_OUT_TEMP2
CHIPEDGE_EN_1 {
    @ Border layer must enclose all chip layout patterns (all chip design, excluding SRINGBLK, SRBLK marking layer)
    @ This rule is not applicable if customers insert seal ring by themselves
    @ This rule checking layer are DNW, AA, NW, PSUB, NVT3, PVT3, NVT1, PVT1, DG, TG, PO, NP, PP, NPR, HRP, ESD1, SAB, CT, Mn(n = 1-8), Vn(n = 1-7), T4V1, T4V2, T4M1, T4M2, T2V1, T2V2, T2M1, T2M2, CB, RV, COVER, RDL, FUSE, AADUM, PODUM, MnDUM(n = 1-8), T4M1DUM, T4M2DUM, T2M1DUM, T2M2DUM. >= 0.37um
    BD_EXTENT_OTHER_temp = EXTENT DRAWN DNWi ACTi NW1i PSUBi NVT3 PVT3 NVT1 PVT1 DGOX TGOX POLYi NPi PPi NPR HRPi ESD1 SABi CTi CTbar MET1o MET2o MET3o MET4o MET5o MET6o MET7o MET8o VIA1i VIA2i VIA3i VIA4i VIA5i VIA6i VIA7i VIA1bar VIA2bar VIA3bar VIA4bar VIA5bar VIA6bar VIA7bar T4V1i T4V2i T4V1bar T4V2bar T4M1o T4M2o T2V1i T2V2i T2V1bar T2V2bar T2M1o T2M2o T8V1i T8V2i T8V1bar T8V2bar T8M1o T8M2o CBi RV COVER RDLi FUTR ACTdmi POLYdmi MET1dmi MET2dmi MET3dmi MET4dmi MET5dmi MET6dmi MET7dmi MET8dmi T4M1dmi T4M2dmi T2M1dmi T2M2dmi T8M1dmi T8M2dmi IGNORE CHIPBLK SRINGBLK SRBLK
    ((ENC BD_EXTENT_OTHER_temp CHIPEDGE < 0.37 ABUT<90 SINGULAR REGION) NOT INTERACT SRINGBLK) NOT INSIDE NODRC
}
CHIPEDGE_EN_2 {
    @ Enclosure of DNW by the chip edge (CHIPEDGE layer) if it need ICsprout to add seal ring. >= 6.0um
    (ENC DNW CHIPEDGE < 6 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
CHIPEDGE_EN_3 {
    @ Enclosure of seal ring outer ring outline edge by CHIPEDGE layer if seal ring has been added by designers. >= 1.5
    (ENC MS_OUT CHIPEDGE < 1.5 ABUT < 90 SINGULAR REGION) NOT INSIDE NODRC
}

#ENDIF


//===========================
//   AAres - AA Resistor DRC
//===========================

GROUP GAAres AAres_?

AAR_SA = AAR AND SAB
AAR_NS = NOT INTERACT AAR SAB


AAres_W_1 {
@ Non-silicide AA resistor width, and it is suggest that AA resistor length/width ratio >1 for stable Rs  >= 0.4um
  X = (AARES AND AA) AND SAB
  L = X INSIDE EDGE AA
  (LENGTH L < 0.4) NOT INSIDE EDGE NODRC
}

AAres_S_1_NP {
@ Space between non-silicide AA resistors area and other implant region >= 0.18um
  X = SDN NOT INTERACT AARES
  (EXT X AAR_SA < 0.18 ABUT<90 REGION) NOT INSIDE NODRC
}
AAres_S_1_PP {
@ Space between non-silicide AA resistors area and other implant region >= 0.18um
  X = SDP NOT INTERACT AARES
  (EXT X AAR_SA < 0.18 ABUT<90 REGION) NOT INSIDE NODRC
}
AAres_S_1_NVT3 {
@ Space between non-silicide AA resistors area and other implant region >= 0.18um
  X = HVTN NOT INTERACT AARES
  (EXT X AAR_SA < 0.18 ABUT<90 REGION) NOT INSIDE NODRC
}
AAres_S_1_PVT3 {
@ Space between non-silicide AA resistors area and other implant region >= 0.18um
  X = HVTP NOT INTERACT AARES
  (EXT X AAR_SA < 0.18 ABUT<90 REGION) NOT INSIDE NODRC
}
AAres_S_1_NVT1 {
@ Space between non-silicide AA resistors area and other implant region >= 0.18um
  X = LVTN NOT INTERACT AARES
  (EXT X AAR_SA < 0.18 ABUT<90 REGION) NOT INSIDE NODRC
}
AAres_S_1_PVT1 {
@ Space between non-silicide AA resistors area and other implant region >= 0.18um
  X = LVTP NOT INTERACT AARES
  (EXT X AAR_SA < 0.18 ABUT<90 REGION) NOT INSIDE NODRC
}
AAres_S_1_ESD {
@ Space between non-silicide AA resistors area and other implant region >= 0.18um
  X = ESD1 NOT INTERACT AARES
  (EXT X AAR_SA < 0.18 ABUT<90 REGION) NOT INSIDE NODRC
}
AAres_S_1_HRP {
@ Space between non-silicide AA resistors area and other implant region >= 0.18um
  X = HRP NOT INTERACT AARES
  (EXT X AAR_SA < 0.18 ABUT<90 REGION) NOT INSIDE NODRC
}
AAres_S_2 {
@ Space between SAB and CT for non-silicide AA resistor = 0.21um
  X = AAR AND SAB
  Y = CT AND (AAR INTERACT SAB)
  ((SIZE Y BY 0.21) NOT TOUCH AAR_SA) NOT INSIDE NODRC
}
AAres_EN_1 {
@ PP/NP enclosure of resistor AA >= 0.18um
  X = SDP OR SDN
  (ENC (AA AND AARES) X < 0.18 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
AAres_EX_1 {
@ Extension of AARES outside of non-silicide AA resistor area >= 0.2um
  (ENC AAR_SA AARES < 0.2 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}

AAres_R_1 {
@ Non-silicide AA resistor region should be covered by SAB and implanted by NP or PP
  X = AAR INTERACT SAB
  (X NOT (OR SDN SDP)) NOT INSIDE NODRC
}
AAres_R_2 {
@ Non-silicide AA resistor with PP must be inside NW
 AARES_SAB = (AARES AND AA) AND SAB  
((AARES_SAB AND SDP) NOT INSIDE NW) NOT INSIDE NODRC
}
AAres_R_3 {
@ It is not allowed dog-bone design at the end of AA resistor for contact pick-up
   X = AAR INTERACT SAB
   (CONVEX EDGE X ==1) NOT INSIDE EDGE NODRC
}

AAres_R_4 {
@ For Silicide AA resistor, two sides of AARES must be along the CT edge
  X = CT AND AAR_NS 
  Y = (AARES NOT INTERACT SAB) INSIDE EDGE AA
  (Y NOT TOUCH EDGE X ) NOT INSIDE EDGE NODRC
}



//====================
//  NWresAA Rules
//====================

GROUP GNWresAA NWresAA_?

NWresAA_W_1 {
@ NW-Resistor width,and suggest NW resistor length/width ratio > 5,length >= 20um for SPICE simulation accuracy >= 1.8 um
 X = ((NW1res AND AA) AND NW) AND SAB
 (LENGTH (X INSIDE EDGE NW) < 1.8) NOT INSIDE EDGE NODRC
}

NWresAA_S_1 {
@ Space between NW of NW resistors and un-related implant region >= 0.60um
 X = NWR INTERACT (HOLES SAB)
 (EXT X (NW NOT INTERACT NWR) < 0.6 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
 (EXT X (HVTN NOT INTERACT NWR) < 0.6 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
 (EXT X (HVTP NOT INTERACT NWR) < 0.6 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
 (EXT X (LVTN NOT INTERACT NWR) < 0.6 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
 (EXT X (LVTP NOT INTERACT NWR) < 0.6 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
 (EXT X (SDN NOT INTERACT NWR) < 0.6 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
 (EXT X (SDP NOT INTERACT NWR) < 0.6 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
 (EXT X (NPR NOT INTERACT NWR) < 0.6 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
 (EXT X (ESD1 NOT INTERACT NWR) < 0.6 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
 (EXT X (HRP NOT INTERACT NWR) < 0.6 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}

NWresAA_S_2 {
@ Space between SAB and CT for NW ressitor = 0.28 um
 X = SIZE (CT AND (AA INTERACT NW1res)) BY 0.28
 Y = SAB INSIDE EDGE (NW INTERACT NW1res)
 Y NOT TOUCH EDGE X
}

NWresAA_S_3 {
@ Space between NW resistor and (NW resistor OR NW) >= 1.2um
  X = NW INTERACT NW1res
 (EXT X NW < 1.2 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}

NWresAA_S_4 {
@ Space between NW resistor and NP = 0
 (NW1res INSIDE EDGE (NW INTERACT (AA ENCLOSE (NW AND NW1res)))) NOT TOUCH EDGE SDN
} 


NWresAA_EN_1 {
@ AA enclosure of NW-Resistor >= 0.90um
 X = ((NW1res AND AA) AND NW) AND SAB
 (ENC X (AA ENCLOSE X) < 0.9 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
NWresAA_EN_2 {
@ SAB enclosure of AA >= 0.20um
 X = ((NW1res AND AA) AND NW) AND SAB
 Y1 = AA ENCLOSE X
 Y2 = SAB NOT COIN EDGE (HOLES SAB)
 (ENC Y1 Y2 < 0.2 ABUT<90 REGION) NOT INSIDE EDGE NODRC
}

NWresAA_EN_3 {
@ Enclosure of SAB and related NW >= 0.28um
 X1 = HOLES SAB
 X2 = SAB TOUCH X1
 (ENC NWR X1 < 0.28 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
 (ENC NWR X2 < 0.28 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
 (((NWR INTERACT X1) NOT X1) NOT SAB) NOT INSIDE NODRC
}

NWresAA_EN_4 {
@ NW enclosure of CT >= 0.28um
 X = ((NW1res AND AA) AND NW) AND SAB
 (ENC (CT AND (HOLES SAB)) (NW ENCLOSE X) < 0.28 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}

NWresAA_EX_1 {
@ Extension of NW1res outside of AA >= 0.20um
  (ENC AA (NW1res INTERACT SAB) < 0.2 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}

NWresAA_O_1 {
@ Overlap of a NP and SAB (SAB INTERACT NW1res) >= 0.38um
X = SAB AND ((AA ENCLOSE NW1res) AND NW)
Y = HOLES (SAB INTERACT X)
SDN_1 = (SDN INTERACT X) AND SAB
(INT SDN_1 < 0.38 ABUT<90 SINGULAR REGION ) NOT INSIDE NODRC
}	

NWresAA_R_1 {
@ NW resistor must be covered by SAB except CT area
  X = NW1res ENCLOSE (NW1res AND AA)
  Y = (SAB OR (HOLES SAB)) INTERACT X
  (Y NOT ENCLOSE (NW1res AND NW)) NOT INSIDE NODRC
}
  
NWresAA_R_2 {
@ recommanded to use rectangle shape resistor for the spice simulation accuracy. DRC flag (NW resistor AND NW) not a rectangle
X = NW1res AND NW
NOT RECTANGLE X
}

NWresAA_R_4 {
@ In one NW resistor
@ 1. There is only one NW is allowed in same AA
@ 2. There is only two NPs are allowed in same AA
@ 3. There is only two SAB holes allowed in same AA
RESNWAA_CHECK = AA ENCLOSE  ((NW1res AND NW) AND SAB)
RESNWAA_CHECK INTERACT NW > 1
RESNWAA_CHECK INTERACT SDN > 2
RESNWAA_CHECK INTERACT SDN == 1
RESNWAA_CHECK INTERACT ((HOLES SAB) INTERACT RESNWAA_CHECK) > 2
}

 
//=======================
//  NWresSTI Rules
//=======================

GROUP GNWresSTI NWresSTI_?

NWRSTI = NWR NOT INTERACT SAB
NWRSTI_L = NWRSTI INSIDE EDGE NW1res
NWRSTI_W = ((NW1res AND NW) NOT INTERACT SAB) INSIDE EDGE NW

NWresSTI_W_1 {
@ NW-Resistor width and suggest NW resistor length/width ratio > 5,length >= 20um for SPICE simulation accuracy >= 1.8um
 X = (NW1res AND NW) NOT INTERACT SAB
 (LENGTH (X INSIDE EDGE NW) < 1.8) NOT INSIDE EDGE NODRC
}
NWresSTI_S_1 {
@ Space between NW resistor and adjacent AA >= 0.50um
 (EXT NWRSTI AA < 0.5 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
NWresSTI_S_2 {
@ Space between NW1res to silicided AA area >= 0.00um
 NWRES AND (AA INTERACT NWRSTI)
}

NWresSTI_S_3 {
@ Space between NW STI resistor and (NW STI resistor OR NW) >= 1.2um.
  X = NW INTERACT NWRSTI
 (EXT X NW < 1.2 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}

NWresSTI_EN_1 {
@ (AA INTERACT NW1res) enclosure CT = 0.28 um
 X = SIZE (CT AND NWRSTI) BY 0.28
 Y = (AA INTERACT X) INSIDE EDGE NWRSTI
 Y NOT TOUCH EDGE X
}

NWresSTI_EN_2 {
@ NP enclosure of AA interact NW1res >= 0.38um
 X = AA AND NWRSTI
 Y = SDN INTERACT NWRSTI
 (ENC X Y < 0.38 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
NWresSTI_EN_3 {
@ NW enclosure of silicide CT >= 0.28um
ENC CT NWRSTI <0.28 SINGULAR REGION
}

NWresSTI_EX_1 {
@ Extension of NW1res outside of NW >= 0.20um
  (ENC NW NW1res < 0.2 ABUT < 90 SINGULAR REGION) NOT INSIDE NODRC
}

NWresSTI_EX_2 {
@ AA extention outside of NW resistor >= 0.28um
 X = AA INTERACT NWRSTI
 Y = NW INTERACT NWRSTI
 (ENC Y X < 0.28 OPPOSITE REGION) NOT INSIDE NODRC
}
NWresSTI_R_1 {
@ NW Resistor must be fully covered by SAB except for CT area
 X = (NW1res AND NW) NOT INTERACT SAB
 (X AND (AA NOT INTERACT CT)) NOT INSIDE NODRC
}
NWresSTI_R_2 {
@ NW1res(ineract with NP) must not overlap with AAdm,POLYdm,PP,ULLD,PVT3,NVT3,PVT1,NVT1,NPR,HRP and ESD
 ((NW1res INTERACT SDN) AND AADUM) NOT INSIDE NODRC
 ((NW1res INTERACT SDN) AND PODUM) NOT INSIDE NODRC
 (NW1res AND HVTN) NOT INSIDE NODRC
 (NW1res AND ULLD) NOT INSIDE NODRC
 (NW1res AND HVTP) NOT INSIDE NODRC
 (NW1res AND LVTN) NOT INSIDE NODRC
 (NW1res AND LVTP) NOT INSIDE NODRC
 (NW1res AND SDP) NOT INSIDE NODRC
 (NW1res AND NPR) NOT INSIDE NODRC
 (NW1res AND ESD1) NOT INSIDE NODRC
 (NW1res AND HRP) NOT INSIDE NODRC
}
NWresSTI_R_3 {
@ recommanded to use rectangle shape resistor for the spice simulation accuracy. DRC flag (NW resistor AND NW) not a rectangle
X = NW1res AND NW
NOT RECTANGLE X
}


//==========================
//  POLYres - Poly Resistor DRC
//==========================

GROUP GPOLYres POLYres_?

POR_SA = POR AND SAB
POR_NS = POR NOT INTERACT SAB

POLYres_W_1 {
@ Width of non-silicide poly resistor >= 0.4um
@ Suggest the Nsq >= 1 for stable Resistivity >= 1
  X = (PORES AND PO) AND SAB
  L = X INSIDE EDGE PO
  (LENGTH L < 0.4) NOT INSIDE EDGE NODRC
  X1 = PORES AND SAB 
  Y1 = (PO AND PORES) AND SAB 
  L1 = (INSIDE EDGE PO X1) OR EDGE (PO COIN EDGE X1)
  W1 = INSIDE EDGE Y1 PO
  (DFM PROPERTY Y1 L1 W1 OVERLAP ABUT ALSO [SQUARES = LENGTH(L1)/LENGTH(W1)] < 1) NOT INSIDE NODRC
}

POLYres_S_1a:PP {
@ Space between N type PO resistors and NP, PP, NPR, HRP, ESD  >= 0.18um
  X = SDP NOT INTERACT PORES
  (EXT X POR_SA < 0.18 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
POLYres_S_1b:NP {
@ Space between P type PO resistors and NP, PP, NPR, HRP, ESD (follow GT.10 rule) >= 0.18um
  X = SDN NOT INTERACT PORES
  (EXT X POR_SA < 0.18 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
POLYres_S_1:ESD {
@ Space between N/P type PO resistors and NP, PP, NPR, HRP, ESD (follow GT.10 rule) >= 0.18um
  X = ESD1 NOT INTERACT PORES
 (EXT X POR_SA < 0.18 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
POLYres_S_1:HRP {
@ Space between N/P type PO resistors and NP, PP, NPR, HRP, ESD (follow GT.10 rule) >= 0.18um
  X = HRP NOT INTERACT PORES
  (EXT X POR_SA < 0.18 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
POLYres_S_1:NPR {
@ Space between N/P type PO resistors and NP, PP, NPR, HRP, ESD (follow GT.10 rule) >= 0.18um
  X = NPR NOT INTERACT PORES
  (EXT X POR_SA < 0.18 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
POLYres_S_2 {
@ Space between SAB and CT for non-silicide poly resistor = 0.21um
  X = POR INTERACT SAB
  Y = CT AND X
  ((SIZE Y BY 0.21) NOT TOUCH POR_SA) NOT INSIDE NODRC
}
POLYres_EN_1 {
@ Enclosure of PP/NP outside of a Poly resistor area >= 0.18um
  X = PORES AND PO
  (ENC X SDN < 0.18 ABUT < 90 SINGULAR REGION) NOT INSIDE NODRC
  (ENC X SDP < 0.18 ABUT < 90 SINGULAR REGION) NOT INSIDE NODRC
}
POLYres_EX_1 {
@ PORES extention outside of PO resistor >= 0.2um
  X = POR_SA COIN EDGE PO
  (ENC X PORES < 0.2 ABUT <90 REGION) NOT INSIDE EDGE NODRC
}
POLYres_EX_2 {
@ Extension of SAB outside of non-silicide poly resistor area(follow SAB.6 rule) >= 0.2um
  (ENC POR SAB < 0.2 ABUT < 90 SINGULAR REGION) NOT INSIDE NODRC
}
POLYres_R_1 {
@ Non-silicide PO resistor must be covered by SAB and implanted by either NP or PP
  X = POR INTERACT SAB
  (X NOT (SDN OR SDP)) NOT INSIDE NODRC
}
POLYres_R_3 {
@ For silicide Poly resistor, two sides of PORES must be along the CT edge
  X = CT AND POR_NS
  Y = (PORES NOT INTERACT SAB) INSIDE EDGE PO
 (Y NOT TOUCH EDGE X) NOT INSIDE EDGE NODRC
}


#IFDEF Poly_EFuse_CHECK YES

//=======================
//    Poly E-Fuse DRC 
//======================

GROUP GEFU EFU_?
EFU_1b_G {
@ FUSEALL (292;12) must interact with EFUSEALL (293;12) region
(FUSEALL NOT INTERACT EFUSEALL) NOT INSIDE NODRC
}
EFU_1c_G {
@ FUSEALL (292;12) must fully cover EFUSEALL (293;12) region
(EFUSEALL NOT FUSEALL) NOT INSIDE NODRC
}
EFU_2b_G {
@ EFUSEALL (293;12) must interact with POEFUSEBLK(294;12)
(EFUSEALL NOT INTERACT POEFUSEBLK) NOT INSIDE NODRC
}
EFU_2c_G {
@ EFUSE (293;12) must fully cover POEFUSEBLK(294;12)
(POEFUSEBLK NOT EFUSEALL) NOT INSIDE NODRC
}
#ENDIF


//==================================
//  HRP - High Resistance Poly DRC
//==================================

GROUP GHRP HRP_?

HRP_W_1 {
@ Width of HRP >= 0.21um
@ It is strongly suggested that the resistor square number (length/width ratio) >= 5 for precise Rs. >= 5
  (INT HRP < 0.21 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
HRP_W_2 {
@ Width of high resistance poly >= 2.00um
  X = (PO INTERACT PO_HRP) NOT COIN EDGE SDP
  (INT X < 2.0 OPPOSITE REGION) NOT INSIDE NODRC
}
HRP_S_1 {
@ Space between two HRP >= 0.21um
  (EXT HRP < 0.21 ABUT < 90 SINGULAR REGION) NOT INSIDE NODRC
}
HRP_S_2 {
@ Space between HRP region and NMOS poly >= 0.16um
@ Space between HRP region and PMOS poly >= 0.16um
  PO_MOS = PO INTERACT GATE
  (EXT HRP PO_MOS < 0.16 ABUT SINGULAR REGION) NOT INSIDE NODRC
}
HRP_S_3 {
@ Fixed Space between SAB and CT in HRP region is 0.21um
  X = HRP INTERACT SAB
  Y = CT AND X
  (SIZE Y BY 0.21) NOT TOUCH (SAB INTERACT HRP)
}
HRP_EN_1 {
@ HRP enclosure of high resistance poly >= 0.20um

  (ENC PO_HRP HRP < 0.20 ABUT SINGULAR REGION) NOT INSIDE NODRC
}
HRP_EX_1 {
@ SAB extension outside of high resistance poly >= 0.22um
  (ENC (PO INTERACT PO_HRP) SAB < 0.22 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
}
HRP_O_1 {
@ PP overlap with SAB = 0.30um
RES_HRP = ((HPR AND HRP) AND PO) AND SAB
 ((INT (SAB INTERACT RES_HRP) SDP < 0.3 ABUT < 90 SINGULAR REGION) NOT INSIDE SRINGBLK) NOT INSIDE SRAMALL
 SDP_CK = SDP INSIDE EDGE (PO INTERACT RES_HRP)
 ((INT (SDP_CK) (SAB INTERACT RES_HRP) <= 0.3 ABUT < 90) NOT INSIDE EDGE SRINGBLK) NOT INSIDE EDGE SRAMALL
}
HRP_R_1 {
@ It is not allowed (NP,PP) overlap HPR region (when checking the rule, size down the HPR by 0.3um along the current direction)
 HRPR    = PO INTERACT HRP
 HRP_END = SIZE (HRPR NOT HPR) BY 0.3
 HRP_MID = HRPR NOT HRP_END
 ((SDN OR SDP) AND HRP_MID) NOT INSIDE NODRC
}
HRP_R_2 {
@ HPR edge should align with SAB edge
 SAB_AND_HRP = (SAB INTERACT HRP) AND PO
 DMY_AND_HRP = HPR AND PO
 (SAB_AND_HRP XOR DMY_AND_HRP) NOT INSIDE NODRC
}


LDAA = AA AND LDMOS
LDPACT = LDAA AND SDP
LDNACT = LDAA AND SDN
LDPGATE = LDPACT AND PO
LDNGATE = LDNACT AND PO
LDPD = (LDPACT NOT INTERACT PO) TOUCH LDMOSSTI
LDND = (LDNACT NOT INTERACT PO) TOUCH LDMOSSTI
LDPS = (LDPACT INTERACT PO) NOT LDPGATE
LDNS = (LDNACT INTERACT PO) NOT LDNGATE
SD_LDMOS = OR LDPD LDND LDPS LDNS
PO_LDMOS = LDPGATE OR LDNGATE
AA_LDMOS = SD_LDMOS OR PO_LDMOS


#IFDEF DUP_CHECK YES


//=========================================
// DEUPAD (Device Under Pad) Pad Guidelines
//=========================================

padarea = DEUPAD AND MD

GROUP GDEUPAD DEUPAD_?
DEUPAD_R_2 {
    @ DEUPAD must fully enclose COVER
    ((MD INTERACT DEUPAD) NOT DEUPAD) NOT INSIDE NODRC
}
DEUPAD_R_3 {
    @ Two top metal layers (TM and TM-1) are needed between DEUPAD and device, where the metal design must be solid.
    ( padarea ENCLOSE (padarea NOT T4M2)) NOT INSIDE NODRC
    ( padarea ENCLOSE (padarea NOT M5)) NOT INSIDE NODRC
}
DEUPAD_R_5 {
    @ ALPADres, MOMLVS1, INDALL, Resistor of TM or TM-1 must be outside of DEUPAD area.
    X1 = (ALPAR OR MOMLVS1) OR INDALL
    X2 = (T4M2R AND T4M2) OR (M5R AND M5)
    ((X1 OR X2) AND padarea) NOT INSIDE NODRC
}
DEUPAD_R_6 {
    @ For one top metal process: TV-1 pattern is not allowed under the DEUPAD opening area
    @ For two top metal process: T4V1 patterns are not allowed under the DEUPAD opening area
    (padarea AND V4) NOT INSIDE NODRC
}
DEUPAD_R_7 {
    @ DEUPAD area must have top via array between (top metal and the top metal directly underneath top metal)
    @ two vias which space is within 0.51um are considerd to be same array
    V_ARRAY_S_REG = EXT T4V2 <= 0.51 SINGULAR REGION
    V_ARRAY = T4V2 INTERACT V_ARRAY_S_REG
    padarea NOT INTERACT V_ARRAY
}

#ENDIF

GROUP GSRCK SRCK_?
DRC1_S = DRC:1 INTERACT SRINGBLK
CTS = CT AND SRINGBLK
CTS_SL = CT AND (ENCLOSE RECTANGLE CTS 0.09 0.27)
CTS_SQ = CTS NOT CTS_SL
AAS = ACTi AND (ACTi ENCLOSE CTS)
M1S = M1i AND SRINGBLK
M1S_INNER = M1S TOUCH (HOLES M1S INNER) == 1
M1S_OUTER = M1S TOUCH (HOLES M1S) == 1
M1S_RING = M1i AND (M1S INTERACT M1S_OUTER)
V1S = V1 AND SRINGBLK
V1S_SL = V1 AND (ENCLOSE RECTANGLE V1S 0.09 0.27)
V1S_SQ = V1S NOT V1S_SL
 
M2S = M2i AND SRINGBLK
M2S_INNER = M2S TOUCH (HOLES M2S INNER) == 1
M2S_OUTER = M2S TOUCH (HOLES M2S) == 1
M2S_RING = M2i AND (M2S INTERACT M2S_OUTER)
V2S = V2 AND SRINGBLK
V2S_SL = V2 AND (ENCLOSE RECTANGLE V2S 0.09 0.27)
V2S_SQ = V2S NOT V2S_SL
 
M3S = M3i AND SRINGBLK
M3S_INNER = M3S TOUCH (HOLES M3S INNER) == 1
M3S_OUTER = M3S TOUCH (HOLES M3S) == 1
M3S_RING = M3i AND (M3S INTERACT M3S_OUTER)
V3S = V3 AND SRINGBLK
V3S_SL = V3 AND (ENCLOSE RECTANGLE V3S 0.09 0.27)
V3S_SQ = V3S NOT V3S_SL
 
M4S = M4i AND SRINGBLK
M4S_INNER = M4S TOUCH (HOLES M4S INNER) == 1
M4S_OUTER = M4S TOUCH (HOLES M4S) == 1
M4S_RING = M4i AND (M4S INTERACT M4S_OUTER)
V4S = V4 AND SRINGBLK
V4S_SL = V4 AND (ENCLOSE RECTANGLE V4S 0.09 0.27)
V4S_SQ = V4S NOT V4S_SL
 
M5S = M5i AND SRINGBLK
M5S_INNER = M5S TOUCH (HOLES M5S INNER) == 1
M5S_OUTER = M5S TOUCH (HOLES M5S) == 1
M5S_RING = M5i AND (M5S INTERACT M5S_OUTER)
T4V2S = T4V2 AND SRINGBLK
T4V2S_SL = T4V2 AND (ENCLOSE RECTANGLE T4V2S 0.36 1.08)
T4V2S_SQ = T4V2S NOT T4V2S_SL
T4M2S = T4M2i AND SRINGBLK
T4M2S_INNER = T4M2S TOUCH (HOLES T4M2S INNER) == 1
T4M2S_OUTER = T4M2S TOUCH (HOLES T4M2S) == 1
T4M2S_RING = T4M2i AND (T4M2S INTERACT T4M2S_OUTER)
 
RDLVS = RDLV AND SRINGBLK
RDLS = RDLi AND SRINGBLK
RDLS_INNER = RDLS TOUCH (HOLES RDLS INNER) == 1
RDLS_OUTER = RDLS TOUCH (HOLES RDLS) == 1
RDLS_RING = RDLi AND (RDLS INTERACT RDLS_OUTER)
RDLPA2S = RDLPA2 AND SRINGBLK
 
MS_RING_INNER = (((((RDLS_INNER OR M1S_INNER) OR M2S_INNER) OR M3S_INNER) OR M4S_INNER) OR M5S_INNER) OR T4M2S_INNER
M_ALL = ((((M1i OR M2i) OR M3i) OR M4i) OR M5i) OR T4M2i
MDUM_ALL = (((MET1dmi OR MET2dmi) OR MET3dmi) OR MET4dmi) OR MET5dmi
MA_ALL = M_ALL NOT INSIDE SRINGBLK
ISOLATION = (((((SRINGBLK AND (HOLES M1S_INNER INNER)) AND (SRINGBLK AND (HOLES M2S_INNER INNER))) AND (SRINGBLK AND (HOLES M3S_INNER INNER))) AND (SRINGBLK AND (HOLES M4S_INNER INNER))) AND (SRINGBLK AND (HOLES M5S_INNER INNER))) AND (SRINGBLK AND (HOLES T4M2S_INNER INNER))
CONNECT AAS M1S_RING BY CTS
CONNECT M1S_RING M2S_RING BY V1S
CONNECT M2S_RING M3S_RING BY V2S
CONNECT M3S_RING M4S_RING BY V3S
CONNECT M4S_RING M5S_RING BY V4S
CONNECT M5S_RING T4M2S_RING BY T4V2S
CONNECT SRINGBLK T4M2S_RING
CONNECT T4M2S_RING RDLS_RING BY RDLVS
SRCK_3_M1 {
    @ Space between outer ring metal and window edge = 2
    ENC M1S_OUTER DRC1_S < 2 ABUT < 90 SINGULAR REGION
    X = DRC1_S NOT (M1S_OUTER OR (HOLES M1S_OUTER))
    Y = SIZE X BY -1
    Z = Y WITH EDGE (ANGLE Y == 45)
    X INTERACT (Y NOT Z)
}
SRCK_3_M2 {
    @ Space between outer ring metal and window edge = 2
    ENC M2S_OUTER DRC1_S < 2 ABUT < 90 SINGULAR REGION
    X = DRC1_S NOT (M2S_OUTER OR (HOLES M2S_OUTER))
    Y = SIZE X BY -1
    Z = Y WITH EDGE (ANGLE Y == 45)
    X INTERACT (Y NOT Z)
}
SRCK_3_M3 {
    @ Space between outer ring metal and window edge = 2
    ENC M3S_OUTER DRC1_S < 2 ABUT < 90 SINGULAR REGION
    X = DRC1_S NOT (M3S_OUTER OR (HOLES M3S_OUTER))
    Y = SIZE X BY -1
    Z = Y WITH EDGE (ANGLE Y == 45)
    X INTERACT (Y NOT Z)
}
SRCK_3_M4 {
    @ Space between outer ring metal and window edge = 2
    ENC M4S_OUTER DRC1_S < 2 ABUT < 90 SINGULAR REGION
    X = DRC1_S NOT (M4S_OUTER OR (HOLES M4S_OUTER))
    Y = SIZE X BY -1
    Z = Y WITH EDGE (ANGLE Y == 45)
    X INTERACT (Y NOT Z)
}
SRCK_3_M5 {
    @ Space between outer ring metal and window edge = 2
    ENC M5S_OUTER DRC1_S < 2 ABUT < 90 SINGULAR REGION
    X = DRC1_S NOT (M5S_OUTER OR (HOLES M5S_OUTER))
    Y = SIZE X BY -1
    Z = Y WITH EDGE (ANGLE Y == 45)
    X INTERACT (Y NOT Z)
}
SRCK_3_T4M2 {
    @ Space between outer ring metal and window edge = 2
    ENC T4M2S_OUTER DRC1_S < 2 ABUT < 90 SINGULAR REGION
    X = DRC1_S NOT (T4M2S_OUTER OR (HOLES T4M2S_OUTER))
    Y = SIZE X BY -1
    Z = Y WITH EDGE (ANGLE Y == 45)
    X INTERACT (Y NOT Z)
}
SRCK_4_M1 {
    @ Space between outer ring metal and inner ring metal = 2
    EXT M1S_INNER M1S_OUTER < 2 ABUT < 90 SINGULAR REGION ANGLED < 1
    X = (HOLES M1S_OUTER) NOT ((HOLES M1S_INNER) OR M1S_INNER)
    X INTERACT (SIZE X BY -1)
}
SRCK_4_M2 {
    @ Space between outer ring metal and inner ring metal = 2
    EXT M2S_INNER M2S_OUTER < 2 ABUT < 90 SINGULAR REGION ANGLED < 1
    X = (HOLES M2S_OUTER) NOT ((HOLES M2S_INNER) OR M2S_INNER)
    X INTERACT (SIZE X BY -1)
}
SRCK_4_M3 {
    @ Space between outer ring metal and inner ring metal = 2
    EXT M3S_INNER M3S_OUTER < 2 ABUT < 90 SINGULAR REGION ANGLED < 1
    X = (HOLES M3S_OUTER) NOT ((HOLES M3S_INNER) OR M3S_INNER)
    X INTERACT (SIZE X BY -1)
}
SRCK_4_M4 {
    @ Space between outer ring metal and inner ring metal = 2
    EXT M4S_INNER M4S_OUTER < 2 ABUT < 90 SINGULAR REGION ANGLED < 1
    X = (HOLES M4S_OUTER) NOT ((HOLES M4S_INNER) OR M4S_INNER)
    X INTERACT (SIZE X BY -1)
}
SRCK_4_M5 {
    @ Space between outer ring metal and inner ring metal = 2
    EXT M5S_INNER M5S_OUTER < 2 ABUT < 90 SINGULAR REGION ANGLED < 1
    X = (HOLES M5S_OUTER) NOT ((HOLES M5S_INNER) OR M5S_INNER)
    X INTERACT (SIZE X BY -1)
}
SRCK_4_T4M2 {
    @ Space between outer ring metal and inner ring metal = 2
    EXT T4M2S_INNER T4M2S_OUTER < 2 ABUT < 90 SINGULAR REGION ANGLED < 1
    X = (HOLES T4M2S_OUTER) NOT ((HOLES T4M2S_INNER) OR T4M2S_INNER)
    X INTERACT (SIZE X BY -1)
}
SRCK_5_M1 {
    @ Metal width of outer ring metal = 2
    INT M1S_OUTER < 2 ABUT < 90 SINGULAR REGION ANGLED < 1
    X = SIZE M1S_OUTER BY -1
    M1S_OUTER INTERACT X
}
SRCK_5_M2 {
    @ Metal width of outer ring metal = 2
    INT M2S_OUTER < 2 ABUT < 90 SINGULAR REGION ANGLED < 1
    X = SIZE M2S_OUTER BY -1
    M2S_OUTER INTERACT X
}
SRCK_5_M3 {
    @ Metal width of outer ring metal = 2
    INT M3S_OUTER < 2 ABUT < 90 SINGULAR REGION ANGLED < 1
    X = SIZE M3S_OUTER BY -1
    M3S_OUTER INTERACT X
}
SRCK_5_M4 {
    @ Metal width of outer ring metal = 2
    INT M4S_OUTER < 2 ABUT < 90 SINGULAR REGION ANGLED < 1
    X = SIZE M4S_OUTER BY -1
    M4S_OUTER INTERACT X
}
SRCK_5_M5 {
    @ Metal width of outer ring metal = 2
    INT M5S_OUTER < 2 ABUT < 90 SINGULAR REGION ANGLED < 1
    X = SIZE M5S_OUTER BY -1
    M5S_OUTER INTERACT X
}
SRCK_5_T4M2 {
    @ Metal width of outer ring = 2
    INT T4M2S_OUTER < 2 ABUT < 90 SINGULAR REGION ANGLED < 1
    X = SIZE T4M2S_OUTER BY -1
    T4M2S_OUTER INTERACT X
}
SRCK_6_M1 {
    @ Metal width of inner ring metal = 4
    INT M1S_INNER < 4 ABUT < 90 SINGULAR REGION ANGLED < 1
    X = SIZE M1S_INNER BY -2
    M1S_INNER INTERACT X
}
SRCK_6_M2 {
    @ Metal width of inner ring metal = 4
    INT M2S_INNER < 4 ABUT < 90 SINGULAR REGION ANGLED < 1
    X = SIZE M2S_INNER BY -2
    M2S_INNER INTERACT X
}
SRCK_6_M3 {
    @ Metal width of inner ring metal = 4
    INT M3S_INNER < 4 ABUT < 90 SINGULAR REGION ANGLED < 1
    X = SIZE M3S_INNER BY -2
    M3S_INNER INTERACT X
}
SRCK_6_M4 {
    @ Metal width of inner ring metal = 4
    INT M4S_INNER < 4 ABUT < 90 SINGULAR REGION ANGLED < 1
    X = SIZE M4S_INNER BY -2
    M4S_INNER INTERACT X
}
SRCK_6_M5 {
    @ Metal width of inner ring metal = 4
    INT M5S_INNER < 4 ABUT < 90 SINGULAR REGION ANGLED < 1
    X = SIZE M5S_INNER BY -2
    M5S_INNER INTERACT X
}
SRCK_6_T4M2 {
    @ Metal width of inner ring = 4
    INT T4M2S_INNER < 4 ABUT < 90 SINGULAR REGION ANGLED < 1
    X = SIZE T4M2S_INNER BY -2
    T4M2S_INNER INTERACT X
}
SRCK_7_RDL {
    @ RDL Clearance to window edge = 4.5
    ENC RDLS_OUTER DRC1_S < 4.5 ABUT < 90 SINGULAR REGION
    X = DRC1_S NOT (RDLS_OUTER OR (HOLES RDLS_OUTER))
    Y = SIZE X BY -2.25
    Z = Y WITH EDGE (ANGLE Y == 45)
    X INTERACT (Y NOT Z)
}
SRCK_8_RDL {
    @ RDL width in seal ring = 5.5
    INT RDLS < 5.5 ABUT < 90 SINGULAR REGION ANGLED < 1
    X = SIZE RDLS BY -2.75
    RDLS INTERACT X
}
SRCK_9_RV {
    @ RV clearance to Window edge = 6.5
    ENC RDLVS DRC1_S < 6.5 ABUT <90 SINGULAR REGION
    X = DRC1_S NOT (RDLVS OR (HOLES RDLVS))
    Y = SIZE X BY -3.25
    Z = Y WITH EDGE (ANGLE Y == 45)
    X INTERACT (Y NOT Z)
}
SRCK_10_RV {
    @ RV slot width = 3
    INT RDLVS < 3 ABUT <90 SINGULAR REGION ANGLED < 1
    X = SIZE RDLVS BY -1.5
    RDLVS INTERACT X
}
SRCK_11a {
    @ Fixed CT bar width = 0.09
    @ NOTICE: It is a guidelines rule.
    INT CTS_SL < 0.09 ABUT<90 SINGULAR REGION ANGLED < 1
    X = SIZE CTS_SL BY -0.045
    CTS_SL INTERACT X
}
SRCK_11b {
    @ Fixed Vn bar width (n=1~7) = 0.09
    @ NOTICE: It is a guidelines rule.
    INT V1S_SL < 0.09 ABUT<90 SINGULAR REGION ANGLED < 1
    V1X = SIZE V1S_SL BY -0.045
    V1S_SL INTERACT V1X
    INT V2S_SL < 0.09 ABUT<90 SINGULAR REGION ANGLED < 1
    V2X = SIZE V2S_SL BY -0.045
    V2S_SL INTERACT V2X
    INT V3S_SL < 0.09 ABUT<90 SINGULAR REGION ANGLED < 1
    V3X = SIZE V3S_SL BY -0.045
    V3S_SL INTERACT V3X
    INT V4S_SL < 0.09 ABUT<90 SINGULAR REGION ANGLED < 1
    V4X = SIZE V4S_SL BY -0.045
    V4S_SL INTERACT V4X
}
SRCK_11d_12e {
    @ TVn(n=1~2,T4Vn,T8Vn) bar width = 0.36
    INT T4V2S_SL < 0.36 ABUT<90 SINGULAR REGION ANGLED < 1
    T4V2X = SIZE T4V2S_SL BY -0.18
    T4V2S_SL INTERACT T4V2X
}
SRCK_13a {
    @ Fixed square CT width and length = 0.09
    @ NOTICE: It is a guidelines rule.
    NOT RECTANGLE CTS_SQ == 0.09 BY == 0.09
}
SRCK_13b_13c {
    @ Fixed Vn width and length (n=1~7) is 0.09
    @ NOTICE: It is a guidelines rule.
    NOT RECTANGLE V1S_SQ == 0.09 BY == 0.09
    NOT RECTANGLE V2S_SQ == 0.09 BY == 0.09
    NOT RECTANGLE V3S_SQ == 0.09 BY == 0.09
    NOT RECTANGLE V4S_SQ == 0.09 BY == 0.09
}
SRCK_13e_13f {
    @ Fixed T4Vn(n=1~2) width and length (for square 4X option and T8V2) = 0.36
    NOT RECTANGLE T4V2S_SQ == 0.36 BY == 0.36
}
SRCK_14a_CT {
    @ Metal enclosure of CT bar >= 0.375
    ENC CTS_SL M1S < 0.375 ABUT < 90 SINGULAR REGION ANGLED < 1
}
SRCK_14b_14c {
    @ etal enclosure of via bar>= 0.375/0.5
    ENC V1S_SL M1S < 0.375 ABUT < 90 SINGULAR REGION ANGLED < 1
    ENC V1S_SL M2S < 0.375 ABUT < 90 SINGULAR REGION ANGLED < 1
    ENC V2S_SL M2S < 0.5 ABUT < 90 SINGULAR REGION ANGLED < 1
    ENC V2S_SL M3S < 0.5 ABUT < 90 SINGULAR REGION ANGLED < 1
    ENC V3S_SL M3S < 0.375 ABUT < 90 SINGULAR REGION ANGLED < 1
    ENC V3S_SL M4S < 0.375 ABUT < 90 SINGULAR REGION ANGLED < 1
    ENC V4S_SL M4S < 0.5 ABUT < 90 SINGULAR REGION ANGLED < 1
    ENC V4S_SL M5S < 0.5 ABUT < 90 SINGULAR REGION ANGLED < 1
}
SRCK_14d_14e_14f {
    @ Min T2M1/T2M2 enclosure of T2V1/T2V2 bar is >= 0.52
    @ Min T4M1/T4M2 enclosure of T4V1/T4V2 bar is >= 0.44
    @ Min T8M1/T8M2 enclosure of T8V1/T8V2 bar is >= 0.44
    @ NOTICE: It is a guidelines rule.
    ENC T4V2S_SL T4M2S < 0.44 ABUT < 90 SINGULAR REGION ANGLED < 1
}
SRCK_15a_CT {
    @ Square CT enclosure by M1 in SRINGBLK outer ring covered areas is >= 0.405
    @ NOTICE: It is a guidelines rule.
    ENC CTS_SQ M1S_OUTER < 0.405 ABUT < 90 SINGULAR REGION ANGLED < 1
}
SRCK_15b_v1 {
    @ Square via enclosure by M1 in SRINGBLK outer ring is >= 0.405
    @ NOTICE: It is a guidelines rule.
    ENC V1S_SQ M1S_OUTER < 0.405 ABUT < 90 SINGULAR REGION ANGLED < 1
}
SRCK_15b_15c {
    @ Square via enclosure by Mn in SRINGBLK outer ring (n=2~7) is >= 0.405
    @ NOTICE: It is a guidelines rule.
    ENC V2S_SQ M2S_OUTER < 0.405 ABUT < 90 SINGULAR REGION ANGLED < 1
    ENC V3S_SQ M3S_OUTER < 0.405 ABUT < 90 SINGULAR REGION ANGLED < 1
    ENC V4S_SQ M4S_OUTER < 0.405 ABUT < 90 SINGULAR REGION ANGLED < 1
}
SRCK_15d_15e_15f {
    @ Min T2M1/T2M2 enclosure of T2V1/T2V2 in SRINGBLK outer ring is >=0.48
    @ Min T4M1/T4M2 enclosure of T4V1/T4V2 in SRINGBLK outer ring is >=0.24
    @ Min T8M1/T8M2 enclosure of T8V1/T8V2 in SRINGBLK outer ring is >=0.24
    @ NOTICE: It is a guidelines rule.
    ENC T4V2S T4M2S < 0.24 ABUT < 90 SINGULAR REGION ANGLED < 1
}
SRCK_16a {
    @ Minimum space between square contact and its bar is >=0.74
    @ NOTICE: It is a guidelines rule.
    EXT CTS_SL CTS_SQ < 0.74 ABUT < 90 OPPOSITE REGION ANGLED < 1
}
SRCK_16b_16c {
    @ Minimum space between square via and its bar is >= 0.6/0.74
    @ NOTICE: It is a guidelines rule.
    SPACE_074_V1S_SL = V1S_SL INTERACT (EXT V1S_SL V1S_SQ < 0.74 ABUT < 90 OPPOSITE REGION ANGLED < 1)
    EXT SPACE_074_V1S_SL V1S_SQ < 0.6 ABUT < 90 OPPOSITE REGION ANGLED < 1
    SPACE_074_V2S_SL = V2S_SL INTERACT (EXT V2S_SL V2S_SQ < 0.74 ABUT < 90 OPPOSITE REGION ANGLED < 1)
    EXT SPACE_074_V2S_SL V2S_SQ < 0.6 ABUT < 90 OPPOSITE REGION ANGLED < 1
    SPACE_074_V3S_SL = V3S_SL INTERACT (EXT V3S_SL V3S_SQ < 0.74 ABUT < 90 OPPOSITE REGION ANGLED < 1)
    EXT SPACE_074_V3S_SL V3S_SQ < 0.6 ABUT < 90 OPPOSITE REGION ANGLED < 1
    SPACE_074_V4S_SL = V4S_SL INTERACT (EXT V4S_SL V4S_SQ < 0.74 ABUT < 90 OPPOSITE REGION ANGLED < 1)
    EXT SPACE_074_V4S_SL V4S_SQ < 0.6 ABUT < 90 OPPOSITE REGION ANGLED < 1
}
SRCK_16d_16e_16f {
    @ Minimum space between square TV and its bar is >=0.6
    @ NOTICE: It is a guidelines rule.
    EXT T4V2S_SL T4V2S_SQ < 0.6 ABUT < 90 OPPOSITE REGION ANGLED < 1
}

#IFDEF Metal_Slot_CHECK YES

GROUP GSL SL_?
SL_W_1_L_1 {
    @ Width of metal lot >= 2um
    @ Length of metal lot >= 4.5um
    (NOT RECTANGLE M1slot >= 2 BY >= 4.5) NOT INSIDE NODRC
    (NOT RECTANGLE M2slot >= 2 BY >= 4.5) NOT INSIDE NODRC
    (NOT RECTANGLE M3slot >= 2 BY >= 4.5) NOT INSIDE NODRC
    (NOT RECTANGLE M4slot >= 2 BY >= 4.5) NOT INSIDE NODRC
    (NOT RECTANGLE M5slot >= 2 BY >= 4.5) NOT INSIDE NODRC
    (NOT RECTANGLE T4M2slot >= 2 BY >= 4.5) NOT INSIDE NODRC
}
SL_S_1 {
    @ Space of metal lot >= 3um
    (EXT M1slot <3 ABUT < 90 SINGULAR REGION) NOT INSIDE NODRC
    (EXT M2slot <3 ABUT < 90 SINGULAR REGION) NOT INSIDE NODRC
    (EXT M3slot <3 ABUT < 90 SINGULAR REGION) NOT INSIDE NODRC
    (EXT M4slot <3 ABUT < 90 SINGULAR REGION) NOT INSIDE NODRC
    (EXT M5slot <3 ABUT < 90 SINGULAR REGION) NOT INSIDE NODRC
    (EXT T4M2slot <3 ABUT < 90 SINGULAR REGION) NOT INSIDE NODRC
}
SL_R_1 {
    @ The top-metal slot overlap CB is not allowed
    M1slot AND PA
    M2slot AND PA
    M3slot AND PA
    M4slot AND PA
    M5slot AND PA
    T4M2slot AND PA
}

#ENDIF

AADUM_3_3 = RECTANGLE AADUM ==3 BY == 3
AADUM_1_1 = RECTANGLE AADUM ==1 BY == 1
AADUM_0p5_0p5 = RECTANGLE AADUM ==0.467 BY ==0.467
AADUM_W_1 {
    @ AADUM SIZE = 3x3, 1x1, 0.467x0.467
    ((AADUM NOT AADUM_3_3) NOT AADUM_1_1) NOT AADUM_0p5_0p5
}
AADUM_S_1 {
    @ AADUM space if AADUM size is 3um*3um >= 2
    EXT AADUM_3_3 < 2 ABUT <90 SINGULAR REGION
}
AADUM_S_2 {
    @ AADUM space if AADUM size is 1um*1um >= 0.6
    EXT AADUM_1_1 < 0.6 ABUT <90 SINGULAR REGION
}
AADUM_S_3 {
    @ AADUM space if AADUM size is 0.467um*0.467um >= 0.28
    EXT AADUM_0p5_0p5 < 0.28 ABUT <90 SINGULAR REGION
}
AADUM_S_4 {
    @ Space between AADUM and AA, AADUM can not overlap with AA >= 1.6
    EXT AADUM AA < 1.6 ABUT <90 SINGULAR REGION
    AADUM AND AA
}
AADUM_S_5 {
    @ Space between AADUM and Poly, AADUM can not overlap with Poly >= 1.6
    EXT AADUM PO < 1.6 ABUT <90 SINGULAR REGION
    AADUM AND PO
}
AADUM_S_6 {
    @ Space between AADUM and NW boundary >= 0.3
    EXT AADUM NW < 0.3 ABUT < 90 SINGULAR REGION
    ENC AADUM NW < 0.3 ABUT < 90 SINGULAR REGION
}
AADUM_S_7 {
    @ Space between AADUM and FUSEALL >= 2
    EXT AADUM FUSEALL < 2 ABUT < 90 SINGULAR REGION
}
AADUM_S_8 {
    @ Space between AADUM and NW1res >= 0.6
    EXT AADUM NW1res < 0.6 ABUT < 90 SINGULAR REGION
}
AADUM_S_9 {
    @ Space between AADUM and LOGO >= 0.1
    EXT AADUM LOGO < 0.1 ABUT < 90 SINGULAR REGION
}
AADUM_S_10 {
    @ Space between AADUM and INDALL >= 2
    EXT AADUM INDALL < 2 ABUT < 90 SINGULAR REGION
}
AADUM_S_11 {
    @ Space between AADUM and Frame boundary >= 0.6
    EXT AADUM CHIPBLK < 0.6 ABUT < 90 SINGULAR REGION
    ENC AADUM CHIPBLK < 0.6 ABUT < 90 SINGULAR REGION
}
AADUM_S_12 {
    @ Space between AADUM and AADUMB >= 2
    EXT AADUM AADUMB < 2 ABUT < 90 SINGULAR REGION
}
AADUM_S_13 {
    @ Space between AADUM and DMYBLK >= 2
    EXT AADUM DMYBLK < 2 ABUT < 90 SINGULAR REGION
}
AADUM_R_1 {
    @ AADUM can not overlap with CT
    AADUM AND CT
}
PODUM_2p4_2p4 = RECTANGLE PODUM == 2.4 BY == 2.4
PODUM_0p92_0p92 = RECTANGLE PODUM == 0.92 BY == 0.92
PODUM_0p381_0p381 = RECTANGLE PODUM == 0.381 BY ==0.381
PODUM_W_1 {
    @ PODUM SIZE = 2.4x2.4, 0.92x0.92, 0.381x0.381
    ((PODUM NOT PODUM_2p4_2p4) NOT PODUM_0p92_0p92) NOT PODUM_0p381_0p381
}
PODUM_S_1 {
    @ PODUM space if PODUM size is 2.4um*2.4um >= 2.6
    EXT PODUM_2p4_2p4 < 2.6 ABUT <90 SINGULAR REGION
}
PODUM_S_2 {
    @ PODUM space if PODUM size is 0.92um*0.92um >= 0.68
    EXT PODUM_0p92_0p92 < 0.68 ABUT <90 SINGULAR REGION
}
PODUM_S_3 {
    @ PODUM space if PODUM size is 0.381um*0.381um >= 0.36
    EXT PODUM_0p381_0p381 < 0.36 ABUT <90 SINGULAR REGION
}
PODUM_S_4 {
    @ Space between PODUM and AA, PODUM can not overlap with AA >= 0.8
    EXT PODUM AA < 0.8 ABUT <90 SINGULAR REGION
    PODUM AND AA
}
PODUM_S_5 {
    @ Space between PODUM and Poly, PODUM can not overlap with Poly >= 0.8
    EXT PODUM PO < 0.8 ABUT <90 SINGULAR REGION
    PODUM AND PO
}
PODUM_S_6 {
    @ Space between PODUM and NW boundary >= 0.3
    EXT PODUM NW < 0.3 ABUT < 90 SINGULAR REGION
    ENC PODUM NW < 0.3 ABUT < 90 SINGULAR REGION
}
