M1DUM_2_2 = RECTANGLE M1DUM == 2 BY == 2
M1DUM_1_1 = RECTANGLE M1DUM == 1 BY == 1
M1DUM_0p22_0p89 = RECTANGLE M1DUM == 0.22 BY == 0.89
M1DUM_W_1 {
    @ Mndm SIZE = 2x2, 1x1, 0.22x0.89
    ((M1DUM NOT M1DUM_2_2) NOT M1DUM_1_1) NOT M1DUM_0p22_0p89
}
M1DUM_S_1 {
    @ Mndm space if Mndm size is 2um*2um >= 0.8um
    EXT M1DUM_2_2 < 0.8 ABUT <90 SINGULAR REGION
}
M1DUM_S_2 {
    @ Space between Mndm and M if Mndm size is 2um*2um >= 10um
    EXT M1 M1DUM_2_2 < 10 ABUT <90 SINGULAR REGION
}
