    (ENC X M4 < 0.005 ABUT<90 SINGULAR REGION OVERLAP OUTSIDE ALSO) NOT INSIDE NODRC
    Y = ENC [X] M4 < 0.02 OPPOSITE
    (INT Y < 0.01 ABUT==90 INTERSECTING ONLY REGION) NOT INSIDE NODRC
    (V3 NOT M4) NOT INSIDE NODRC
}

#IFDEF OPEN_RECOMMENDED_ON YES

V3_R_2a_2b {
    @ There should be at least 2(Via with space <= 0.2um) or 4(Via with space <= 0.25um) at the intersection of Mn and Mn+1, when either Mn or Mn+1 width > 0.3um
    @ There should be at least 4(Via with space <= 0.2um) or 9(Via with space <= 0.55um) at the intersection of Mn and Mn+1, when either Mn or Mn+1 width > 0.7um
    w03b = M3 WITH WIDTH > 0.3
    w03u = M4 WITH WIDTH > 0.3
    w03 = M3 AND M4
    wide03 = ((w03 ENCLOSE (V3 NOT OUTSIDE w03b)) OR (w03 ENCLOSE (V3 NOT OUTSIDE w03u))) NOT wide07
    wide03v2s = SIZE (V3 INTERACT wide03) BY 0.1 INSIDE OF wide03 STEP 0.05
    wide03v4s = SIZE (V3 INTERACT wide03) BY 0.125 INSIDE OF wide03 STEP 0.05
    wide03v2 = wide03v2s INTERACT V3 >= 2
    wide03v4 = wide03v4s INTERACT V3 >= 4
    (wide03 NOT INTERACT (wide03v2 OR wide03v4)) NOT INSIDE NODRC
    w07b = M3 WITH WIDTH > 0.7
    w07u = M4 WITH WIDTH > 0.7
    w07 = M3 AND M4
    wide07 = (w07 ENCLOSE (V3 NOT OUTSIDE w07b)) OR (w07 ENCLOSE (V3 NOT OUTSIDE w07u))
    wide07v4s = SIZE (V3 INTERACT wide07) BY 0.1 INSIDE OF wide07 STEP 0.05
    wide07v9s = SIZE (V3 INTERACT wide07) BY 0.275 INSIDE OF wide07 STEP 0.05
    wide07v4 = wide07v4s INTERACT V3 >= 4
    wide07v9 = wide07v9s INTERACT V3 >= 9
    (wide07 NOT INTERACT (wide07v4 OR wide07v9)) NOT INSIDE NODRC
