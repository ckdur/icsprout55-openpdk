all_pad_vdd_T8M2 = WITH TEXT T8M2 ?VDD? T8M2text
all_pad_vss_T8M2 = WITH TEXT T8M2 ?VSS? T8M2text
all_pad_vcc_T8M2 = WITH TEXT T8M2 ?VCC? T8M2text
