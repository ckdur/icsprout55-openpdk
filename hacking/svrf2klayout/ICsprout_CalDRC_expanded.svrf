    X0_a = M7ALL WITH WIDTH >= 1.5
    X0 = ENCLOSE RECTANGLE X0_a 1.5 1.5
    X1 = EXT M7ALL < 0.6 OPPOSITE REGION PARA ONLY
    X2 = LENGTH X1 >= 1.5
    X3 = X2 TOUCH EDGE X0
