LAYER MET1o 81
LAYER SRINGBLK 354
LAYER MAP 81 DATATYPE 1 81
LAYER MAP 354 DATATYPE 13 354
LAYER ALLD 999
LAYER MAP 354 DATATYPE 12 999
LAYER MAP 2 DATATYPE 1 999
DRC1 = EXTENT DRAWN ORIGINAL
DRC1_S = DRC1 INTERACT SRINGBLK
M1S = MET1o AND SRINGBLK
M1S_OUTER = M1S TOUCH (HOLES M1S) == 1
X = DRC1_S NOT (M1S_OUTER OR (HOLES M1S_OUTER))
Y = SIZE X BY -1
Z = Y WITH EDGE (ANGLE Y == 45)
R_DRC1S { COPY DRC1_S }
R_OUTER { COPY M1S_OUTER }
R_HOLE { HOLES M1S_OUTER }
R_X { COPY X }
R_Y { COPY Y }
R_Z { COPY Z }
R_YNZ { Y NOT Z }
R_OUT { X INTERACT (Y NOT Z) }
