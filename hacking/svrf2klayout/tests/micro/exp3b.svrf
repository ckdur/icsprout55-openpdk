LAYER V1 7
LAYER M2 8
R1 {
    X = RECTANGLE ENC V1 M2 ABUT<90 OUTSIDE ALSO GOOD 0.005 OPPOSITE 0.02 OPPOSITE 0.005 OPPOSITE 0.02 OPPOSITE
    ENC X M2 < 0.005 ABUT<90 SINGULAR REGION OVERLAP OUTSIDE ALSO
}
R2 {
    X = RECTANGLE ENC V1 M2 ABUT<90 OUTSIDE ALSO GOOD 0.005 OPPOSITE 0.02 OPPOSITE 0.005 OPPOSITE 0.02 OPPOSITE
    Y = ENC [X] M2 < 0.02 OPPOSITE
    INT Y < 0.01 ABUT==90 INTERSECTING ONLY REGION
}
R3 { ENC V1 M2 < 0.005 ABUT<90 SINGULAR REGION OVERLAP OUTSIDE ALSO }
R4 { ENC V1 M2 < 0.005 ABUT<90 REGION }
R5 { ENC V1 M2 < 0.005 ABUT<90 SINGULAR REGION }
