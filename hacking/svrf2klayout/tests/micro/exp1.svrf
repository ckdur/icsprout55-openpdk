LAYER A 1
LAYER B 2
LAYER L 3
LAYER H 4
LAYER C1 5
LAYER C2 6
LAYER V 7
LAYER M 8
LAYER R 9
LAYER Q 10
LAYER S 11
I_LT4 { A INTERACT B < 4 }
I_EQ0 { A INTERACT B == 0 }
WW_GE1 { L WITH WIDTH >= 1 }
WW_LT1 { L WITH WIDTH < 1 }
HOL { HOLES H }
HOL_IN { HOLES H INNER }
HOL_E { HOLES H EMPTY }
CUT1 { C1 CUT C2 }
CUT2 { C2 CUT C1 }
EXTS { EXT S < 0.2 }
EXTS_SQ { EXT S < 0.2 SQUARE }
RE { RECTANGLE ENC V M ABUT<90 OUTSIDE ALSO GOOD 0 0.04 OPPOSITE 0 0.04 OPPOSITE GOOD 0.03 0.03 0.03 0.03 OPPOSITE }
ER { ENCLOSE RECTANGLE R 0.1 0.3 }
RB { RECTANGLE Q == 0.09 BY == 0.3 }
RB2 { RECTANGLE Q == 0.3 BY == 0.09 }
TE { L TOUCH EDGE (L WITH EDGE (LENGTH L == 0.5)) }
CC { EXT L < 0.01 ABUT == 90 INTERSECTING ONLY REGION }
CCI { INT L < 0.01 ABUT == 90 INTERSECTING ONLY REGION }
CE0 { CONVEX EDGE L == 0 }
CE1 { CONVEX EDGE L == 1 }
CE2 { CONVEX EDGE L == 2 }
EE { EXPAND EDGE (LENGTH L == 3) INSIDE BY 0.1 }
EE2 { EXPAND EDGE (LENGTH L == 3) OUTSIDE BY 0.1 EXTEND BY 0.05 }
SZ { SIZE S BY 0.3 }
EXTN { EXTENT DRAWN ORIGINAL }
