RDV = OR RV CB


M1  = MET1i NOT MET1sloti
M2  = MET2i NOT MET2sloti
M3  = MET3i NOT MET3sloti
M4  = MET4i NOT MET4sloti
M5  = MET5i NOT MET5sloti
M6  = MET6i NOT MET6sloti
M7  = MET7i NOT MET7sloti
M8  = MET8i NOT MET8sloti

T4M1 = T4M1i NOT T4M1sloti
T4M2 = T4M2i NOT T4M2sloti
T2M1 = T2M1i NOT T2M1sloti
T2M2 = T2M2i NOT T2M2sloti
T8M1 = T8M1i NOT T8M1sloti
T8M2 = T8M2i NOT T8M2sloti


CT1  = OR CT CTbar
VIA1  = OR VIA1i VIA1bar
VIA2  = OR VIA2i VIA2bar
VIA3  = OR VIA3i VIA3bar
VIA4  = OR VIA4i VIA4bar
VIA5  = OR VIA5i VIA5bar
VIA6  = OR VIA6i VIA6bar
VIA7  = OR VIA7i VIA7bar
T2V1 = OR T2V1i T2V1bar
T2V2 = OR T2V2i T2V2bar
T4V1 = OR T4V1i T4V1bar
T4V2 = OR T4V2i T4V2bar
T8V1 = OR T8V1i T8V1bar
T8V2 = OR T8V2i T8V2bar


AA  = COPY ACTi
PO  = COPY POLYi

//GATE = PO AND AA
GATE = (PO AND AA) INTERACT SD_1 == 2
SD_1 = AA NOT PO

SD = ((NPi OR PPi) AND AA) NOT PO

GATE18 = GATE AND DGOX
GATE1825 = GATE AND (DGOX OR TGOX)

DRC INCREMENTAL CONNECT YES



CONNECT PO GATE
CONNECT PO GATE18
CONNECT PO GATE1825
AR_1 {
    @ Max. (Poly area / gate area) is 250
    NET AREA RATIO PO GATE > 250
    [ AREA(PO) / AREA(GATE) ]
    RDB AR_1.rep PO GATE
}
AR_2 {
    @ Max. (Poly perim*thickness / gate area) is 500
    NET AREA RATIO PO GATE > 500
    [ PERIMETER(PO) * 0.10 / AREA(GATE) ]
    RDB AR_2.rep PO GATE
}
CONNECT CT1 PO
AR_3 {
    @ Max. (contact area / gate area) is 10
    NET AREA RATIO CT1 GATE > 10
    [ AREA(CT1) / AREA(GATE) ]
    RDB AR_3.rep CT1 GATE
}
CONNECT M1 PO SD BY CT1
M1_DIO = NET AREA SD >0
CONNECT M1 M1_DIO BY CT1
AR_5_10_M1 {
    @ Max. (M1 area / gate area) is 5000 (without effective diode)
    @ Max. (M1 area / gate area) is Ratio Equation (with effective diode)
    A1 = NET AREA RATIO PO M1 M1_DIO GATE > 5000 ACCUMULATE [ AREA(M1)/AREA(GATE) -(AREA(M1_DIO)*500 + !!AREA(M1_DIO)*38000) ]
    RDB AR_5_10_M1.rep PO M1 M1_DIO GATE
    COPY A1
    NET AREA RATIO PRINT A1 M1.rpt
}
AR18_5_10_M1 {
    @ Max. (M1 area / 1.8v gate area) is 1000 (without effective diode)
    @ Max. (M1 area / 1.8v gate area) is Ratio Equation (with effective diode)
    A1_18 = NET AREA RATIO PO M1 M1_DIO GATE18 > 1000 ACCUMULATE [ AREA(M1)/AREA(GATE18) -(AREA(M1_DIO)*500 + !!AREA(M1_DIO)*42000) ]
    RDB AR18_5_10_M1.rep PO M1 M1_DIO GATE18
    COPY A1_18
    NET AREA RATIO PRINT A1_18 M1_18.rpt
}
CONNECT VIA1 M1
AR_4_VIA1 {
    @ (VIA1 area / gate area) > 20 (without effective diode)
    @ (VIA1 area / gate area) > Ratio Equation (with effective diode)
    @ single layer Via area to the active poly gate area, no accumulate
    AVIA1_no_accumulate = NET AREA RATIO PO M1 VIA1 M1_DIO GATE > 20 [ AREA(VIA1)/AREA(GATE)-(AREA(M1_DIO)*150 + !!AREA(M1_DIO)*980) ]
    RDB AR_4_VIA1.rep PO M1 VIA1 M1_DIO GATE
    COPY AVIA1_no_accumulate
}
AR_6_9_VIA1 {
    @ (VIA1 area / gate area) > 50 (without effective diode)
    @ (VIA1 area / gate area) > Ratio Equation (with effective diode)
    AVIA1 = NET AREA RATIO PO M1 VIA1 M1_DIO GATE > 50 ACCUMULATE [ AREA(VIA1)/AREA(GATE) -(AREA(M1_DIO)*250 + !!AREA(M1_DIO)*850) ]
    RDB AR_6_VIA1.rep PO M1 VIA1 M1_DIO GATE
    COPY AVIA1
}
AC1 = NET AREA RATIO M1 GATE >=0 ACCUMULATE
AC1_18 = NET AREA RATIO M1 GATE18 >=0 ACCUMULATE
AC1_V = NET AREA RATIO VIA1 GATE >=0 ACCUMULATE
CONNECT M2 M1 BY VIA1
M2_DIO = NET AREA SD >0
CONNECT M1 M2_DIO BY CT1
AR_5_10_M2 {
    @ Max. (M2 area / gate area) is 5000 (without effective diode)
    @ Max. (M2 area / gate area) is Ratio Equation (with effective diode)
    A2 = NET AREA RATIO PO M1 M2 M2_DIO GATE > 5000 ACCUMULATE AC1 [ AREA(M2)/AREA(GATE) -(AREA(M2_DIO)*500 + !!AREA(M2_DIO)*38000) ]
    RDB AR_5_10_M2.rep PO M1 M2 M2_DIO GATE
    COPY A2
    NET AREA RATIO PRINT A2 M2.rpt
}
AR18_5_10_M2 {
    @ Max. (M2 area / 1.8v gate area) is 1000 (without effective diode)
    @ Max. (M2 area / 1.8v gate area) is Ratio Equation (with effective diode)
    A2_18 = NET AREA RATIO PO M1 M2 M2_DIO GATE18 > 1000 ACCUMULATE AC1_18 [ AREA(M2)/AREA(GATE18) -(AREA(M2_DIO)*500 + !!AREA(M2_DIO)*42000) ]
    RDB AR18_5_10_M2.rep PO M1 M2 M2_DIO GATE18
    COPY A2_18
    NET AREA RATIO PRINT A2_18 M2_18.rpt
}
CONNECT M2 VIA2
AR_4_VIA2 {
    @ (VIA2 area / gate area) > 20 (without effective diode)
    @ (VIA2 area / gate area) > Ratio Equation (with effective diode)
    @ single layer Via area to the active poly gate area, no accumulate
    AV2_no_accumulate = NET AREA RATIO PO M1 M2 VIA2 M2_DIO GATE > 20 [ AREA(VIA2)/AREA(GATE) - (AREA(M2_DIO)*150 + !!AREA(M2_DIO)*980) ]
    RDB AR_4_V2.rep PO M1 M2 VIA2 M2_DIO GATE
    COPY AV2_no_accumulate
}
AR_6_9_VIA2 {
    @ (VIA2 area / gate area) > 50 (without effective diode)
    @ (VIA2 area / gate area) > Ratio Equation (with effective diode)
    AVIA2 = NET AREA RATIO PO M1 M2 VIA2 M2_DIO GATE > 50 ACCUMULATE AC1_V [ AREA(VIA2)/AREA(GATE) - (AREA(M2_DIO)*250 + !!AREA(M2_DIO)*850) ]
    RDB AR_6_9_VIA2.rep PO M1 M2 VIA2 M2_DIO GATE
    COPY AVIA2
}
AC2 = NET AREA RATIO M2 GATE >=0 ACCUMULATE AC1
AC2_18 = NET AREA RATIO M2 GATE18 >=0 ACCUMULATE AC1_18
AC2_V = NET AREA RATIO VIA2 GATE >=0 ACCUMULATE AC1_V
CONNECT M3 M2 BY VIA2
M3_DIO = NET AREA SD >0
CONNECT M1 M3_DIO BY CT1
AR_5_10_M3 {
    @ Max. (M3 area / gate area) is 5000 (without effective diode)
    @ Max. (M3 area / gate area) is Ratio Equation (with effective diode)
    A3 = NET AREA RATIO PO M1 M2 M3 M3_DIO GATE > 5000 ACCUMULATE AC2 [ AREA(M3)/AREA(GATE) - (AREA(M3_DIO)*500 + !!AREA(M3_DIO)*38000)]
    RDB AR_5_10_M3.rep PO M1 M2 M3 M3_DIO GATE
    COPY A3
    NET AREA RATIO PRINT A3 M3.rpt
}
AR18_5_10_M3 {
    @ Max. (M3 area / 1.8v gate area) is 1000 (without effective diode)
    @ Max. (M3 area / 1.8v gate area) is Ratio Equation (with effective diode)
    A3_18 = NET AREA RATIO PO M1 M2 M3 M3_DIO GATE18 > 1000 ACCUMULATE AC2_18 [ AREA(M3)/AREA(GATE18) -(AREA(M3_DIO)*500 + !!AREA(M3_DIO)*42000) ]
    RDB AR18_5_10_M3.rep PO M1 M2 M3 M3_DIO GATE18
    COPY A3_18
    NET AREA RATIO PRINT A3_18 M3_18.rpt
}
CONNECT M3 VIA3
AR_4_VIA3 {
    @ (VIA3 area / gate area) > 20 (without effective diode)
    @ (VIA3 area / gate area) > Ratio Equation (with effective diode)
    @ single layer Via area to the active poly gate area, no accumulate
    AV3_no_accumulate = NET AREA RATIO PO M1 M2 M3 VIA3 M3_DIO GATE > 20 [ AREA(VIA3)/AREA(GATE) - (AREA(M3_DIO)*150 + !!AREA(M3_DIO)*980) ]
    RDB AR_4_V3.rep PO M1 M2 M3 VIA3 M3_DIO GATE
    COPY AV3_no_accumulate
}
AR_6_9_VIA3 {
    @ (VIA3 area / gate area) > 50 (without effective diode)
    @ (VIA3 area / gate area) > Ratio Equation (with effective diode)
    AVIA3 = NET AREA RATIO PO M1 M2 M3 VIA3 M3_DIO GATE > 50 ACCUMULATE AC2_V [ AREA(VIA3)/AREA(GATE) - (AREA(M3_DIO)*250 + !!AREA(M3_DIO)*850) ]
    RDB AR_6_9_VIA3.rep PO M1 M2 M3 VIA3 M3_DIO GATE
    COPY AVIA3
}
AC3 = NET AREA RATIO M3 GATE >=0 ACCUMULATE AC2
AC3_18 = NET AREA RATIO M3 GATE18 >=0 ACCUMULATE AC2_18
AC3_V = NET AREA RATIO VIA3 GATE >=0 ACCUMULATE AC2_V
CONNECT M4 M3 BY VIA3
M4_DIO = NET AREA SD >0
CONNECT M1 M4_DIO BY CT1
AR_5_10_M4 {
    @ Max. (M4 area / gate area) is 5000 (without effective diode)
    @ Max. (M4 area / gate area) is Ratio Equation (with effective diode)
    A4 = NET AREA RATIO PO M1 M2 M3 M4 M4_DIO GATE > 5000 ACCUMULATE AC3 [ AREA(M4)/AREA(GATE) - (AREA(M4_DIO)*500 + !!AREA(M4_DIO)*38000)]
    RDB AR_5_10_M4.rep PO M1 M2 M3 M4 M4_DIO GATE
    COPY A4
    NET AREA RATIO PRINT A4 M4.rpt
}
AR18_5_10_M4 {
    @ Max. (M4 area / 1.8v gate area) is 1000 (without effective diode)
    @ Max. (M4 area / 1.8v gate area) is Ratio Equation (with effective diode)
    A4_18 = NET AREA RATIO PO M1 M2 M3 M4 M4_DIO GATE18 > 1000 ACCUMULATE AC3_18 [ AREA(M4)/AREA(GATE18) -(AREA(M4_DIO)*500 + !!AREA(M4_DIO)*42000) ]
    RDB AR18_5_10_M4.rep PO M1 M2 M3 M4 M4_DIO GATE18
    COPY A4_18
    NET AREA RATIO PRINT A4_18 M4_18.rpt
}
CONNECT M4 VIA4
AR_4_VIA4 {
    @ (VIA4 area / gate area) > 20 (without effective diode)
    @ (VIA4 area / gate area) > Ratio Equation (with effective diode)
    @ single layer Via area to the active poly gate area, no accumulate
    AV4_no_accumulate = NET AREA RATIO PO M1 M2 M3 M4 VIA4 M4_DIO GATE > 20 [ AREA(VIA4)/AREA(GATE) - (AREA(M4_DIO)*150 + !!AREA(M4_DIO)*980) ]
    RDB AR_4_V4.rep PO M1 M2 M3 M4 VIA4 M4_DIO GATE
    COPY AV4_no_accumulate
}
AR_6_9_VIA4 {
    @ (VIA4 area / gate area) > 50 (without effective diode)
    @ (VIA4 area / gate area) > Ratio Equation (with effective diode)
    AVIA4 = NET AREA RATIO PO M1 M2 M3 M4 VIA4 M4_DIO GATE > 50 ACCUMULATE AC3_V [ AREA(VIA4)/AREA(GATE) - (AREA(M4_DIO)*250 + !!AREA(M4_DIO)*850) ]
    RDB AR_6_9_VIA4.rep PO M1 M2 M3 M4 VIA4 M4_DIO GATE
    COPY AVIA4
}
AC4 = NET AREA RATIO M4 GATE >=0 ACCUMULATE AC3
AC4_18 = NET AREA RATIO M4 GATE18 >=0 ACCUMULATE AC3_18
AC4_V = NET AREA RATIO VIA4 GATE >=0 ACCUMULATE AC3_V
CONNECT M5 M4 BY VIA4
M5_DIO = NET AREA SD >0
CONNECT M1 M5_DIO BY CT1
AR_5_10_M5 {
    @ Max. (M5 area / gate area) is 5000 (without effective diode)
    @ Max. (M5 area / gate area) is Ratio Equation (with effective diode)
    A5 = NET AREA RATIO PO M1 M2 M3 M4 M5 M5_DIO GATE > 5000 ACCUMULATE AC4 [ AREA(M5)/AREA(GATE) - (AREA(M5_DIO)*500 + !!AREA(M5_DIO)*38000)]
    RDB AR_5_10_M5.rep PO M1 M2 M3 M4 M5 M5_DIO GATE
    COPY A5
    NET AREA RATIO PRINT A5 M5.rpt
}
AR18_5_10_M5 {
    @ Max. (M5 area / 1.8v gate area) is 1000 (without effective diode)
    @ Max. (M5 area / 1.8v gate area) is Ratio Equation (with effective diode)
    A5_18 = NET AREA RATIO PO M1 M2 M3 M4 M5 M5_DIO GATE18 > 1000 ACCUMULATE AC4_18 [ AREA(M5)/AREA(GATE18) -(AREA(M5_DIO)*500 + !!AREA(M5_DIO)*42000) ]
    RDB AR18_5_10_M5.rep PO M1 M2 M3 M4 M5 M5_DIO GATE18
    COPY A5_18
    NET AREA RATIO PRINT A5_18 M5_18.rpt
}
CONNECT T4V2 M5
AR_4_T4V2 {
    @ (T4V2 area / gate area) > 20 (without effective diode)
    @ (T4V2 area / gate area) > Ratio Equation (with effective diode)
    @ single layer Via area to the active poly gate area, no accumulate
    AV5_no_accumulate = NET AREA RATIO PO M1 M2 M3 M4 M5 T4V2 M5_DIO GATE > 20 [ AREA(T4V2)/AREA(GATE)-(AREA(M5_DIO)*150 + !!AREA(M5_DIO)*980) ]
    RDB AR_4_T4V2.rep PO M1 M2 M3 M4 M5 T4V2 M5_DIO GATE
    COPY AV5_no_accumulate
}
AR_6_9_T4V2 {
    @ (T4V2 area / gate area) > 50 (without effective diode)
    @ (T4V2 area / gate area) > Ratio Equation (with effective diode)
    AVIA5 = NET AREA RATIO PO M1 M2 M3 M4 M5 T4V2 M5_DIO GATE > 50 ACCUMULATE AC4_V [ AREA(T4V2)/AREA(GATE) -(AREA(M5_DIO)*250 + !!AREA(M5_DIO)*850)]
    RDB AR_6_9_T4V2.rep PO M1 M2 M3 M4 M5 T4V2 M5_DIO GATE
    COPY AVIA5
}
AC5 = NET AREA RATIO M5 GATE >=0 ACCUMULATE AC4
AC5_18 = NET AREA RATIO M5 GATE18 >=0 ACCUMULATE AC4_18
CONNECT T4M2 M5 BY T4V2
T4M2_DIO = NET AREA SD >0
CONNECT M1 T4M2_DIO BY CT1
AR_5_10_T4M2 {
    @ Max. (T4M2 area / gate area) is 5000 (without effective diode)
    @ Max. (T4M2 area / gate area) is Ratio Equation (with effective diode)
    A6 = NET AREA RATIO PO M1 M2 M3 M4 M5 T4M2 T4M2_DIO GATE > 5000 ACCUMULATE AC5 [ AREA(T4M2)/AREA(GATE) - (AREA(T4M2_DIO)*8000 + !!AREA(T4M2_DIO)*45000)]
    RDB AR_5_10_T4M2.rep PO M1 M2 M3 M4 M5 T4M2 T4M2_DIO GATE
    COPY A6
}
AR18_5_10_T4M2 {
    @ Max. (T4M2 area / 1.8v gate area) is 1000 (without effective diode)
    @ Max. (T4M2 area / 1.8v gate area) is Ratio Equation (with effective diode)
    A6_18 = NET AREA RATIO PO M1 M2 M3 M4 M5 T4M2 T4M2_DIO GATE18 > 1000 ACCUMULATE AC5_18 [ AREA(T4M2)/AREA(GATE18) - (AREA(T4M2_DIO)*8000 + !!AREA(T4M2_DIO)*49000)]
    RDB AR18_5_10_T4M2.rep PO M1 M2 M3 M4 M5 T4M2 T4M2_DIO GATE18
    COPY A6_18
}
CONNECT RDV T4M2
AR_7_11_io {
    @ Max. (RDV area / IO gate area) is 20 (without effective diode)
    @ Max. (RDV area / IO gate area) is Ratio Equation (with effective diode)
    NET AREA RATIO PO M1 M2 M3 M4 M5 T4M2 RDV T4M2_DIO GATE1825 > 20
    [ AREA(RDV)/AREA(GATE1825) - (AREA(T4M2_DIO)*90 + !!AREA(T4M2_DIO)*380)]
    RDB AR_7_11_io.rep PO M1 M2 M3 M4 M5 T4M2 RDV T4M2_DIO GATE1825
}
AR_7_11_core {
    @ Max. (RDV area / gate area) is 200 (without effective diode)
    @ Max. (RDV area / gate area) is Ratio Equation (with effective diode)
    NET AREA RATIO PO M1 M2 M3 M4 M5 T4M2 RDV T4M2_DIO GATE > 200
    [ AREA(RDV)/AREA(GATE) - (AREA(T4M2_DIO)*90 + !!AREA(T4M2_DIO)*200)]
    RDB AR_7_11_core.rep PO M1 M2 M3 M4 M5 T4M2 RDV T4M2_DIO GATE
}
CONNECT RDL T4M2 BY RDV
RDL_DIO = NET AREA SD >0
AR_8_12 {
    @ Max. (RDL side-wall area / gate area) is 1000 (without effective diode)
    @ Max. (RDL side-wall area / gate area) is Ratio Equation (with effective diode)
    NET AREA RATIO PO M1 M2 M3 M4 M5 T4M2 RDL RDL_DIO GATE > 1000
    [ PERIMETER(RDL)*1.595/AREA(GATE) - (AREA(RDL_DIO)*8000 + !!AREA(RDL_DIO)*29000)]
    RDB AR_8_12_.rep PO M1 M2 M3 M4 M5 T4M2 RDL RDL_DIO GATE
}
